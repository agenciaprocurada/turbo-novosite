---
import { links, seloReclameAqui as copy } from '../data/site'
---

<a class="ra-badge" href={links.reclameAqui} target="_blank" rel="noopener noreferrer" aria-label={copy.acessibilidade}>
  <svg class="ra-shield" width="31" height="34" viewBox="0 0 32 36" fill="none" aria-hidden="true">
    <path d="m16 2 13 7v8c0 8-7.5 13-13 16C10.5 30 3 25 3 17V9L16 2Z" fill="#2341B6" />
    <path d="m10 17 4 4 8-9" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span><span class="ra-label">{copy.texto}</span><strong class="ra-wordmark">{copy.marca}</strong></span>
</a>

<style>
  .ra-badge { display: inline-flex; align-items: center; gap: 9px; min-height: 66px; padding: 11px 14px; border-radius: 14px; background: linear-gradient(110deg, #d9fce8, #f2f3de); text-align: left; text-decoration: none; transition: box-shadow .2s, transform .2s; }
  .ra-badge:hover { transform: translateY(-2px); box-shadow: 0 5px 18px #2341b615; }
  .ra-badge:focus-visible { outline: 2px solid #2341b6; outline-offset: 4px; }
  .ra-shield { flex-shrink: 0; width: 31px; height: 34px; }
  .ra-label { display: block; color: #253349; font-size: 14px; line-height: 1.3; }
  .ra-wordmark { display: block; color: #46566e; font-size: 21px; line-height: 1.15; font-style: italic; font-weight: 1000; letter-spacing: -.055em; }
</style>
