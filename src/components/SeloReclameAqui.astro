---
/**
 * Selo "Verificada por ReclameAQUI" do rodapé, no desenho do selo oficial:
 * cartão branco com sombra leve, escudo azul com check e o wordmark em duas
 * cores — "Reclame" verde e "AQUI" verde-escuro, itálico e pesado.
 * As cores são da marca Reclame AQUI, não da paleta do site, de propósito.
 */
import { links, seloReclameAqui as copy } from '../data/site'
---

<a class="ra-badge" href={links.reclameAqui} target="_blank" rel="noopener noreferrer" aria-label={copy.acessibilidade}>
  <svg class="ra-shield" viewBox="0 0 32 36" fill="none" aria-hidden="true">
    <path d="m16 2 13 7v8c0 8-7.5 13-13 16C10.5 30 3 25 3 17V9L16 2Z" fill="#2341B6" />
    <path d="m10 17 4 4 8-9" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span>
    <span class="ra-label">{copy.texto}</span>
    <strong class="ra-wordmark"><span class="ra-reclame">{copy.marca1}</span><span class="ra-aqui">{copy.marca2}</span></strong>
  </span>
</a>

<style>
  .ra-badge { display: inline-flex; align-items: center; gap: 12px; padding: 14px 20px 14px 16px; border-radius: 18px; background: #fff; border: 1px solid #e8e8ec; box-shadow: 0 2px 6px rgb(0 0 0 / .06), 0 10px 24px rgb(0 0 0 / .06); text-align: left; text-decoration: none; transition: box-shadow .2s, transform .2s; }
  .ra-badge:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgb(0 0 0 / .08), 0 16px 32px rgb(0 0 0 / .1); }
  .ra-badge:focus-visible { outline: 2px solid #2341b6; outline-offset: 4px; }
  .ra-shield { flex-shrink: 0; width: 36px; height: 40px; }
  .ra-label { display: block; color: #3d4652; font-size: 15px; line-height: 1.25; }
  .ra-wordmark { display: block; margin-top: 1px; font-size: 22px; line-height: 1.1; font-style: italic; font-weight: 900; letter-spacing: -.045em; }
  .ra-reclame { color: #46b34a; }
  .ra-aqui { color: #1a7a3e; }
</style>
