---
/**
 * Avatar do depoimento. Com `foto`, mostra a imagem (WebP 104px = 2× do maior
 * uso na tela, que é 52px); sem `foto`, cai no monograma com as iniciais.
 */
import type { ImageMetadata } from 'astro'

interface Props {
  nome: string
  foto?: ImageMetadata
  size?: number
  tone?: 'light' | 'dark'
  class?: string
}

const { nome, foto, size = 44, tone = 'light', class: className = '' } = Astro.props

const iniciais = nome
  .split(' ')
  .filter((p) => p.length > 2)
  .slice(0, 2)
  .map((p) => p[0])
  .join('')
  .toUpperCase()

// Matiz derivado do nome — cada pessoa ganha um monograma estável e distinto
const hash = [...nome].reduce((acc, ch) => acc + ch.charCodeAt(0), 0)
const rot = hash % 90
---

{
  foto ? (
    <img
      src={foto.src}
      width={size}
      height={size}
      alt=""
      loading="lazy"
      decoding="async"
      class:list={['shrink-0 rounded-full object-cover', className]}
      style={`width:${size}px;height:${size}px`}
    />
  ) : (
    <span
      class:list={[
        'inline-grid shrink-0 place-items-center rounded-full font-medium',
        tone === 'dark' ? 'text-purple-950' : 'text-purple-950',
        className,
      ]}
      style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.36)}px;background:linear-gradient(${135 + rot}deg,var(--color-green-soft),var(--color-green));`}
      aria-hidden="true"
    >
      {iniciais}
    </span>
  )
}
