---
/**
 * Bloco de número (S9): ícone em círculo lavanda à esquerda, número grande e
 * rótulo curto à direita. Sem ícone, vira só número + rótulo (uso genérico).
 */
interface Props {
  valor: string
  label: string
  icone?: 'uptime' | 'latencia' | 'backup' | 'estrela'
  /** sufixo discreto depois do número (ex.: ★) */
  sufixo?: string
  tone?: 'light' | 'dark'
  class?: string
}

const { valor, label, icone, sufixo, tone = 'light', class: className = '' } = Astro.props
---

<div class:list={['flex items-center gap-3 sm:gap-4', className]}>
  {
    icone && (
      <span
        class:list={[
          'grid size-11 shrink-0 place-items-center rounded-full sm:size-14',
          tone === 'dark' ? 'bg-white/10 text-green' : 'bg-purple-950/6 text-purple-800',
        ]}
        aria-hidden="true"
      >
        {icone === 'uptime' && (
          <svg viewBox="0 0 24 24" class="size-5 sm:size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v5.2c0 4.4 3.1 8.2 7.5 9.8 4.4-1.6 7.5-5.4 7.5-9.8V6L12 3Z" />
            <path d="m9 12 2 2 4-4.5" />
          </svg>
        )}
        {icone === 'latencia' && (
          <svg viewBox="0 0 24 24" class="size-5 sm:size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 3 5 13.5h6L10 21l9-11.5h-6L13 3Z" />
          </svg>
        )}
        {icone === 'backup' && (
          <svg viewBox="0 0 24 24" class="size-5 sm:size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3.5" y="5" width="17" height="15" rx="3" />
            <path d="M3.5 10h17M8 3.5V7M16 3.5V7" />
            <path d="m9.5 15 1.8 1.8 3.4-3.6" />
          </svg>
        )}
        {icone === 'estrela' && (
          <svg viewBox="0 0 24 24" class="size-5 sm:size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L12 16.9l-5.3 2.8 1.1-5.9-4.3-4.1 5.9-.8L12 3.5Z" />
          </svg>
        )}
      </span>
    )
  }

  <div class="flex min-w-0 flex-col gap-0.5">
    <span
      class:list={[
        'text-[clamp(1.45rem,3vw,2.1rem)] leading-none font-bold tracking-[-0.02em] whitespace-nowrap',
        tone === 'dark' ? 'text-green' : 'text-ink',
      ]}
      ><span data-count>{valor}</span>{sufixo && <span class="ml-1.5 text-[0.7em] text-purple-800/35">{sufixo}</span>}</span
    >
    <span
      class:list={['text-[13.5px] leading-snug', tone === 'dark' ? 'text-white/60' : 'text-ink-soft']}
      >{label}</span
    >
  </div>
</div>
