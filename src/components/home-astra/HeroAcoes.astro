---
/**
 * Bloco de ação do hero Astra: CTA principal, o "a partir de" e os dois
 * benefícios com check verde. Centrado abaixo de 1024px, à esquerda acima.
 */
import Button from '../Button.astro'
import { homeAstra as copy } from '../../data/home-astra'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
const brl = (valor: number) => valor.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
---

<div class:list={['hero-acoes', className]}>
  <div class="hero-actions">
    <Button href="#planos" size="lg">{copy.hero.principal} <span aria-hidden="true">→</span></Button>
  </div>
  <p class="hero-price">A partir de <strong>R$ {brl(copy.hero.preco)}/mês</strong> <span>· cobrança mensal</span></p>
  <ul class="hero-benefits">
    {copy.hero.beneficios.map((item) => <li><span aria-hidden="true">✓</span> {item}</li>)}
  </ul>
</div>

<style>
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero-actions :global(a) { min-height: 58px; padding-inline: 32px; font-size: 15px; }
  .hero-price { margin-top: 22px; font-size: 14px; color: var(--color-ink-soft); }
  .hero-price strong { color: var(--color-ink); }
  .hero-benefits { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 14px; font-size: 13px; }
  .hero-benefits li span { display: inline-grid; place-items: center; width: 18px; height: 18px; margin-right: 4px; border-radius: 50%; background: var(--color-green); color: var(--color-purple-logo); font-weight: 700; }
  @media (max-width: 1023px) {
    .hero-actions, .hero-benefits { justify-content: center; }
  }
  @media (max-width: 639px) {
    .hero-actions { flex-direction: column; gap: 10px; margin-top: 22px; }
    .hero-actions :global(a) { width: 100%; }
    .hero-price { font-size: 13px; margin-top: 18px; }
    .hero-price > span { display: block; margin-top: 3px; font-size: 12px; }
    .hero-benefits { margin-top: 12px; font-size: 13px; }
  }
</style>
