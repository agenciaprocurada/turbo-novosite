---
/**
 * Visual do hero da proposta Astra: astronauta com órbitas, cartão do TTFB
 * e selo do datacenter. Compartilhado entre a home e /home-astra.
 * Só entra número real de `provas`.
 */
import { Image } from 'astro:assets'
import { provas } from '../../data/site'
import astronauta from '../../assets/imagens/empresa-de-hospedagem-de-site-astronauta-notebook-nuvem.webp'

interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---

<div class:list={['hero-visual', className]} aria-label="Servidores no Brasil, com a performance Turbo Cloud">
  <div class="orbit orbit-one" aria-hidden="true"></div>
  <div class="orbit orbit-two" aria-hidden="true"></div>
  <span class="orbit-dot" aria-hidden="true"></span>
  <span class="visual-caption" aria-hidden="true">SEU PRÓXIMO DESTINO: TURBO CLOUD</span>
  <Image src={astronauta} width={325} quality={85} alt="" loading="eager" fetchpriority="high" class="astra-astronaut" aria-hidden="true" />
  <div class="hero-metric">
    <span class="metric-icon" aria-hidden="true">↗</span>
    <div><p>Tempo até o primeiro byte</p><strong>{provas.ttfb}</strong><span>nos servidores do Brasil</span></div>
  </div>
  <div class="hero-datacenter">
    <span class="location-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 21s7-6 7-12a7 7 0 0 0-14 0c0 6 7 12 7 12Z" /><circle cx="12" cy="9" r="2.5" /></svg></span>
    <span><strong>Brasil. Perto de você.</strong><small>Datacenter TIER III · São Paulo</small></span>
  </div>
</div>

<style>
  .hero-visual { position: relative; min-width: 0; height: 480px; --on-purple: var(--astra-on-purple, #f5effa); }
  .orbit { position: absolute; width: 440px; height: 440px; left: 50%; top: 20px; translate: -50% 0; border-radius: 50%; border: 1px solid #5c1f8526; background: radial-gradient(circle, #5c1f8514, #5c1f8500 68%); }
  .orbit-two { width: 360px; height: 360px; top: 60px; border-style: dashed; background: none; rotate: -18deg; }
  .orbit-dot { position: absolute; left: 5%; top: 105px; width: 12px; height: 12px; border-radius: 50%; background: var(--color-green); box-shadow: 0 0 0 7px #6bdd1214; }
  .visual-caption { position: absolute; top: -2px; right: 20px; font-family: var(--font-mono); font-size: 10px; letter-spacing: .1em; color: var(--color-purple-logo); }
  .hero-visual :global(.astra-astronaut) { position: absolute; width: 325px; height: auto; top: 10px; left: 36px; z-index: 1; animation: turbo-float 9s ease-in-out infinite; }
  .hero-metric { position: absolute; z-index: 2; top: 110px; right: 0; display: flex; gap: 12px; align-items: flex-start; background: #fffffff0; border: 1px solid var(--color-line); padding: 18px; border-radius: var(--radius-card); box-shadow: var(--shadow-lift); }
  .metric-icon { display: grid; place-items: center; width: 32px; height: 32px; background: var(--color-green); border-radius: 10px; color: var(--color-purple-logo); font-size: 21px; }
  .hero-metric p { font-size: 12px; color: var(--color-ink-soft); }
  .hero-metric strong { display: block; font-size: 38px; font-weight: 700; letter-spacing: -.025em; line-height: 1.2; margin-block: 5px; }
  .hero-metric div > span { font-size: 12px; color: var(--color-ink-soft); }
  .hero-datacenter { position: absolute; z-index: 2; right: 8px; bottom: 20px; display: flex; align-items: center; gap: 14px; background: var(--color-purple-logo); color: white; padding: 18px 22px; border-radius: var(--radius-card); box-shadow: var(--shadow-lift); }
  .location-icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: #ffffff12; color: var(--color-green); }
  .location-icon svg { width: 24px; }
  .hero-datacenter strong { display: block; font-size: 15px; }
  .hero-datacenter small { display: block; font-size: 12px; color: var(--on-purple); margin-top: 3px; }
  @media (max-width: 1100px) and (min-width: 1024px) {
    .hero-visual :global(.astra-astronaut) { left: -12px; width: 300px; }
    .hero-metric { right: -5px; padding: 14px; gap: 8px; }
    .hero-metric .metric-icon { display: none; }
  }
  @media (max-width: 1023px) {
    .hero-visual { max-width: 510px; width: 100%; margin-inline: auto; height: 440px; }
    .hero-visual :global(.astra-astronaut) { width: 300px; left: 30px; }
    .hero-datacenter { bottom: 4px; }
  }
  @media (max-width: 639px) {
    .hero-visual { height: 290px; max-width: 380px; }
    .hero-visual :global(.astra-astronaut) { width: 205px; left: 5px; top: 0; }
    .orbit { width: 270px; height: 270px; top: 0; }
    .orbit-two { width: 210px; height: 210px; top: 30px; }
    .orbit-dot { width: 8px; height: 8px; top: 50px; left: 30px; }
    .visual-caption { display: none; }
    .hero-metric { top: 45px; right: 0; padding: 13px 14px; }
    .hero-metric .metric-icon { display: none; }
    .hero-metric p { max-width: 18ch; font-size: 11px; }
    .hero-metric strong { font-size: 30px; }
    .hero-metric div > span { font-size: 11px; }
    .hero-datacenter { padding: 13px 16px; right: 0; bottom: 6px; gap: 10px; }
    .hero-datacenter strong { font-size: 13px; }
    .hero-datacenter small { font-size: 11px; }
    .hero-datacenter .location-icon { width: 30px; height: 30px; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-visual :global(.astra-astronaut) { animation: none; } }
</style>
