---
/**
 * Card de benefício das páginas de produto: ícone de traço num quadrado
 * lavanda, título e um parágrafo. Os ícones são SVG inline (nenhum request,
 * nenhuma fonte de ícone) e herdam a cor do container.
 *
 * `tone="dark"` é a versão para dentro dos blocos roxos.
 */
import type { IconeBeneficio } from '../data/produtos'

interface Props {
  icone: IconeBeneficio
  titulo: string
  texto: string
  tone?: 'light' | 'dark'
  class?: string
}

const { icone, titulo, texto, tone = 'light', class: className = '' } = Astro.props

const CAMINHOS: Record<IconeBeneficio, string> = {
  velocidade: 'M12 20a8 8 0 1 1 8-8M12 12l4.5-4.5M12 12h.01',
  latencia: 'M3 12h4l2.5-6 4 12 2.5-6h5',
  carregamento: 'M12 3v10m0 0-3.5-3.5M12 13l3.5-3.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2',
  wordpress: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-8 9 4 10m4-14-4 14m8-14 4 10',
  suporte: 'M4 14v-2a8 8 0 0 1 16 0v2M4 14a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2v-2Zm16 0a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2v-2Zm-3 5a3 3 0 0 1-3 2',
  escudo: 'M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3Zm-3 9 2 2 4-4',
  nvme: 'M4 6h16v5H4zM4 13h16v5H4zM7 8.5h.01M7 15.5h.01M11 8.5h5M11 15.5h5',
  escalar: 'M4 20V10m5 10V4m5 16v-7m5 7V7',
  backup: 'M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4M12 8v4l3 2',
  ferramentas: 'M14.7 6.3a4 4 0 0 0 5 5L15 16l-3.5-3.5L16 8a4 4 0 0 0-1.3-1.7ZM10 14l-5 5a1.5 1.5 0 0 0 2 2l5-5',
  isolamento: 'M4 5h7v7H4zM13 12h7v7h-7zM11 9h2M12 12v0',
  cpu: 'M8 8h8v8H8zM5 10V8a3 3 0 0 1 3-3h2M19 14v2a3 3 0 0 1-3 3h-2M10 2v3M14 2v3M10 19v3M14 19v3M2 10h3M2 14h3M19 10h3M19 14h3',
  custom: 'M4 6h10M18 6h2M4 12h2M10 12h10M4 18h8M16 18h4M14 4v4M8 10v4M14 16v4',
  monitor: 'M3 12h3l2-5 3 10 2.5-7 1.5 4h6M4 19h16',
  entrega: 'M3 7l9 6 9-6M3 7h18v10H3zM8 21l3-3 3 3',
  caixa: 'M4 8h16v11H4zM4 8l2-4h12l2 4M12 8v11M9 12h6',
  plugue: 'M9 3v5M15 3v5M7 8h10v3a5 5 0 0 1-10 0zM12 16v5',
  seo: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14ZM16 16l5 5M8 11h1.5M11 11h4',
  carrinho: 'M3 4h2l2.2 10.4a2 2 0 0 0 2 1.6h7.4a2 2 0 0 0 2-1.6L20 8H6M9 20h.01M17 20h.01',
}

const escuro = tone === 'dark'
---

<article
  class:list={[
    'flex h-full flex-col gap-3.5 rounded-card border p-5 transition-[transform,box-shadow] duration-300 sm:p-6',
    escuro
      ? 'border-white/12 bg-white/5 hover:-translate-y-1'
      : 'border-line bg-surface shadow-soft hover:-translate-y-1 hover:shadow-lift',
    className,
  ]}
>
  <span
    class:list={[
      'grid size-11 shrink-0 place-items-center rounded-[13px]',
      escuro ? 'bg-green/12 text-green' : 'bg-purple-logo/8 text-purple-800',
    ]}
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 24 24"
      class="size-[22px]"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={CAMINHOS[icone]} />
    </svg>
  </span>

  <div>
    <h3 class:list={['text-[16.5px] leading-snug font-bold', escuro ? 'text-white' : 'text-ink']}>
      {titulo}
    </h3>
    <p
      class:list={[
        'mt-1.5 text-[14px] leading-relaxed',
        escuro ? 'text-white/70' : 'text-ink-soft',
      ]}
    >
      {texto}
    </p>
  </div>
</article>
