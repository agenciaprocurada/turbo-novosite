---
import MockupFrame from '../MockupFrame.astro'

const apps = ['n8n', 'Typebot', 'Chatwoot', 'Mautic', 'WordPress', 'Redis', 'MariaDB', '+100']
---

<MockupFrame titulo="container · recursos alocados" bodyClass="p-4">
  <div class="grid grid-cols-2 gap-2">
    <div class="rounded-[12px] border border-line bg-bg px-3 py-2.5">
      <span class="font-mono text-[10px] tracking-[0.1em] text-ink-soft uppercase">vCPU</span>
      <p class="mt-0.5 font-mono text-[19px] leading-none text-ink">8<span class="text-ink-soft text-[13px]">/8</span></p>
    </div>
    <div class="rounded-[12px] border border-line bg-bg px-3 py-2.5">
      <span class="font-mono text-[10px] tracking-[0.1em] text-ink-soft uppercase">RAM DDR4</span>
      <p class="mt-0.5 font-mono text-[19px] leading-none text-ink">12<span class="text-ink-soft text-[13px]">GB</span></p>
    </div>
  </div>

  <div class="mt-2.5 rounded-[12px] border border-line bg-bg px-3 py-2.5">
    <div class="flex items-baseline justify-between">
      <span class="font-mono text-[10px] tracking-[0.1em] text-ink-soft uppercase"
        >Reservado só pra você</span
      >
      <span class="font-mono text-[11px] text-green-deep">100%</span>
    </div>
    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line" aria-hidden="true">
      <span class="block h-full w-full rounded-full bg-linear-to-r from-green-soft to-green"></span>
    </div>
  </div>

  <p class="mt-3.5 font-mono text-[10.5px] tracking-[0.1em] text-ink-soft uppercase">
    Instalar em 1 clique
  </p>
  <div class="mt-2 flex flex-wrap gap-1.5">
    {
      apps.map((app) => (
        <span class="rounded-full border border-line bg-surface px-2.5 py-1 font-mono text-[11px] text-ink-soft">
          {app}
        </span>
      ))
    }
  </div>
</MockupFrame>
