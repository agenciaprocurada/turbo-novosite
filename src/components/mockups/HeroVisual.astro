---
/**
 * Composição visual do hero: astronauta + três cartões flutuantes
 * (painel de performance, gráfico de carregamento e barra de números).
 * Tudo HTML/CSS/SVG. Só entra número real de `provas`.
 */
import Astronaut from './Astronaut.astro'
import { hero, provas } from '../../data/site'

// Anel de uptime: 99,982% é, na prática, o círculo inteiro.
const R = 34
const CIRC = 2 * Math.PI * R
---

<div
  aria-hidden="true"
  class="relative flex flex-col gap-4 select-none lg:block lg:h-[560px]"
>
  <!-- astronauta -->
  <div class="hero-float z-10 mx-auto w-[200px] sm:w-[240px] lg:absolute lg:bottom-0 lg:left-0 lg:w-[290px]">
    <Astronaut class="w-full" />
  </div>

  <!-- painel de performance -->
  <div
    class="hero-card hero-float w-full lg:absolute lg:top-0 lg:right-0 lg:w-[312px]"
    data-float="2"
  >
    <p class="text-[13.5px] font-bold text-ink">Painel de performance</p>
    <div class="mt-3 flex items-center gap-4">
      <div class="relative shrink-0">
        <svg viewBox="0 0 88 88" class="size-[88px] -rotate-90">
          <circle cx="44" cy="44" r={R} fill="none" stroke="#ECE8F1" stroke-width="9"></circle>
          <circle
            class="hero-ring"
            cx="44"
            cy="44"
            r={R}
            fill="none"
            stroke="#6BDD12"
            stroke-width="9"
            stroke-linecap="round"
            stroke-dasharray={CIRC}
            stroke-dashoffset={CIRC}></circle>
        </svg>
        <div class="absolute inset-0 grid place-items-center text-center">
          <div>
            <span class="block font-mono text-[12px] leading-none font-bold text-ink tabular-nums"
              >{provas.uptimeTier3}</span
            >
            <span class="mt-1 block font-mono text-[8.5px] tracking-[0.12em] text-ink-soft uppercase"
              >uptime</span
            >
          </div>
        </div>
      </div>

      <dl class="min-w-0 flex-1 divide-y divide-line">
        <div class="flex items-center justify-between gap-3 py-1.5">
          <dt class="text-[12px] text-ink-soft">Tempo de resposta</dt>
          <dd class="font-mono text-[12px] font-bold text-ink tabular-nums">{provas.ttfb}</dd>
        </div>
        <div class="flex items-center justify-between gap-3 py-1.5">
          <dt class="text-[12px] text-ink-soft">Backup</dt>
          <dd class="font-mono text-[12px] font-bold text-ink tabular-nums">{provas.backup}</dd>
        </div>
        <div class="flex items-center justify-between gap-3 py-1.5">
          <dt class="text-[12px] text-ink-soft">Datacenter</dt>
          <dd class="font-mono text-[12px] font-bold text-ink">TIER III</dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- gráfico de carregamento -->
  <div
    class="hero-card hero-float w-full lg:absolute lg:top-[212px] lg:right-0 lg:w-[330px]"
    data-float="3"
  >
    <div class="flex items-baseline justify-between gap-3">
      <span class="font-mono text-[10.5px] tracking-[0.12em] whitespace-nowrap text-ink-soft uppercase"
        >Carregamento · 30 dias</span
      >
      <span class="font-mono text-[11px] text-green-deep">↗ decolagem</span>
    </div>
    <svg viewBox="0 0 300 80" class="mt-3 w-full" preserveAspectRatio="none">
      <defs>
        <linearGradient id="heroArea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#6BDD12" stop-opacity=".28"></stop>
          <stop offset="1" stop-color="#6BDD12" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <g stroke="#ECE8F1" stroke-width="1" stroke-dasharray="3 4">
        <path d="M0 20H300"></path>
        <path d="M0 44H300"></path>
        <path d="M0 68H300"></path>
      </g>
      <path
        d="M0 66 L34 60 L68 62 L102 52 L136 48 L170 38 L204 32 L238 22 L272 16 L300 8 L300 80 L0 80 Z"
        fill="url(#heroArea)"></path>
      <path
        class="hero-spark"
        d="M0 66 L34 60 L68 62 L102 52 L136 48 L170 38 L204 32 L238 22 L272 16 L300 8"
        fill="none"
        stroke="#3E8A00"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <g fill="#FFFFFF" stroke="#3E8A00" stroke-width="2">
        <circle cx="102" cy="52" r="3"></circle>
        <circle cx="170" cy="38" r="3"></circle>
        <circle cx="238" cy="22" r="3"></circle>
        <circle cx="300" cy="8" r="3.5" fill="#6BDD12"></circle>
      </g>
    </svg>
  </div>

  <!-- barra de números -->
  <div
    class="hero-card hero-float z-20 w-full !p-0 lg:absolute lg:right-0 lg:bottom-0 lg:w-[368px]"
    data-float="1"
  >
    <ul class="grid grid-cols-4 divide-x divide-line">
      {
        hero.numeros.map((n) => (
          <li class="px-2 py-3 text-center">
            <span class="block font-mono text-[13px] leading-none font-bold text-ink tabular-nums">
              {n.valor}
            </span>
            <span class="mt-1.5 block font-mono text-[9px] tracking-[0.12em] text-ink-soft uppercase">
              {n.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .hero-card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 0.82);
    padding: 16px 18px;
    box-shadow: var(--shadow-lift);
    backdrop-filter: blur(10px);
  }

  /* Anel de uptime e linha do gráfico desenham quando o hero entra em cena */
  .hero-ring {
    transition: stroke-dashoffset 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
  }

  .hero-spark {
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
  }

  :global(.reveal.is-in) .hero-ring {
    stroke-dashoffset: 0;
  }

  :global(.reveal.is-in) .hero-spark {
    animation: hero-spark-draw 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  @keyframes hero-spark-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Flutuação suave — só no desktop, onde os cartões são absolutos */
  @media (min-width: 64rem) {
    .hero-float {
      animation: turbo-float 7s ease-in-out infinite;
    }
    .hero-float[data-float='1'] {
      animation-delay: -1.5s;
    }
    .hero-float[data-float='2'] {
      animation-delay: -3s;
      animation-duration: 8s;
    }
    .hero-float[data-float='3'] {
      animation-delay: -5s;
      animation-duration: 9s;
    }
  }
</style>
