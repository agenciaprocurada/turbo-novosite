---
/**
 * Os três painéis que antes vinham gravados na arte do hero, agora refeitos em
 * HTML/CSS/SVG e animados: anel de uptime que desenha, números que contam,
 * gráfico que traça a linha e cartões que flutuam.
 *
 * Ficam na mesma posição da arte original — performance em cima, gráfico no
 * meio e barra de números embaixo.
 *
 * Os números saem de `provas`/`hero`, então são os reais do projeto: nada de
 * "CPU 12%" ou "24/7" que a arte trazia e o site não sustenta.
 */
import { hero, provas } from '../../data/site'

// Anel de uptime: 99,982% é, na prática, a volta inteira.
const R = 30
const CIRC = +(2 * Math.PI * R).toFixed(1)
const FALTA = +(CIRC * 0.06).toFixed(1) // recuo visível só para o anel não fechar
---

{/* Medidas tiradas da arte de referência: os painéis descem em diagonal — o de
    performance no topo, o gráfico deslocado à direita e a barra mais larga
    embaixo, sobrepondo o gráfico. O bloco todo tem 402×392. */}
<div
  aria-hidden="true"
  class="relative flex flex-col gap-3 select-none lg:ml-auto lg:block lg:h-[392px] lg:w-[402px]"
>
  {/* 1 · Painel de performance */}
  <div
    class="painel painel-flutua w-full lg:absolute lg:top-0 lg:left-[29px] lg:w-[302px]"
    data-flutua="1"
  >
    <p class="text-[14px] font-bold text-ink">Painel de Performance</p>

    <div class="mt-3 flex items-center gap-4 border-t border-line pt-3">
      <div class="relative shrink-0">
        <svg viewBox="0 0 80 80" class="size-[80px] -rotate-90">
          <circle cx="40" cy="40" r={R} fill="none" stroke="#ECE8F1" stroke-width="8"></circle>
          <circle
            class="anel"
            cx="40"
            cy="40"
            r={R}
            fill="none"
            stroke="#6BDD12"
            stroke-width="8"
            stroke-linecap="round"
            stroke-dasharray={CIRC}
            stroke-dashoffset={CIRC}
            style={`--anel-final:${FALTA}`}></circle>
        </svg>
        <div class="absolute inset-0 grid place-items-center text-center">
          <div>
            <span class="block font-mono text-[12.5px] leading-none font-bold text-ink tabular-nums">
              {provas.uptimeTier3}
            </span>
            <span class="mt-1 block font-mono text-[8px] tracking-[0.12em] text-ink-soft uppercase">
              uptime
            </span>
          </div>
        </div>
      </div>

      <dl class="min-w-0 flex-1 divide-y divide-line">
        <div class="flex items-center justify-between gap-3 py-1.5">
          <dt class="text-[12.5px] text-ink-soft">Tempo de resposta</dt>
          <dd class="font-mono text-[12.5px] font-bold text-ink tabular-nums">{provas.ttfb}</dd>
        </div>
        <div class="flex items-center justify-between gap-3 py-1.5">
          <dt class="text-[12.5px] text-ink-soft">Backup</dt>
          <dd class="font-mono text-[12.5px] font-bold text-ink tabular-nums">{provas.backup}</dd>
        </div>
        <div class="flex items-center justify-between gap-3 py-1.5">
          <dt class="text-[12.5px] text-ink-soft">Datacenter</dt>
          <dd class="font-mono text-[12.5px] font-bold text-ink">TIER III</dd>
        </div>
      </dl>
    </div>
  </div>

  {/* 2 · Gráfico de carregamento */}
  <div
    class="painel painel-flutua w-full lg:absolute lg:top-[170px] lg:left-[90px] lg:w-[312px]"
    data-flutua="2"
  >
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-[13px] font-bold text-ink">Carregamento</span>
      <span class="font-mono text-[10.5px] tracking-[0.1em] text-ink-soft uppercase">
        últimos 30 dias
      </span>
    </div>

    <svg viewBox="0 0 300 92" class="mt-3 w-full" preserveAspectRatio="none">
      <defs>
        <linearGradient id="areaHero" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#6BDD12" stop-opacity=".26"></stop>
          <stop offset="1" stop-color="#6BDD12" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <g stroke="#ECE8F1" stroke-width="1" stroke-dasharray="3 5">
        <path d="M0 24H300"></path>
        <path d="M0 52H300"></path>
        <path d="M0 80H300"></path>
      </g>
      <path
        class="area"
        d="M0 76 L34 70 L68 72 L102 60 L136 56 L170 44 L204 37 L238 25 L272 18 L300 9 L300 92 L0 92 Z"
        fill="url(#areaHero)"></path>
      <path
        class="linha"
        d="M0 76 L34 70 L68 72 L102 60 L136 56 L170 44 L204 37 L238 25 L272 18 L300 9"
        fill="none"
        stroke="#3E8A00"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <g class="pontos" fill="#FFFFFF" stroke="#3E8A00" stroke-width="2">
        <circle cx="102" cy="60" r="3" style="--p:1"></circle>
        <circle cx="170" cy="44" r="3" style="--p:2"></circle>
        <circle cx="238" cy="25" r="3" style="--p:3"></circle>
        <circle cx="297" cy="9" r="3.6" fill="#6BDD12" style="--p:4"></circle>
      </g>
    </svg>
  </div>

  {/* 3 · Barra de números */}
  <div
    class="painel painel-flutua z-10 w-full !p-0 lg:absolute lg:top-[305px] lg:left-0 lg:w-[388px]"
    data-flutua="3"
  >
    <ul class="grid grid-cols-4 divide-x divide-line">
      {
        hero.numeros.map((n) => (
          <li class="px-2 py-3 text-center">
            <span class="block font-mono text-[13px] leading-none font-bold text-ink tabular-nums">
              {n.valor}
            </span>
            <span class="mt-1.5 block font-mono text-[8.5px] tracking-[0.12em] text-ink-soft uppercase">
              {n.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .painel {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    /* Translúcido de propósito: a arte lilás tem que aparecer atrás do painel */
    background: rgb(255 255 255 / 0.66);
    padding: 14px 16px;
    box-shadow: var(--shadow-lift);
    backdrop-filter: blur(14px) saturate(1.5);
  }

  /* --- entrada: só quando o bloco aparece (.is-in vem do reveal do index) --- */

  .anel {
    transition: stroke-dashoffset 1.7s cubic-bezier(0.16, 1, 0.3, 1) 0.25s;
  }
  :global(.reveal.is-in) .anel {
    stroke-dashoffset: var(--anel-final);
  }

  .linha {
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
  }
  :global(.reveal.is-in) .linha {
    animation: hero-traca 1.9s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
  }

  .area {
    opacity: 0;
  }
  :global(.reveal.is-in) .area {
    animation: hero-area 1.2s ease 1.1s forwards;
  }

  .pontos circle {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(.reveal.is-in) .pontos circle {
    animation: hero-ponto 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(0.6s + var(--p) * 0.28s);
  }

  @keyframes hero-traca {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes hero-area {
    to {
      opacity: 1;
    }
  }
  @keyframes hero-ponto {
    from {
      opacity: 0;
      scale: 0.4;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  /* --- flutuação contínua: só no desktop, onde os painéis são absolutos --- */
  @media (min-width: 64rem) {
    .painel-flutua {
      animation: turbo-float 7s ease-in-out infinite;
    }
    .painel-flutua[data-flutua='2'] {
      animation-delay: -2.4s;
      animation-duration: 8.5s;
    }
    .painel-flutua[data-flutua='3'] {
      animation-delay: -4.6s;
      animation-duration: 9.5s;
    }
  }
</style>
