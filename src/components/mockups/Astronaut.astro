---
/**
 * Astronauta sentado com o notebook no colo — ilustração do hero.
 * Regra do projeto: zero foto. É SVG puro, sem raster, ~3 KB.
 */
interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<svg
  viewBox="0 0 360 420"
  class={className}
  aria-hidden="true"
  fill="none"
>
  <defs>
    <linearGradient id="astSuit" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFFFFF"></stop>
      <stop offset="1" stop-color="#E4DEEC"></stop>
    </linearGradient>
    <linearGradient id="astShade" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#EEEAF3"></stop>
      <stop offset="1" stop-color="#CFC5DB"></stop>
    </linearGradient>
    <radialGradient id="astVisor" cx="0.35" cy="0.3" r="0.9">
      <stop offset="0" stop-color="#7A3F9C"></stop>
      <stop offset="0.45" stop-color="#3A064C"></stop>
      <stop offset="1" stop-color="#1B001D"></stop>
    </radialGradient>
    <linearGradient id="astGlass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"></stop>
    </linearGradient>
  </defs>

  <!-- sombra no chão -->
  <ellipse cx="190" cy="400" rx="120" ry="12" fill="#1B001D" opacity="0.08"></ellipse>

  <!-- mochila -->
  <rect x="58" y="150" width="78" height="128" rx="26" fill="url(#astShade)"></rect>
  <rect x="70" y="166" width="54" height="16" rx="8" fill="#BDB2CB"></rect>
  <rect x="70" y="192" width="54" height="16" rx="8" fill="#BDB2CB"></rect>

  <!-- perna de trás -->
  <path
    d="M132 300 L214 322 L208 388"
    stroke="#D9D2E2"
    stroke-width="40"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <ellipse cx="208" cy="392" rx="26" ry="14" fill="#BDB2CB"></ellipse>

  <!-- braço de trás -->
  <path
    d="M128 188 L112 250 L172 266"
    stroke="#D9D2E2"
    stroke-width="32"
    stroke-linecap="round"
    stroke-linejoin="round"></path>

  <!-- tronco -->
  <rect x="96" y="128" width="142" height="158" rx="54" fill="url(#astSuit)"></rect>
  <rect x="118" y="196" width="46" height="30" rx="8" fill="#F3F0F7" stroke="#D2C9DD" stroke-width="2"></rect>
  <circle cx="130" cy="211" r="5" fill="#6BDD12"></circle>
  <rect x="140" y="207" width="18" height="4" rx="2" fill="#BDB2CB"></rect>
  <rect x="140" y="214" width="12" height="4" rx="2" fill="#BDB2CB"></rect>

  <!-- perna da frente -->
  <path
    d="M150 292 L250 306 L244 384"
    stroke="url(#astSuit)"
    stroke-width="44"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    d="M150 292 L250 306 L244 384"
    stroke="#CFC5DB"
    stroke-width="44"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
    opacity="0.35"
    stroke-dasharray="0 1000"></path>
  <ellipse cx="246" cy="392" rx="28" ry="15" fill="#CFC5DB"></ellipse>
  <ellipse cx="246" cy="388" rx="28" ry="12" fill="#E4DEEC"></ellipse>

  <!-- notebook -->
  <g transform="translate(196 236) rotate(-14)">
    <rect x="-8" y="60" width="128" height="10" rx="5" fill="#BDB2CB"></rect>
    <rect x="0" y="-6" width="112" height="70" rx="8" fill="#F7F5FA" stroke="#CFC5DB" stroke-width="2"></rect>
    <rect x="8" y="2" width="96" height="54" rx="5" fill="#1B001D"></rect>
    <!-- foguete Turbo na tela -->
    <g transform="translate(56 29)" fill="#6BDD12">
      <path
        d="M-5 12 L-13 20 L-15 17 L-8 9 Z M7 -12 C11 -16 17 -17 20 -16 C21 -13 20 -7 16 -3 L13 0 L14 8 L8 14 L6 6 L0 4 L-6 -2 L2 -1 L4 -3 C5 -8 5 -8 7 -12 Z"></path>
      <circle cx="11" cy="-6" r="3" fill="#1B001D"></circle>
    </g>
  </g>

  <!-- braço da frente -->
  <path
    d="M222 186 L256 236 L236 258"
    stroke="url(#astSuit)"
    stroke-width="34"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="234" cy="262" r="18" fill="#E4DEEC"></circle>

  <!-- pescoço / anel do capacete -->
  <ellipse cx="180" cy="152" rx="44" ry="14" fill="#BDB2CB"></ellipse>

  <!-- capacete -->
  <circle cx="180" cy="94" r="70" fill="url(#astSuit)"></circle>
  <path
    d="M150 60 C176 44 214 50 232 74 C246 94 240 126 216 140 C190 154 154 146 138 120 C126 100 130 74 150 60 Z"
    fill="url(#astVisor)"></path>
  <path
    d="M154 68 C176 56 206 60 222 78 C214 76 194 74 178 80 C166 84 158 90 152 98 C148 88 148 76 154 68 Z"
    fill="url(#astGlass)"></path>
  <ellipse cx="164" cy="74" rx="8" ry="4" fill="#FFFFFF" opacity="0.7" transform="rotate(-28 164 74)"></ellipse>
  <!-- luz do capacete -->
  <circle cx="120" cy="112" r="7" fill="#6BDD12"></circle>
</svg>
