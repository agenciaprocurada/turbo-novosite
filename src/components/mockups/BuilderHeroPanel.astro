---
/**
 * Visual do hero do Turbo Builder: a janela do editor com o prompt, o site
 * recém-gerado (cafeteria) e a linha de publicação — mais os chips que
 * flutuam em volta no desktop. Tudo HTML/CSS, zero screenshot (regra 4).
 */
import MockupFrame from '../MockupFrame.astro'
import AnelNota from './AnelNota.astro'
import { turboBuilder } from '../../data/turbobuilder'

const d = turboBuilder.demo
---

<div class="relative lg:mr-4 lg:pt-3">
  <MockupFrame titulo={d.dominio} class="shadow-lift" bodyClass="p-3 sm:p-4">
    {/* Prompt */}
    <div class="flex items-center gap-2.5 rounded-[14px] border border-line bg-bg px-3 py-2.5">
      <span class="text-[14px] text-purple-logo" aria-hidden="true">✦</span>
      <span class="min-w-0 flex-1 truncate font-mono text-[11.5px] text-ink-soft">
        {d.prompt}<span class="cursor-pisca ml-px text-ink">|</span>
      </span>
      <span
        class="shrink-0 rounded-btn bg-green px-3 py-1.5 text-[11px] font-bold tracking-[0.04em] text-purple-950 uppercase"
      >
        {d.botaoGerar}
      </span>
    </div>

    {/* Site gerado */}
    <div class="mt-3 overflow-hidden rounded-[14px] border border-line">
      <div class="bg-linear-to-br from-purple-950 to-purple-800 px-4 py-4 text-white">
        <p class="text-[15px] font-bold">{d.negocio}</p>
        <p class="mt-0.5 text-[11.5px] text-white/65">{d.slogan}</p>
        <span
          class="mt-3 inline-block rounded-btn bg-green px-2.5 py-1 text-[10px] font-bold tracking-[0.04em] text-purple-950 uppercase"
        >
          {d.botaoSite}
        </span>
      </div>
      <div class="grid grid-cols-3 gap-2 bg-bg p-3">
        {
          d.itens.map((item) => (
            <div class="rounded-[10px] border border-line bg-surface px-2 py-2.5 text-center">
              <p class="truncate text-[11.5px] font-bold text-ink">{item.nome}</p>
              <p class="font-mono text-[10px] text-ink-soft">{item.preco}</p>
            </div>
          ))
        }
      </div>
    </div>

    {/* Publicação */}
    <div class="mt-3 flex items-center gap-2 font-mono text-[10.5px] text-green-deep">
      <span class="pulse-dot shrink-0" style="--pulse-color: var(--color-green-deep)"></span>
      <span class="min-w-0 truncate">{d.status} · {d.dominio} · SSL + Host brasileiro</span>
    </div>
  </MockupFrame>

  {/* Chips flutuantes — só no desktop, onde há margem em volta da janela */}
  <span
    class="absolute -top-1 right-0 hidden items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 font-mono text-[11px] text-ink shadow-soft lg:flex"
    aria-hidden="true"
  >
    <span class="pulse-dot" style="--pulse-color: var(--color-green-deep)"></span>{d.selo}
  </span>
  <span
    class="absolute top-[29%] -left-7 hidden items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 font-mono text-[11px] text-ink shadow-soft lg:flex"
    aria-hidden="true"
  >
    <svg viewBox="0 0 24 24" class="size-3.5 text-green-deep" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 11h12v9H6zM9 11V8a3 3 0 0 1 6 0v3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    {d.chips[0]}
  </span>
  <span
    class="absolute top-[60%] -right-5 hidden items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 font-mono text-[11px] text-ink shadow-soft lg:flex"
    aria-hidden="true"
  >
    <svg viewBox="0 0 24 24" class="size-3.5 text-green-deep" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 21V4M6 4h11l-2.5 3.5L17 11H6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    {d.chips[1]}
  </span>
  <span
    class="absolute -right-4 -bottom-5 hidden rounded-full border border-line bg-surface p-1.5 shadow-lift lg:block"
    aria-hidden="true"
  >
    <AnelNota valor={d.nota} tamanho={64} />
  </span>
</div>

<style>
  .cursor-pisca {
    animation: turbo-cursor 1s steps(2) infinite;
  }
  @keyframes turbo-cursor {
    to {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor-pisca {
      animation: none;
    }
  }
</style>
