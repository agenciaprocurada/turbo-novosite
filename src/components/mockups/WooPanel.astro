---
import MockupFrame from '../MockupFrame.astro'

const pedidos = [
  { id: '#8412', valor: 'R$ 289,90', estado: 'pago' },
  { id: '#8411', valor: 'R$ 1.140,00', estado: 'pago' },
  { id: '#8410', valor: 'R$ 74,50', estado: 'pago' },
]
---

<MockupFrame titulo="woocommerce · pedidos" bodyClass="p-4">
  <div class="flex items-baseline justify-between">
    <span class="font-mono text-[10.5px] tracking-[0.1em] text-ink-soft uppercase"
      >Pico de tráfego · 20h12</span
    >
    <span class="font-mono text-[11px] text-green-deep">CPU 34%</span>
  </div>

  <!-- Barra de uso estável mesmo no pico -->
  <div class="mt-2.5 flex h-9 items-end gap-1" aria-hidden="true">
    {
      [38, 44, 36, 52, 41, 47, 39, 55, 43, 49, 37, 46].map((h) => (
        <span class="flex-1 rounded-t-[3px] bg-green/35" style={`height:${h}%`} />
      ))
    }
  </div>

  <ul class="mt-3.5 flex flex-col gap-1.5">
    {
      pedidos.map((p) => (
        <li class="flex items-center gap-2.5 rounded-[12px] border border-line bg-bg px-3 py-2.5">
          <span class="font-mono text-[12px] text-ink-soft">{p.id}</span>
          <span class="min-w-0 flex-1 truncate text-[13.5px] font-medium text-ink">{p.valor}</span>
          <span class="shrink-0 rounded-full bg-green/14 px-2 py-0.5 font-mono text-[10px] tracking-[0.06em] text-green-deep uppercase">
            {p.estado}
          </span>
        </li>
      ))
    }
  </ul>

  <p class="mt-3 text-center font-mono text-[11px] text-ink-soft">
    checkout respondendo em <span class="text-green-deep">0,4 s</span>
  </p>
</MockupFrame>
