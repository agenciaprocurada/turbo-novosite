---
import MockupFrame from '../MockupFrame.astro'

const contas = ['contato@', 'financeiro@', 'comercial@', 'suporte@']
---

<MockupFrame titulo="servidor de e-mail · dedicado" bodyClass="p-4">
  <div class="flex items-center justify-between rounded-[12px] bg-purple-950 px-3 py-2.5">
    <span class="font-mono text-[11px] tracking-[0.08em] text-white/60 uppercase"
      >Entrega na caixa</span
    >
    <span class="flex items-center gap-2 font-mono text-[11px] text-green">
      <span class="pulse-dot"></span> SPF · DKIM · DMARC
    </span>
  </div>

  <ul class="mt-2.5 flex flex-col gap-1.5">
    {
      contas.map((c) => (
        <li class="flex items-center gap-2.5 rounded-[12px] border border-line bg-bg px-3 py-2">
          <span class="grid size-6 shrink-0 place-items-center rounded-full bg-green/14 font-mono text-[10px] text-green-deep">
            @
          </span>
          <span class="min-w-0 flex-1 truncate font-mono text-[12.5px] text-ink">
            {c}
            <span class="text-ink-soft">suaempresa.com.br</span>
          </span>
        </li>
      ))
    }
  </ul>

  <p class="mt-3 text-center font-mono text-[11px] text-ink-soft">
    contas <span class="text-green-deep">ilimitadas</span> · SMTP profissional
  </p>
</MockupFrame>
