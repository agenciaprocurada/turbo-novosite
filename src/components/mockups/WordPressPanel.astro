---
import MockupFrame from '../MockupFrame.astro'

const plugins = [
  { nome: 'Elementor Pro', versao: '3.31.2' },
  { nome: 'Crocoblock JetEngine', versao: '3.7.1' },
  { nome: 'Astra Pro', versao: '4.11.9' },
]
---

<MockupFrame titulo="cpanel · turbo plugins" bodyClass="p-4">
  <div class="flex items-center justify-between">
    <span class="font-mono text-[10.5px] tracking-[0.1em] text-ink-soft uppercase"
      >Plugins premium</span
    >
    <span
      class="rounded-full bg-green/14 px-2 py-0.5 font-mono text-[10px] tracking-[0.08em] text-green-deep uppercase"
      >inclusos</span
    >
  </div>

  <ul class="mt-3 flex flex-col gap-1.5">
    {
      plugins.map((p) => (
        <li class="flex items-center gap-2.5 rounded-[12px] border border-line bg-bg px-3 py-2.5">
          <svg
            viewBox="0 0 16 16"
            class="size-4 shrink-0 text-green-deep"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="min-w-0 flex-1 truncate text-[13.5px] text-ink">{p.nome}</span>
          <span class="shrink-0 font-mono text-[11px] text-ink-soft">{p.versao}</span>
        </li>
      ))
    }
  </ul>

  <div class="mt-3 flex items-center justify-between rounded-[12px] bg-purple-950 px-3 py-2.5">
    <span class="font-mono text-[11px] tracking-[0.08em] text-white/60 uppercase">TurboCache</span>
    <span class="flex items-center gap-2 font-mono text-[11px] text-green">
      <span class="pulse-dot"></span> LiteSpeed ativo
    </span>
  </div>
</MockupFrame>
