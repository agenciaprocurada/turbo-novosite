---
import { confiancaInfra as copy } from '../data/site'
---

<section class="trust-infra" aria-labelledby="trust-infra-title">
  <div class="container-page">
    <div class="trust-organizations">
      <p class="trust-eyebrow">{copy.eyebrow}</p>
      <div class="trust-carousel-shell">
      <button class="trust-arrow" type="button" data-direction="-1" aria-label="Ver logos anteriores"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>
      <div class="trust-carousel" tabindex="0" role="region" aria-label={copy.eyebrow}>
        <div class="trust-track">
          {[false, true].map(duplicate => (
            <ul class="trust-logo-group" aria-hidden={duplicate ? 'true' : undefined}>
              {copy.organizacoes.map(({ nome, logo, largura, altura, marca }) => (
                <li title={nome}><img class={`trust-logo trust-logo--${marca}`} src={logo} alt={duplicate ? '' : nome} width={largura} height={altura} decoding="async" /></li>
              ))}
            </ul>
          ))}
        </div>
      </div>
      <button class="trust-arrow" type="button" data-direction="1" aria-label="Ver próximos logos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button>
      </div>
    </div>
    <div class="trust-bottom reveal">
    <div class="trust-highlight">
      <img class="trust-highlight-logo" src={copy.governoLogo} alt="Brasão da República Federativa do Brasil" width="240" height="240" loading="lazy" decoding="async" />
      <p class="trust-highlight-text">
        <strong>+{copy.governo}</strong>
        <span class="trust-highlight-label-desktop">{copy.governoTexto}</span>
        <span class="trust-highlight-label-mobile">Sites<br />governamentais</span>
      </p>
      <div class="trust-highlight-seal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5 12 4l9 5.5H3ZM5 9.5V18M9.5 9.5V18M14.5 9.5V18M19 9.5V18M3 18h18M2 21h20" /></svg>
        <p>{copy.governoSelo.map((linha) => <span>{linha}</span>)}<strong>{copy.governoSeloDestaque}</strong></p>
      </div>
    </div>

      <h2 id="trust-infra-title"><span class="trust-count"><span class="sr-only">{copy.maisDe} </span><span aria-hidden="true">+</span>{copy.aplicacoes}</span> {copy.titulo}<br /><span class="trust-tagline">{copy.destaque}</span></h2>
    </div>

    <div class="trust-message">
      <p class="trust-description">{copy.descricao}</p>
      <div class="trust-facts">
      <div class="trust-government">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18M5 6.5h14M5 17.5h14" /></svg>
        <p>{copy.alcance} <strong>{copy.paises}</strong></p>
      </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-infra { background: var(--color-bg); padding: 34px 0 54px; }
  .trust-organizations { text-align: center; padding: 0 0 32px; }
  .trust-eyebrow { font: 11px/1.8 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--color-ink-soft); }
  .trust-carousel-shell { display: grid; grid-template-columns: 36px minmax(0, 1fr) 36px; align-items: center; gap: 16px; margin-top: 28px; }
  .trust-arrow { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--color-line); background: var(--color-surface); color: var(--color-purple-logo); cursor: pointer; transition: background .2s, border-color .2s; }
  .trust-arrow:hover { background: #5c1f850a; border-color: #5c1f8550; }
  .trust-arrow:focus-visible { outline: 2px solid var(--color-purple-logo); outline-offset: 3px; }
  .trust-arrow svg { width: 19px; height: 19px; }
  .trust-carousel { overflow: hidden; mask-image: linear-gradient(to right, transparent, black 2%, black 98%, transparent); }
  .trust-carousel:focus-visible { outline: 2px solid var(--color-purple-logo); outline-offset: 4px; }
  .trust-track { display: flex; width: max-content; animation: trust-scroll 55s linear infinite; }
  .trust-logo-group { display: flex; align-items: center; gap: 32px; padding-right: 32px; flex-shrink: 0; }
  .trust-logo-group li { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: auto; height: 100px; }
  .trust-carousel:hover .trust-track, .trust-carousel:focus-within .trust-track { animation-play-state: paused; }
  @keyframes trust-scroll { to { transform: translateX(-50%); } }
  .trust-logo { display: block; width: auto; max-width: 145px; height: 55px; object-fit: contain; filter: grayscale(1); opacity: .8; }
  .trust-logo--tallos { filter: brightness(0); opacity: .6; }
  .trust-logo--fiocruz, .trust-logo--abrint, .trust-logo--carloschagas { filter: brightness(0); opacity: .6; }
  .trust-logo--carloschagas { height: 70px; }
  .trust-logo--livup { height: 60px; }
  /* Cartão de destaque do governo: brasão em cores, número grande e selo à direita. */
  /* O envoltório tem a largura do título (max-content da linha mais longa) e o
     cartão ocupa 100% dele: as bordas do cartão batem com as do texto abaixo. */
  .trust-bottom { width: fit-content; max-width: 100%; margin: 8px auto 0; text-align: center; }
  .trust-bottom > .trust-highlight { contain: inline-size; }
  .trust-bottom h2 { width: max-content; max-width: 100%; margin: 34px auto 0; }
  .trust-highlight { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0; width: 100%; padding: 22px 28px; border: 1px solid #5c1f8518; border-radius: var(--radius-card); background: linear-gradient(115deg, #f4eefa 0%, #fbf9fd 48%, #f1e8f8 100%); box-shadow: var(--shadow-soft); text-align: left; }
  .trust-highlight-logo { width: 96px; height: 96px; object-fit: contain; margin-right: 24px; }
  .trust-highlight-text { min-width: 0; padding: 4px 24px; border-left: 1px solid #5c1f8522; }
  .trust-highlight-text strong { display: block; font: 800 clamp(40px, 4vw, 54px)/1 var(--font-sans); letter-spacing: -.03em; color: var(--color-purple-logo); }
  .trust-highlight-text span { display: block; margin-top: 6px; font-size: clamp(16px, 1.45vw, 20px); line-height: 1.3; color: var(--color-ink); }
  .trust-highlight-text .trust-highlight-label-mobile { display: none; }
  .trust-highlight-seal { padding: 4px 0 4px 24px; border-left: 1px solid #5c1f8522; }
  .trust-highlight-seal svg { width: 34px; height: 34px; color: var(--color-purple-logo); }
  .trust-highlight-seal p { margin-top: 8px; white-space: nowrap; font: 500 11px/1.7 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--color-purple-800); }
  .trust-highlight-seal span { display: block; }
  .trust-highlight-seal strong { display: block; font-weight: 800; color: var(--color-purple-logo); }
  .trust-message { text-align: center; }
  .trust-bottom h2 { font-size: clamp(1.7rem, 3.6vw, 2.7rem); font-weight: 700; line-height: 1.25; letter-spacing: -.025em; color: var(--color-ink); }
  .trust-count { color: var(--color-purple-logo); white-space: nowrap; }
  .trust-tagline { font-size: .87em; }
  .trust-description { max-width: 65ch; margin: 18px auto 0; color: var(--color-ink-soft); font-size: 15px; line-height: 1.8; }
  .trust-facts { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 24px; }
  .trust-government { display: inline-flex; align-items: center; gap: 13px; padding: 13px 22px; border-radius: var(--radius-btn); background: #5c1f8507; border: 1px solid #5c1f8518; text-align: left; }
  .trust-government svg { width: 25px; height: 25px; flex-shrink: 0; color: var(--color-purple-logo); }
  .trust-government p { font-size: 14px; color: var(--color-ink); line-height: 1.6; }
  .trust-government strong { color: var(--color-purple-logo); font-weight: 800; }
  .trust-government-detail { display: block; color: var(--color-ink-soft); font-size: 12px; }
  @media (min-width: 541px) {
    .trust-highlight { grid-template-columns: auto auto minmax(0, 1fr); }
    .trust-highlight-text, .trust-highlight-seal { align-self: stretch; display: flex; flex-direction: column; justify-content: center; padding-block: 0; }
    .trust-highlight-seal svg { flex-shrink: 0; }
  }
  @media (min-width: 541px) and (max-width: 1023px) {
    .trust-bottom { width: 100%; }
    .trust-bottom > .trust-highlight { contain: none; grid-template-columns: auto minmax(0, 1fr) auto; }
  }
  @media (min-width: 1024px) {
    .trust-highlight { width: 92%; margin-inline: auto; padding: 18px 24px; }
    .trust-highlight-logo { width: 84px; height: 84px; margin-right: 20px; }
    .trust-highlight-text { padding-inline: 20px; }
    .trust-highlight-text strong { font-size: 46px; }
    .trust-highlight-text span { font-size: 18px; }
    .trust-highlight-seal { padding-left: 20px; gap: 8px; }
    .trust-highlight-seal svg { width: 24px; height: 24px; }
    .trust-highlight-seal p { max-width: 17ch; margin: 0; white-space: normal; font: 600 14px/1.4 var(--font-sans); letter-spacing: 0; text-transform: none; text-wrap: balance; }
    .trust-highlight-seal span, .trust-highlight-seal strong { display: inline; }
    .trust-highlight-seal span::after { content: " "; }
  }
  @media (max-width: 540px) { .trust-infra { padding: 28px 0 38px; } .trust-eyebrow { font-size: 10px; } .trust-bottom h2 { margin-top: 28px; font-size: 27px; } .trust-description { font-size: 14px; } .trust-government { padding: 12px 15px; } .trust-government p { font-size: 13px; } }
  @media (max-width: 540px) {
    .trust-logo-group { gap: 24px; padding-right: 24px; }
    .trust-carousel-shell { gap: 8px; }
    .trust-logo-group li { height: 88px; }
    .trust-logo { height: 45px; max-width: 125px; }
    .trust-logo--carloschagas { height: 60px; }
    .trust-logo--livup { height: 50px; }
    .trust-bottom { width: 100%; margin-top: 4px; }
    .trust-bottom > .trust-highlight { contain: none; }
    /* Celular: brasão maior à esquerda, todas as informações na coluna ao lado. */
    .trust-highlight { grid-template-columns: 88px minmax(0, 1fr); grid-template-areas: "logo texto" "logo selo"; align-items: center; gap: 10px 14px; padding: 20px 16px; border-radius: 16px; background: #f7f2fb; box-shadow: none; text-align: left; }
    .trust-highlight-logo { grid-area: logo; width: 88px; height: 88px; margin: 0; }
    .trust-highlight-text { grid-area: texto; display: flex; align-items: center; gap: 8px; padding: 0; border: 0; text-align: left; }
    .trust-highlight-text strong { flex-shrink: 0; font-size: 44px; }
    .trust-highlight-text .trust-highlight-label-desktop { display: none; }
    .trust-highlight-text .trust-highlight-label-mobile { display: block; margin: 0; font-size: 14px; font-weight: 700; line-height: 1.3; }
    .trust-highlight-seal { grid-area: selo; padding: 10px 0 0; border-left: 0; border-top: 1px solid #5c1f8518; }
    .trust-highlight-seal svg { display: none; }
    .trust-highlight-seal p { margin: 0; white-space: normal; font: 600 12px/1.5 var(--font-sans); letter-spacing: 0; text-transform: none; text-align: left; text-wrap: balance; }
    .trust-highlight-seal span, .trust-highlight-seal strong { display: inline; }
    .trust-highlight-seal span::after { content: " "; }
  }
  @media (min-width: 375px) and (max-width: 389px) {
    .trust-highlight-text { gap: 6px; }
    .trust-highlight-text strong { font-size: 40px; }
  }
  @media (max-width: 374px) {
    .trust-highlight { grid-template-columns: 72px minmax(0, 1fr); column-gap: 10px; padding-inline: 12px; }
    .trust-highlight-logo { width: 72px; height: 72px; }
    .trust-highlight-text { gap: 6px; }
    .trust-highlight-text strong { font-size: 32px; }
    .trust-highlight-text .trust-highlight-label-mobile { font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .trust-track { animation: none; }
    .trust-carousel { overflow-x: auto; mask-image: none; }
    .trust-logo-group[aria-hidden="true"] { display: none; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.trust-carousel-shell').forEach(shell => {
    const viewport = shell.querySelector<HTMLElement>('.trust-carousel')!
    const track = shell.querySelector<HTMLElement>('.trust-track')!
    const group = shell.querySelector<HTMLElement>('.trust-logo-group')!
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
    let frame = 0
    const advance = (direction: number) => {
      cancelAnimationFrame(frame)
      const distance = Math.max(180, viewport.clientWidth * .65) * direction
      if (reduced.matches) {
        const max = viewport.scrollWidth - viewport.clientWidth
        const target = viewport.scrollLeft + distance
        viewport.scrollTo({ left: target > max ? 0 : target < 0 ? max : target, behavior: 'instant' })
        return
      }
      const animation = track.getAnimations().find(a => a instanceof CSSAnimation && a.animationName === 'trust-scroll')
      if (!animation?.effect || !group.offsetWidth) return
      const duration = Number(animation.effect.getTiming().duration)
      const shift = distance / group.offsetWidth * duration
      let start: number | undefined
      let previous = 0
      const step = (now: number) => {
        start ??= now
        const progress = Math.min(1, (now - start) / 350)
        const eased = 1 - Math.pow(1 - progress, 3)
        const time = Number(animation.currentTime ?? 0) + shift * (eased - previous)
        animation.currentTime = ((time % duration) + duration) % duration
        previous = eased
        if (progress < 1) frame = requestAnimationFrame(step)
      }
      frame = requestAnimationFrame(step)
    }
    shell.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach(button => {
      button.addEventListener('click', () => advance(Number(button.dataset.direction)))
    })
    viewport.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault()
        advance(event.key === 'ArrowRight' ? 1 : -1)
      }
    })
  })
</script>
