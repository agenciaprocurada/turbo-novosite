---
import { regioes } from '../data/site'

/**
 * Mapa-múndi pontilhado, gerado em build. Os continentes são contornos
 * simplificados em [lon, lat]; os pontos saem de um `<pattern>` SVG, então o
 * desenho inteiro custa alguns contornos em vez de milhares de <circle>.
 *
 * Aproximação intencional: é decoração, não cartografia.
 *
 * Sobre o mapa vão os três pontos de presença (Brasil, EUA e Europa) e as
 * rotas dos visitantes até o mais próximo, com um "pacote" que percorre a
 * curva em loop (offset-path). Tudo desliga em prefers-reduced-motion.
 */

/* ------------------------------------------------------------------ */
/* Projeção equiretangular                                             */
/* ------------------------------------------------------------------ */

const LON0 = -168
const LON1 = 180
const LAT0 = 74 // topo
const LAT1 = -56 // base (corta a Antártida)

const W = 700
const ESCALA = W / (LON1 - LON0)
const H = Math.round((LAT0 - LAT1) * ESCALA)

const px = (lon: number, lat: number): [number, number] => [
  Math.round((lon - LON0) * ESCALA),
  Math.round((LAT0 - lat) * ESCALA),
]

const contorno = (pts: [number, number][]) =>
  'M' + pts.map(([lo, la]) => px(lo, la).join(' ')).join('L') + 'Z'

/* ------------------------------------------------------------------ */
/* Continentes — contornos grosseiros, só o suficiente para reconhecer */
/* ------------------------------------------------------------------ */

const AMERICA_NORTE: [number, number][] = [
  [-168, 66], [-165, 60], [-152, 59], [-140, 60], [-130, 54], [-125, 49],
  [-124, 40], [-120, 34], [-114, 30], [-110, 24], [-105, 20], [-97, 16],
  [-92, 15], [-87, 13], [-83, 9], [-79, 8], [-82, 15], [-87, 21], [-91, 19],
  [-95, 19], [-97, 26], [-94, 29], [-89, 29], [-84, 30], [-81, 25], [-80, 32],
  [-76, 35], [-70, 42], [-67, 45], [-60, 47], [-55, 52], [-56, 58], [-64, 60],
  [-68, 63], [-78, 63], [-80, 70], [-90, 70], [-100, 69], [-115, 70],
  [-130, 70], [-140, 70], [-156, 71],
]

const AMERICA_SUL: [number, number][] = [
  [-81, -4], [-79, -8], [-76, -14], [-71, -18], [-70, -23], [-71, -30],
  [-73, -37], [-74, -44], [-75, -50], [-70, -55], [-66, -55], [-62, -50],
  [-63, -42], [-57, -38], [-57, -34], [-53, -33], [-48, -28], [-48, -25],
  [-45, -23], [-40, -21], [-39, -17], [-38, -12], [-35, -8], [-35, -5],
  [-44, -2], [-50, 0], [-51, 4], [-55, 5], [-60, 8], [-64, 10], [-72, 12],
  [-77, 8], [-79, 2],
]

const EUROPA: [number, number][] = [
  [-10, 36], [-9, 43], [-2, 43], [0, 49], [-5, 50], [-3, 55], [-6, 58],
  [2, 58], [5, 62], [10, 64], [15, 68], [22, 70], [28, 70], [35, 68],
  [40, 66], [45, 60], [50, 55], [52, 50], [47, 45], [40, 45], [35, 42],
  [28, 41], [24, 38], [20, 40], [16, 41], [12, 38], [9, 44], [5, 43], [0, 39],
  [-6, 36],
]

const ASIA: [number, number][] = [
  [50, 55], [60, 60], [70, 68], [80, 72], [95, 76], [110, 74], [125, 72],
  [140, 72], [160, 68], [170, 66], [175, 62], [160, 60], [150, 59], [142, 54],
  [135, 45], [130, 42], [127, 38], [122, 32], [118, 24], [110, 20], [105, 10],
  [100, 5], [95, 8], [92, 20], [88, 22], [80, 15], [77, 8], [72, 20], [68, 24],
  [62, 25], [57, 22], [50, 28], [45, 35], [48, 42], [52, 45],
]

const AFRICA: [number, number][] = [
  [-17, 15], [-16, 22], [-10, 28], [0, 32], [10, 34], [20, 32], [30, 31],
  [33, 28], [35, 22], [38, 15], [43, 11], [51, 12], [45, 5], [41, -2],
  [40, -10], [35, -18], [32, -26], [28, -33], [20, -34], [15, -28], [12, -18],
  [9, -2], [2, 5], [-8, 4], [-15, 11],
]

const OCEANIA: [number, number][] = [
  [113, -22], [114, -30], [118, -34], [125, -32], [132, -32], [138, -35],
  [145, -38], [150, -37], [153, -28], [146, -19], [142, -11], [135, -12],
  [130, -11], [126, -14], [122, -17],
]

const MADAGASCAR: [number, number][] = [
  [44, -12], [50, -15], [50, -21], [47, -25], [44, -22], [43, -16],
]

const terra = [
  AMERICA_NORTE, AMERICA_SUL, EUROPA, ASIA, AFRICA, OCEANIA, MADAGASCAR,
]
  .map(contorno)
  .join('')

/* ------------------------------------------------------------------ */
/* Pontos de presença e rotas dos visitantes                           */
/* ------------------------------------------------------------------ */

const pops = regioes.map((r) => {
  const [x, y] = px(r.lon, r.lat)
  return { ...r, x, y, xPct: +((x / W) * 100).toFixed(2), yPct: +((y / H) * 100).toFixed(2) }
})

const BR = pops[0]!
const US = pops[1]!
const EU = pops[2]!

/** Cidades de origem, cada uma ligada ao ponto de presença mais próximo.
 *  [lon, lat, pop, curvatura] — a curvatura abre as rotas em leque. */
const origens: [number, number, typeof BR, number][] = [
  // → Brasil
  [-38.5, -12.9, BR, -14],
  [-47.9, -15.8, BR, 12],
  [-43.2, -22.9, BR, -8],
  [-51.2, -30.0, BR, 14],
  [-60.0, -3.1, BR, 22],
  [-34.9, -8.0, BR, -20],
  [-58.4, -34.6, BR, 18],
  [-70.6, -33.4, BR, 24],
  [-74.1, 4.7, BR, 30],
  // → EUA
  [-74.0, 40.7, US, -10],
  [-118.2, 34.0, US, 16],
  [-87.6, 41.9, US, -12],
  [-80.2, 25.8, US, 14],
  [-79.4, 43.7, US, -14],
  [-99.1, 19.4, US, 20],
  // → Europa
  [-9.1, 38.7, EU, 14],
  [-3.7, 40.4, EU, 12],
  [-0.1, 51.5, EU, -10],
  [2.3, 48.9, EU, 8],
  [13.4, 52.5, EU, -12],
  [12.5, 41.9, EU, 14],
  [28.9, 41.0, EU, 18],
]

const rotas = origens.map(([lon, lat, pop, curva], i) => {
  const [ox, oy] = px(lon, lat)
  const mx = (ox + pop.x) / 2
  const my = (oy + pop.y) / 2
  const dx = pop.x - ox
  const dy = pop.y - oy
  const len = Math.hypot(dx, dy) || 1
  const cx = Math.round(mx + (-dy / len) * curva)
  const cy = Math.round(my + (dx / len) * curva)
  return {
    o: { x: ox, y: oy },
    d: `M${ox} ${oy} Q${cx} ${cy} ${pop.x} ${pop.y}`,
    dur: +(2.2 + (len / 200) * 1.6).toFixed(2),
    delay: +((i * 0.53) % 3.6).toFixed(2),
  }
})

/** Rotas entre os próprios pontos de presença — a "espinha" da rede. */
const espinha = [
  { de: BR, para: US, curva: 46 },
  { de: US, para: EU, curva: -34 },
  { de: BR, para: EU, curva: -40 },
].map(({ de, para, curva }, i) => {
  const mx = (de.x + para.x) / 2
  const my = (de.y + para.y) / 2
  const dx = para.x - de.x
  const dy = para.y - de.y
  const len = Math.hypot(dx, dy) || 1
  const cx = Math.round(mx + (-dy / len) * curva)
  const cy = Math.round(my + (dx / len) * curva)
  return {
    d: `M${de.x} ${de.y} Q${cx} ${cy} ${para.x} ${para.y}`,
    dur: +(4.4 + i * 0.7).toFixed(2),
    delay: +(i * 1.5).toFixed(2),
  }
})
---

<div class="w-full" aria-hidden="true">
  {/* O wrapper relativo envolve SÓ o SVG: os % dos marcadores são em relação
      ao mapa. (Com a legenda dentro da conta, o marcador descia.) */}
  <div class="relative">
    <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full" style={`aspect-ratio:${W}/${H}`}>
      <defs>
        {/* Os pontos do mapa saem daqui — um <circle> só, repetido pelo browser */}
        <pattern id="mapDots" width="9" height="9" patternUnits="userSpaceOnUse">
          <circle cx="4.5" cy="4.5" r="1.7" fill="currentColor"></circle>
        </pattern>
      </defs>

      <path d={terra} fill="url(#mapDots)" opacity=".3" fill-rule="evenodd"></path>

      {/* espinha da rede: PoP ↔ PoP */}
      <g fill="none" stroke="#6BDD12" stroke-opacity=".28" stroke-width="1.2" stroke-dasharray="5 6" stroke-linecap="round">
        {espinha.map((r) => <path d={r.d} />)}
      </g>

      {/* rotas dos visitantes */}
      <g fill="none" stroke="#6BDD12" stroke-opacity=".16" stroke-width="1" stroke-linecap="round">
        {rotas.map((r) => <path d={r.d} />)}
      </g>

      {/* origens */}
      <g fill="#FFFFFF" fill-opacity=".4">
        {rotas.map((r) => <circle cx={r.o.x} cy={r.o.y} r="1.9" />)}
      </g>

      {/* pacotes em movimento */}
      <g fill="#6BDD12">
        {
          rotas.map((r) => (
            <circle
              class="map-packet"
              r="2.4"
              style={`offset-path:path('${r.d}');animation-duration:${r.dur}s;animation-delay:-${r.delay}s`}
            />
          ))
        }
        {
          espinha.map((r) => (
            <circle
              class="map-packet"
              r="3"
              style={`offset-path:path('${r.d}');animation-duration:${r.dur}s;animation-delay:-${r.delay}s`}
            />
          ))
        }
      </g>
    </svg>

    {
      pops.map((pop) => (
        <span
          class="map-marker absolute -translate-x-1/2 -translate-y-1/2"
          style={`left:${pop.xPct}%;top:${pop.yPct}%`}
        >
          <span
            class:list={['block rounded-full', pop.principal ? 'size-3 bg-green' : 'size-2 bg-green/70']}
            style={pop.principal ? 'animation: turbo-marker 2.4s ease-in-out infinite' : ''}
          />
          {pop.principal ? (
            <span class="absolute top-full left-1/2 mt-2 hidden -translate-x-1/2 items-center gap-1.5 rounded-full border border-green/25 bg-green/12 px-2 py-1 font-mono text-[9.5px] leading-none tracking-[0.08em] whitespace-nowrap text-green uppercase backdrop-blur-sm sm:inline-flex">
              <span class="size-1 rounded-full bg-green" />
              São Paulo ({pop.detalhe})
            </span>
          ) : (
            <span class="absolute bottom-full left-1/2 mb-2 hidden -translate-x-1/2 font-mono text-[9.5px] leading-none tracking-[0.1em] whitespace-nowrap text-white/60 uppercase sm:block">
              {pop.detalhe}
            </span>
          )}
        </span>
      ))
    }
  </div>

  {/* No celular o rótulo não cabe sobre o mapa — vira legenda */}
  <ul class="mt-4 flex flex-wrap justify-center gap-2 sm:hidden">
    {
      regioes.map((regiao) => (
        <li
          class:list={[
            'rounded-full border px-2.5 py-1.5 font-mono text-[11px] tracking-[0.08em] uppercase',
            regiao.principal
              ? 'border-green/30 bg-green/12 text-green'
              : 'border-white/12 text-white/45',
          ]}
        >
          {regiao.nome} ({regiao.detalhe})
        </li>
      ))
    }
  </ul>
</div>
