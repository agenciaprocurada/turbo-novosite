---
import { regioes } from '../data/site'

/**
 * Mapa do Brasil pontilhado, gerado em build — grade de pontos recortada por um
 * contorno simplificado do país (lon/lat). Custa ~5KB de SVG e nenhuma imagem.
 * Aproximação intencional: é decoração, não cartografia.
 */

// Contorno aproximado do Brasil em [lon, lat], sentido horário a partir do Acre.
const contorno: [number, number][] = [
  [-73.9, -7.3], [-72.9, -9.4], [-70.6, -11.0], [-69.5, -10.9], [-68.7, -11.1],
  [-66.7, -9.9], [-65.4, -9.7], [-65.3, -11.5], [-64.4, -12.5], [-60.5, -13.8],
  [-60.2, -15.1], [-60.2, -16.3], [-58.4, -17.2], [-58.2, -19.8], [-57.8, -22.1],
  [-55.7, -22.4], [-55.4, -24.0], [-54.6, -25.6], [-53.8, -27.2], [-55.8, -28.3],
  [-57.6, -30.2], [-56.0, -31.1], [-53.4, -33.7], [-52.6, -32.9], [-50.6, -31.0],
  [-48.6, -28.6], [-48.5, -26.0], [-46.3, -24.0], [-44.7, -23.1], [-41.9, -22.9],
  [-40.9, -21.3], [-39.7, -19.7], [-39.0, -17.7], [-38.9, -15.7], [-38.5, -13.0],
  [-37.0, -11.0], [-35.2, -8.9], [-34.8, -7.2], [-35.3, -5.5], [-37.3, -4.8],
  [-39.5, -3.0], [-41.8, -2.9], [-44.3, -2.5], [-46.5, -1.0], [-48.3, -0.9],
  [-49.5, 0.6], [-50.5, 1.5], [-51.6, 4.2], [-52.6, 2.3], [-54.5, 2.4],
  [-56.5, 1.9], [-58.4, 1.5], [-59.9, 1.7], [-59.8, 3.5], [-60.6, 5.2],
  [-61.4, 4.2], [-62.8, 3.7], [-64.0, 4.1], [-65.6, 0.9], [-66.9, 1.2],
  [-69.4, 1.1], [-69.9, -4.2], [-72.9, -5.0],
]

const dentro = (x: number, y: number) => {
  let ok = false
  for (let i = 0, j = contorno.length - 1; i < contorno.length; j = i++) {
    const [xi, yi] = contorno[i]
    const [xj, yj] = contorno[j]
    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) ok = !ok
  }
  return ok
}

// Projeção simples: 1° = ESCALA px. Brasil tem ~39° × 39°, então cabe num quadrado.
const W = 560
const H = 400
const ESCALA = 9.6
const LON0 = -74
const LAT0 = 5.4
const OFFSET_X = (W - 39.2 * ESCALA) / 2
const STEP = 11

const pontos: { x: number; y: number }[] = []
for (let y = STEP / 2; y < H; y += STEP) {
  for (let x = STEP / 2; x < W; x += STEP) {
    const lon = (x - OFFSET_X) / ESCALA + LON0
    const lat = LAT0 - y / ESCALA
    if (dentro(lon, lat)) pontos.push({ x, y })
  }
}

/* ---- Rotas de acesso: capitais → São Paulo -------------------------------
   Cada origem vira um ponto + uma curva até o servidor. Um "pacote" verde
   percorre a curva em loop (CSS offset-path), com atraso diferente por cidade
   para o tráfego parecer contínuo. Decoração: as cidades são só as capitais. */
const proj = (lon: number, lat: number) => ({
  x: Math.round(OFFSET_X + (lon - LON0) * ESCALA),
  y: Math.round((LAT0 - lat) * ESCALA),
})

const SP = proj(-46.63, -23.55)

/** As 26 capitais além de São Paulo. A curvatura (último número) desvia a rota
 *  para um lado ou para o outro, para as linhas abrirem em leque em vez de
 *  virarem um feixe reto. */
const origens: [string, number, number, number][] = [
  ['Boa Vista', -60.67, 2.82, 70],
  ['Macapá', -51.07, 0.03, -50],
  ['Manaus', -60.02, -3.1, 58],
  ['Belém', -48.5, -1.46, -40],
  ['São Luís', -44.3, -2.53, -45],
  ['Fortaleza', -38.54, -3.73, -55],
  ['Teresina', -42.8, -5.09, -34],
  ['Natal', -35.21, -5.79, -60],
  ['João Pessoa', -34.86, -7.12, -50],
  ['Recife', -34.88, -8.05, -42],
  ['Porto Velho', -63.9, -8.76, 46],
  ['Rio Branco', -67.81, -9.97, 52],
  ['Palmas', -48.33, -10.18, 26],
  ['Aracaju', -37.07, -10.91, -32],
  ['Salvador', -38.5, -12.97, -26],
  ['Cuiabá', -56.1, -15.6, 34],
  ['Brasília', -47.93, -15.78, 20],
  ['Goiânia', -49.25, -16.68, -12],
  ['Belo Horizonte', -43.94, -19.92, -18],
  ['Vitória', -40.34, -20.32, -28],
  ['Campo Grande', -54.65, -20.44, 24],
  ['Rio de Janeiro', -43.17, -22.91, -14],
  ['Curitiba', -49.27, -25.43, 16],
  ['Florianópolis', -48.55, -27.6, -14],
  ['Porto Alegre', -51.23, -30.03, 22],
  ['Maceió', -35.73, -9.67, -38],
]

/* Rota internacional: de São Paulo até o ponto de presença nos EUA, no canto
   superior esquerdo (10% / 10% do quadro — mesma posição do marcador em
   `regioes`). Tracejada, para se distinguir das rotas domésticas. */
const EUA = { x: Math.round(W * 0.1), y: Math.round(H * 0.1) }
const rotaEUA = `M${SP.x} ${SP.y} Q${Math.round((SP.x + EUA.x) / 2 - 40)} ${Math.round(
  (SP.y + EUA.y) / 2 + 70,
)} ${EUA.x} ${EUA.y}`

const rotas = origens.map(([nome, lon, lat, curva], i) => {
  const o = proj(lon, lat)
  // ponto de controle: meio do segmento deslocado na perpendicular
  const mx = (o.x + SP.x) / 2
  const my = (o.y + SP.y) / 2
  const dx = SP.x - o.x
  const dy = SP.y - o.y
  const len = Math.hypot(dx, dy) || 1
  const cx = Math.round(mx + (-dy / len) * curva)
  const cy = Math.round(my + (dx / len) * curva)
  const d = `M${o.x} ${o.y} Q${cx} ${cy} ${SP.x} ${SP.y}`
  const dur = +(2.4 + (len / 300) * 1.8).toFixed(2)
  const delay = +((i * 0.61) % 4).toFixed(2)
  return { nome, o, d, dur, delay }
})
---

<div class="w-full" aria-hidden="true">
  {/* O wrapper relativo envolve SÓ o SVG: os % do marcador são em relação ao mapa.
      (No celular a legenda abaixo entrava na conta e o marcador descia.) */}
  <div class="relative">
  <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full" style={`aspect-ratio:${W}/${H}`}>
    <g class="map-dots" fill="currentColor" opacity=".26">
      {pontos.map((p) => <circle cx={p.x} cy={p.y} r="2" />)}
    </g>

    {/* rotas (traço fino) */}
    <g fill="none" stroke="#6BDD12" stroke-width="1" stroke-opacity=".18" stroke-linecap="round">
      {rotas.map((r) => <path d={r.d} />)}
    </g>

    {/* rota internacional São Paulo → EUA */}
    <path
      d={rotaEUA}
      fill="none"
      stroke="#6BDD12"
      stroke-width="1"
      stroke-opacity=".3"
      stroke-dasharray="5 6"
      stroke-linecap="round"></path>
    <circle
      class="map-packet"
      r="3"
      fill="#6BDD12"
      style={`offset-path:path('${rotaEUA}');animation-duration:4.2s;animation-delay:-1s`}></circle>

    {/* origens */}
    <g fill="#FFFFFF" fill-opacity=".45">
      {rotas.map((r) => <circle cx={r.o.x} cy={r.o.y} r="2" />)}
    </g>

    {/* pacotes em movimento */}
    <g fill="#6BDD12">
      {
        rotas.map((r) => (
          <circle
            class="map-packet"
            r="2.6"
            style={`offset-path:path('${r.d}');animation-duration:${r.dur}s;animation-delay:-${r.delay}s`}
          />
        ))
      }
    </g>
  </svg>

  {
    regioes.map((regiao) => (
      <span
        class="map-marker absolute -translate-x-1/2 -translate-y-1/2"
        style={`left:${regiao.x}%;top:${regiao.y}%`}
      >
        <span
          class:list={[
            'block rounded-full',
            regiao.principal ? 'size-3 bg-green' : 'size-2 bg-white/45',
          ]}
          style={regiao.principal ? 'animation: turbo-marker 2.4s ease-in-out infinite' : ''}
        />
        {regiao.principal ? (
          <span class="absolute bottom-full left-1/2 mb-2.5 hidden -translate-x-1/2 items-center gap-2 rounded-full border border-white/12 bg-white/10 px-3 py-1.5 font-mono text-[10.5px] tracking-[0.08em] whitespace-nowrap text-white uppercase backdrop-blur-sm sm:inline-flex">
            <span class="size-1.5 rounded-full bg-green" />
            {regiao.nome} ({regiao.detalhe})
          </span>
        ) : (
          <span class="absolute top-full left-1/2 mt-2 hidden -translate-x-1/2 font-mono text-[9.5px] tracking-[0.1em] whitespace-nowrap text-white/55 uppercase sm:block">
            {regiao.detalhe}
          </span>
        )}
      </span>
    ))
  }

  </div>

  {/* No mobile o rótulo não cabe sobre o mapa — vira legenda */}
  <ul class="mt-4 flex flex-wrap justify-center gap-2 sm:hidden">
    {
      regioes.map((regiao) => (
        <li
          class:list={[
            'rounded-full border px-2.5 py-1.5 font-mono text-[11px] tracking-[0.08em] uppercase',
            regiao.principal
              ? 'border-green/30 bg-green/12 text-green'
              : 'border-white/12 text-white/45',
          ]}
        >
          {regiao.nome} ({regiao.detalhe})
        </li>
      ))
    }
  </ul>
</div>
