---
import { regioes } from '../data/site'

/**
 * Globo pontilhado gerado no build por projeção ortográfica de contornos
 * simplificados em [lon, lat]. Sem dependências ou renderização em JavaScript.
 *
 * Aproximação intencional: é decoração, não cartografia.
 *
 * Sobre o mapa vão os três pontos de presença (Brasil, EUA e Europa) e as
 * rotas dos visitantes até o mais próximo, com um "pacote" que percorre a
 * curva em loop (offset-path). Tudo desliga em prefers-reduced-motion.
 */

/* ------------------------------------------------------------------ */
/* Projeção ortográfica                                               */
/* ------------------------------------------------------------------ */

const W = 600
const H = 560
const R = 232
// Projeção ortográfica centrada no Atlântico: as três regiões ficam visíveis.
const px = (lon: number, lat: number): [number, number] => {
  const a = (lon + 30) * Math.PI / 180
  const b = lat * Math.PI / 180
  return [+(300 + R * Math.cos(b) * Math.sin(a)).toFixed(2), +(270 - R * Math.sin(b)).toFixed(2)]
}

/* ------------------------------------------------------------------ */
/* Continentes — contornos grosseiros, só o suficiente para reconhecer */
/* ------------------------------------------------------------------ */

const AMERICA_NORTE: [number, number][] = [
  [-168, 66], [-165, 60], [-152, 59], [-140, 60], [-130, 54], [-125, 49],
  [-124, 40], [-120, 34], [-114, 30], [-110, 24], [-105, 20], [-97, 16],
  [-92, 15], [-87, 13], [-83, 9], [-79, 8], [-82, 15], [-87, 21], [-91, 19],
  [-95, 19], [-97, 26], [-94, 29], [-89, 29], [-84, 30], [-81, 25], [-80, 32],
  [-76, 35], [-70, 42], [-67, 45], [-60, 47], [-55, 52], [-56, 58], [-64, 60],
  [-68, 63], [-78, 63], [-80, 70], [-90, 70], [-100, 69], [-115, 70],
  [-130, 70], [-140, 70], [-156, 71],
]

const AMERICA_SUL: [number, number][] = [
  [-81, -4], [-79, -8], [-76, -14], [-71, -18], [-70, -23], [-71, -30],
  [-73, -37], [-74, -44], [-75, -50], [-70, -55], [-66, -55], [-62, -50],
  [-63, -42], [-57, -38], [-57, -34], [-53, -33], [-48, -28], [-48, -25],
  [-45, -23], [-40, -21], [-39, -17], [-38, -12], [-35, -8], [-35, -5],
  [-44, -2], [-50, 0], [-51, 4], [-55, 5], [-60, 8], [-64, 10], [-72, 12],
  [-77, 8], [-79, 2],
]

const EUROPA: [number, number][] = [
  [-10, 36], [-9, 43], [-2, 43], [0, 49], [-5, 50], [-3, 55], [-6, 58],
  [2, 58], [5, 62], [10, 64], [15, 68], [22, 70], [28, 70], [35, 68],
  [40, 66], [45, 60], [50, 55], [52, 50], [47, 45], [40, 45], [35, 42],
  [28, 41], [24, 38], [20, 40], [16, 41], [12, 38], [9, 44], [5, 43], [0, 39],
  [-6, 36],
]

const ASIA: [number, number][] = [
  [50, 55], [60, 60], [70, 68], [80, 72], [95, 76], [110, 74], [125, 72],
  [140, 72], [160, 68], [170, 66], [175, 62], [160, 60], [150, 59], [142, 54],
  [135, 45], [130, 42], [127, 38], [122, 32], [118, 24], [110, 20], [105, 10],
  [100, 5], [95, 8], [92, 20], [88, 22], [80, 15], [77, 8], [72, 20], [68, 24],
  [62, 25], [57, 22], [50, 28], [45, 35], [48, 42], [52, 45],
]

const AFRICA: [number, number][] = [
  [-17, 15], [-16, 22], [-10, 28], [0, 32], [10, 34], [20, 32], [30, 31],
  [33, 28], [35, 22], [38, 15], [43, 11], [51, 12], [45, 5], [41, -2],
  [40, -10], [35, -18], [32, -26], [28, -33], [20, -34], [15, -28], [12, -18],
  [9, -2], [2, 5], [-8, 4], [-15, 11],
]

const OCEANIA: [number, number][] = [
  [113, -22], [114, -30], [118, -34], [125, -32], [132, -32], [138, -35],
  [145, -38], [150, -37], [153, -28], [146, -19], [142, -11], [135, -12],
  [130, -11], [126, -14], [122, -17],
]

const MADAGASCAR: [number, number][] = [
  [44, -12], [50, -15], [50, -21], [47, -25], [44, -22], [43, -16],
]

const continents = [AMERICA_NORTE, AMERICA_SUL, EUROPA, ASIA, AFRICA, OCEANIA, MADAGASCAR]
const inside = (lon: number, lat: number, polygon: [number, number][]) => {
  let hit = false
  for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
    const [x, y] = polygon[i]!
    const [u, v] = polygon[j]!
    if ((y > lat) !== (v > lat) && lon < (u - x) * (lat - y) / (v - y) + x) hit = !hit
  }
  return hit
}
const dots: { x: number; y: number; opacity: number }[] = []
for (let lat = -76; lat < 78; lat += 1.7) {
  for (let lon = -180; lon < 180; lon += 1.7 / Math.max(.25, Math.cos(lat * Math.PI / 180))) {
    const depth = Math.cos((lon + 30) * Math.PI / 180) * Math.cos(lat * Math.PI / 180)
    if (depth > .02 && continents.some(p => inside(lon, lat, p))) {
      const [x, y] = px(lon, lat)
      dots.push({ x, y, opacity: .35 + depth * .5 })
    }
  }
}

/* ------------------------------------------------------------------ */
/* Pontos de presença e rotas dos visitantes                           */
/* ------------------------------------------------------------------ */

const pops = regioes.map((r) => {
  const [x, y] = px(r.lon, r.lat)
  return { ...r, x, y, xPct: +((x / W) * 100).toFixed(2), yPct: +((y / H) * 100).toFixed(2) }
})

const BR = pops[0]!
const US = pops[1]!
const EU = pops[2]!

/** Cidades de origem, cada uma ligada ao ponto de presença mais próximo.
 *  [lon, lat, pop, curvatura] — a curvatura abre as rotas em leque. */
const origens: [number, number, typeof BR, number][] = [
  // → Brasil
  [-38.5, -12.9, BR, -14],
  [-47.9, -15.8, BR, 12],
  [-43.2, -22.9, BR, -8],
  [-51.2, -30.0, BR, 14],
  [-60.0, -3.1, BR, 22],
  [-34.9, -8.0, BR, -20],
  [-58.4, -34.6, BR, 18],
  [-70.6, -33.4, BR, 24],
  [-74.1, 4.7, BR, 30],
  // → EUA
  [-74.0, 40.7, US, -10],
  [-118.2, 34.0, US, 16],
  [-87.6, 41.9, US, -12],
  [-80.2, 25.8, US, 14],
  [-79.4, 43.7, US, -14],
  [-99.1, 19.4, US, 20],
  // → Europa
  [-9.1, 38.7, EU, 14],
  [-3.7, 40.4, EU, 12],
  [-0.1, 51.5, EU, -10],
  [2.3, 48.9, EU, 8],
  [13.4, 52.5, EU, -12],
  [12.5, 41.9, EU, 14],
  [28.9, 41.0, EU, 18],
]

const rotas = origens.map(([lon, lat, pop, curva], i) => {
  const [ox, oy] = px(lon, lat)
  const mx = (ox + pop.x) / 2
  const my = (oy + pop.y) / 2
  const dx = pop.x - ox
  const dy = pop.y - oy
  const len = Math.hypot(dx, dy) || 1
  const cx = Math.round(mx + (-dy / len) * curva)
  const cy = Math.round(my + (dx / len) * curva)
  return {
    o: { x: ox, y: oy },
    d: `M${ox} ${oy} Q${cx} ${cy} ${pop.x} ${pop.y}`,
    dur: +(2.2 + (len / 200) * 1.6).toFixed(2),
    delay: +((i * 0.53) % 3.6).toFixed(2),
  }
})

/** Rotas entre os próprios pontos de presença — a "espinha" da rede. */
const espinha = [
  { de: BR, para: US, curva: 46 },
  { de: US, para: EU, curva: -34 },
  { de: BR, para: EU, curva: -40 },
].map(({ de, para, curva }, i) => {
  const mx = (de.x + para.x) / 2
  const my = (de.y + para.y) / 2
  const dx = para.x - de.x
  const dy = para.y - de.y
  const len = Math.hypot(dx, dy) || 1
  const cx = Math.round(mx + (-dy / len) * curva)
  const cy = Math.round(my + (dx / len) * curva)
  return {
    d: `M${de.x} ${de.y} Q${cx} ${cy} ${para.x} ${para.y}`,
    dur: +(4.4 + i * 0.7).toFixed(2),
    delay: +(i * 1.5).toFixed(2),
  }
})
---

<div class="turbo-globe" role="img" aria-label="Infraestrutura Turbo Cloud no Brasil, nos Estados Unidos e na Europa, com conexões animadas entre as regiões.">
  <div class="globe-scene" aria-hidden="true">
    <svg viewBox="0 0 600 560" class="globe-svg">
      <defs>
        <radialGradient id="globe-light"><stop offset="0" stop-color="#faf7ff"/><stop offset=".75" stop-color="#f4effb"/><stop offset="1" stop-color="#e7dbf5" stop-opacity=".2"/></radialGradient>
      </defs>
      <circle cx="300" cy="270" r="232" fill="url(#globe-light)"/>
      <g fill="#9669c5">{dots.map(p => <circle cx={p.x} cy={p.y} r="1.5" opacity={p.opacity}/>)}</g>
      <g fill="none" stroke="#5c1f85" stroke-width="1" opacity=".15">{rotas.map(r => <path d={r.d}/> )}</g>
      <g fill="none" stroke="#5c1f85" stroke-width="1.4" stroke-dasharray="4 6" opacity=".3">{espinha.map(r => <path d={r.d}/> )}</g>
      <g fill="#5c1f85">{[...rotas, ...espinha].map(r => <circle class="globe-packet" r="2.5" style={`offset-path:path('${r.d}');animation-duration:${r.dur}s;animation-delay:-${r.delay}s`}/>)}</g>
      {pops.map(p => <g><circle class="globe-pulse" cx={p.x} cy={p.y} r="10" fill="#6bdd12" opacity=".25"/><circle cx={p.x} cy={p.y} r="4.5" fill="#5c1f85" stroke="white" stroke-width="2"/></g>)}
    </svg>
    {pops.map(pop => <span class={`globe-label globe-label--${pop.detalhe}`} style={`left:${pop.xPct}%;top:${pop.yPct}%`}><span class="label-dot"></span>{pop.principal ? 'São Paulo · Brasil' : pop.nome}</span>)}
  </div>
</div>
<style>
  .turbo-globe { width: 100%; max-width: 650px; margin-inline: auto; }
  .globe-scene { position: relative; animation: globe-float 9s ease-in-out infinite; }
  .globe-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .globe-label { position: absolute; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 10px 13px; border: 1px solid #5c1f8526; border-radius: 11px; background: #ffffffed; box-shadow: 0 8px 26px #300c5110; color: #300c51; font: 11px/1.3 var(--font-mono); transform: translate(10px,-130%); }
  .globe-label--EU { transform: translate(-30%,-140%); }
  .label-dot { width: 6px; height: 6px; border-radius: 50%; background: #5c1f85; }
  .globe-packet { animation: globe-travel 4s linear infinite; }
  .globe-pulse { animation: globe-pulse 3s ease-in-out infinite; }
  @keyframes globe-travel { to { offset-distance: 100%; } }
  @keyframes globe-float { 50% { transform: translateY(-8px) rotate(1deg); } }
  @keyframes globe-pulse { 50% { opacity: .65; } }
  @media(max-width:540px) { .globe-label { font-size: 9px; padding: 7px 8px; gap: 5px; } }
  @media(prefers-reduced-motion:reduce) { .globe-scene,.globe-packet,.globe-pulse { animation: none; } .globe-packet { display: none; } }
</style>
