---
interface Props {
  titulo: string
  texto: string
  destaque: string
  href: string
  cta: string
  class?: string
}

const { titulo, texto, destaque, href, cta, class: className = '' } = Astro.props
---

<article
  class:list={[
    'group flex flex-col gap-5 rounded-card border border-line bg-surface p-5 transition-shadow duration-300 hover:shadow-soft sm:p-6',
    className,
  ]}
>
  <div>
    <h3 class="text-[clamp(1.2rem,2.3vw,1.45rem)] font-bold text-ink">{titulo}</h3>
    <p class="mt-2.5 max-w-[46ch] text-[15px] leading-relaxed text-ink-soft">{texto}</p>
    <p class="mt-3">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-green/12 px-2.5 py-1 font-mono text-[11px] tracking-[0.06em] text-green-deep uppercase"
        >{destaque}</span
      >
    </p>
  </div>

  <div class="mt-auto"><slot /></div>

  <a
    href={href}
    rel="noopener"
    class="inline-flex items-center gap-1.5 text-[14.5px] font-medium text-green-deep transition-[gap] duration-200 hover:gap-2.5"
  >
    {cta}
    <span aria-hidden="true">→</span>
  </a>
</article>
