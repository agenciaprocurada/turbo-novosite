---
/** S3 · Prova social — nota do Google + carrossel de depoimentos.
 *  Compartilhada entre a home e as páginas de produto. */
import TestimonialCarousel from '../TestimonialCarousel.astro'
import { provas, links } from '../../data/site'

interface Props {
  texto?: string
  class?: string
}

const {
  texto = 'Clientes que confiam na Turbo Cloud para manter tudo no ar, rápido e seguro.',
  class: cls = 'pt-[clamp(48px,6vw,80px)] pb-[clamp(40px,5vw,64px)]',
} = Astro.props
---

<section class={cls}>
  <div class="container-page">
    <div class="reveal grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-16">
      <div class="text-center lg:text-left">
        <p class="text-[17px] tracking-[0.12em] text-star" aria-label="Nota 5 de 5 estrelas">
          ★★★★★
        </p>
        <h2
          class="mt-3 text-[clamp(1.6rem,3vw,2rem)] leading-[1.15] font-bold tracking-[-0.018em] text-ink"
        >
          <span data-count>{provas.avaliacoesGoogle.toLocaleString('pt-BR')}</span> avaliações<br />e nota {provas.notaGoogle} no
          Google.
        </h2>
        <p class="mx-auto mt-3 max-w-[36ch] text-[14.5px] leading-relaxed text-ink-soft lg:mx-0 lg:mt-4">
          {texto}
        </p>
        <a
          href={links.avaliacoes}
          rel="noopener"
          target="_blank"
          class="mt-4 inline-block py-2 text-[14px] font-semibold text-ink underline decoration-line lg:mt-5 underline-offset-4 transition-colors hover:text-green-deep hover:decoration-green-deep"
          >Ver todas as avaliações →</a
        >
      </div>

      <TestimonialCarousel />
    </div>
  </div>
</section>
