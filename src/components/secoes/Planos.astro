---
/** S10 · Planos — produto (controle segmentado) × localização (dropdown, só
 *  Hospedagem) × ciclo mensal/anual (interruptor).
 *  A home mostra os três produtos; cada página de produto mostra só o seu,
 *  e nesse caso o controle segmentado some (não há o que alternar). */
import Bandeira from '../Bandeira.astro'
import PricingCard from '../PricingCard.astro'
import { abasPlanos, planosCabecalho, garantiasPlanos, garantiasVps, notaPlanos } from '../../data/site'
import type { AbaPlanos } from '../../data/site'

interface Props {
  abas?: AbaPlanos[]
  titulo1?: string
  titulo2a?: string
  titulo2b?: string
  texto?: string
  /** Pílula acima do título. `false` desliga — nas páginas de produto ela sobra. */
  selo?: string | false
  id?: string
  class?: string
}

const {
  abas = abasPlanos,
  titulo1 = planosCabecalho.titulo1,
  titulo2a = planosCabecalho.titulo2a,
  titulo2b = planosCabecalho.titulo2b,
  texto = planosCabecalho.texto,
  selo = planosCabecalho.selo,
  id = 'planos',
  class: cls = 'py-[clamp(72px,9vw,132px)]',
} = Astro.props

// Ícones dos 4 planos de hospedagem (One, Three, Duo, Revenda)
const ICONES_PLANOS = ['foguete', 'coroa', 'camadas', 'grupo'] as const
const ICONES_GARANTIAS = {
  migracao: 'M7 18a4 4 0 0 1-.6-7.95A6 6 0 0 1 18 8.5a4.5 4.5 0 0 1-.5 9.5H7Zm5-6v6m-2.5-3.5L12 12l2.5 2.5',
  uptime: 'M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3Zm-3 9 2 2 4-4',
  backup: 'M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4M12 8v4l3 2',
  ssl: 'M6 11V8a6 6 0 0 1 12 0v3M5 11h14v10H5zM12 15v3',
  garantia: 'M5 5h14v15H5zM5 9h14M9 3v4m6-4v4m-6 8 2 2 4-4',
  suporte: 'M4 14v-2a8 8 0 0 1 16 0v2M4 14a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2v-2Zm16 0a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2v-2Zm-3 5a3 3 0 0 1-3 2',
} as const

const garantiasDaAba = (aba: AbaPlanos) => (aba.familia === 'vps' ? garantiasVps : garantiasPlanos)

/** Produtos presentes (na ordem das abas) e o rótulo de cada um no controle segmentado. */
const ROTULO_FAMILIA = { hospedagem: 'Hospedagem', container: 'Container', vps: 'Cloud / VPS' } as const
const familias = [...new Set(abas.map((a) => a.familia))]
const comProdutos = familias.length > 1
const abasDaFamilia = (f: AbaPlanos['familia']) => abas.filter((a) => a.familia === f)

/** Localização de cada aba de hospedagem: o dropdown só aparece onde a família tem mais de uma aba.
 *  Cidade só onde a TurboCloud informa (Brasil = Ascenty, São Paulo); EUA e Europa ficam sem cidade. */
const LOCAIS: Record<string, { pais: 'br' | 'us' | 'eu'; nome: string; sub: string }> = {
  hospedagem: { pais: 'br', nome: 'Brasil', sub: 'São Paulo' },
  'hospedagem-eua': { pais: 'us', nome: 'Estados Unidos', sub: 'Servidores nos EUA' },
  'hospedagem-europa': { pais: 'eu', nome: 'Europa', sub: 'Servidores na Europa' },
}
const localDe = (aba: AbaPlanos) => LOCAIS[aba.id] ?? { pais: 'br' as const, nome: aba.label, sub: '' }

/** Há ciclo anual onde ALGUM plano da aba tem preço anual: Brasil (todos) e
 *  EUA/Europa (só alguns — os demais cards mandam consultar a equipe).
 *  Container e VPS não têm — o interruptor some nelas. */
const temAnual = (aba: AbaPlanos) => aba.planos.some((p) => p.precoAnualMes != null)
const algumAnual = abas.some(temAnual)
/** Maior desconto anual da aba, calculado dos preços reais (alimenta o chip "até X% off"). */
const descontoMax = (aba: AbaPlanos) =>
  Math.max(
    0,
    ...aba.planos.map((p) =>
      p.precoAnualTotal ? Math.round((1 - p.precoAnualTotal / (p.precoMensal * 12)) * 100) : 0,
    ),
  )
const comToolbar = comProdutos || algumAnual || abas.length > 1

/** 4 cards cabem em 4 colunas; 5, 6 e 9 (revendas) ficam em 3, sem órfão de linha. */
const colunas = (aba: AbaPlanos) => (aba.planos.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3')
const iconePlano = (aba: AbaPlanos, j: number) =>
  aba.familia === 'hospedagem' ? (ICONES_PLANOS[j] ?? 'grupo') : 'servidor'
const seloHtml = selo ? selo.replace(/^(.*?\.)\s*(.*)$/, '$1 <strong class="font-bold">$2</strong>') : ''
---

<section class={cls} id={id}>
  <div class="container-page">
    <div class="reveal mx-auto max-w-[760px] text-center">
      {
        selo && (
          <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-center text-[13px] text-ink shadow-soft sm:text-[14px]">
            <svg viewBox="0 0 24 24" class="size-4 text-green-deep" fill="currentColor" aria-hidden="true">
              <path d="M12 21s-7.5-4.6-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2 4.4-9.5 9-9.5 9Z" />
            </svg>
            <span set:html={seloHtml} />
          </p>
        )
      }
      <h2
        class:list={[
          'text-[clamp(1.9rem,4.2vw,2.6rem)] leading-[1.1] font-bold tracking-[-0.018em] text-ink',
          selo && 'mt-5',
        ]}
      >
        {titulo1}<br />{titulo2a}{' '}<span class="text-green-ink">{titulo2b}</span>
      </h2>
      <p class="mx-auto mt-4 max-w-[64ch] text-[16px] leading-relaxed text-ink-soft">
        {texto}
      </p>
    </div>

    {comToolbar && (
    <div class="reveal relative z-20 mt-9 flex flex-col items-center gap-4" data-planos>
      {
        comProdutos && (
          <div
            class="grid w-full max-w-[460px] grid-flow-col auto-cols-fr gap-1 rounded-[18px] bg-[#efedf2] p-1"
            role="tablist"
            aria-label="Produto"
          >
            {familias.map((f, i) => (
              <button
                type="button"
                role="tab"
                data-familia-btn={f}
                aria-selected={i === 0 ? 'true' : 'false'}
                class="min-h-[48px] rounded-[14px] px-2 py-2 text-center text-[13.5px] leading-tight font-semibold text-ink-soft transition-colors hover:text-ink aria-selected:bg-white aria-selected:font-bold aria-selected:text-ink aria-selected:shadow-soft sm:text-[15px]"
              >
                {ROTULO_FAMILIA[f]}
              </button>
            ))}
          </div>
        )
      }

      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {/* Localização: dropdown, só para produto com mais de uma aba (Hospedagem). */}
        {
          familias
            .filter((f) => abasDaFamilia(f).length > 1)
            .map((f) => {
              const doProduto = abasDaFamilia(f)
              const primeira = localDe(doProduto[0]!)
              return (
                <div class="relative" data-local-wrap data-familia={f} hidden={f !== abas[0]!.familia}>
                  <button
                    type="button"
                    data-local-botao
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-label="Localização do servidor"
                    class="group inline-flex min-h-[44px] items-center gap-2 rounded-full border border-line bg-surface py-1.5 pr-3 pl-2.5 text-[14px] font-bold text-ink shadow-soft transition-colors hover:border-purple-logo/40"
                  >
                    <span data-local-flag class="grid">
                      <Bandeira pais={primeira.pais} />
                    </span>
                    <span data-local-nome>{primeira.nome}</span>
                    <svg
                      viewBox="0 0 20 20"
                      class="size-4 text-ink-soft transition-transform duration-200 group-aria-expanded:rotate-180"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      data-local-seta
                    >
                      <path d="m5 7.5 5 5 5-5" />
                    </svg>
                  </button>
                  <ul
                    role="listbox"
                    data-local-menu
                    aria-label="Localização do servidor"
                    hidden
                    class="menu-local absolute top-full left-1/2 z-30 mt-2 w-[min(300px,calc(100vw-2.5rem))] -translate-x-1/2 rounded-[18px] border border-line bg-surface p-1.5 shadow-lift"
                  >
                    {doProduto.map((aba, k) => {
                      const l = localDe(aba)
                      return (
                        <li
                          role="option"
                          tabindex="-1"
                          data-local-opcao={aba.id}
                          aria-selected={k === 0 ? 'true' : 'false'}
                          class="group flex cursor-pointer items-center gap-3 rounded-[13px] px-3 py-2.5 text-left outline-none transition-colors hover:bg-purple-logo/5 focus-visible:ring-2 focus-visible:ring-purple-logo/50 aria-selected:bg-purple-logo/10"
                        >
                          <span data-local-flag class="grid">
                            <Bandeira pais={l.pais} class="size-6" />
                          </span>
                          <span class="min-w-0 flex-1 leading-tight">
                            <span data-local-nome class="block text-[14.5px] font-bold text-ink group-aria-selected:text-purple-logo">
                              {l.nome}
                            </span>
                            <span class="mt-0.5 block text-[12.5px] text-ink-soft">{l.sub}</span>
                          </span>
                          <svg
                            viewBox="0 0 20 20"
                            class="size-4 shrink-0 text-purple-logo opacity-0 group-aria-selected:opacity-100"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="m4.5 10.5 3.5 3.5 7.5-8" />
                          </svg>
                        </li>
                      )
                    })}
                  </ul>
                </div>
              )
            })
        }

        {/* Ciclo: interruptor Mensal/Anual. Só existe onde há preço anual de verdade;
            o script o esconde ao trocar para uma aba sem anual (Container, VPS). */}
        {algumAnual && (
        <div
          class="flex items-center gap-3"
          role="group"
          aria-label="Ciclo de cobrança"
          data-ciclo-grupo
          hidden={!temAnual(abas[0]!)}
        >
          <button type="button" data-ciclo-rotulo="mensal" class="min-h-[44px] text-[15px] font-semibold text-ink-soft transition-colors aria-[current=true]:font-bold aria-[current=true]:text-ink" aria-current="true">Mensal</button>
          <button
            type="button"
            role="switch"
            aria-checked="false"
            aria-label="Cobrança anual"
            data-ciclo-switch
            class="group relative inline-flex h-[28px] w-[50px] shrink-0 items-center rounded-full bg-[#cfc9d6] p-[3px] transition-colors aria-checked:bg-purple-logo"
          >
            <span class="block size-[22px] rounded-full bg-white shadow-[0_1px_3px_rgb(0_0_0/0.3)] transition-transform duration-200 group-aria-checked:translate-x-[22px]"></span>
          </button>
          <button type="button" data-ciclo-rotulo="anual" class="min-h-[44px] text-[15px] font-semibold text-ink-soft transition-colors aria-[current=true]:font-bold aria-[current=true]:text-ink">Anual</button>
          <span
            data-ciclo-chip
            class="rounded-full bg-green/20 px-2.5 py-1 text-[12px] font-bold whitespace-nowrap text-green-deep"
            hidden={descontoMax(abas[0]!) <= 0}>até {descontoMax(abas[0]!)}% off</span
          >
        </div>
        )}
      </div>
    </div>
    )}

    {
      abas.map((aba, i) => (
        <div id={`planos-${aba.id}`} data-painel-plano={aba.id} data-familia={aba.familia} data-tem-anual={temAnual(aba) ? '' : undefined} data-desconto-max={descontoMax(aba)} hidden={i !== 0}>
          {aba.nota && (
            <p class="mt-6 flex items-start gap-2 rounded-[14px] border border-line bg-surface px-4 py-3 text-[13.5px] leading-snug text-ink-soft">
              <span aria-hidden="true" class="text-green-deep">
                ⚠
              </span>
              {aba.nota}
            </p>
          )}
          {/* pt/pb generosos: o overflow-x do carrossel também corta na vertical,
              e o card em destaque tem brilho e sombra que passam da borda.
              No desktop não há scroll, então o overflow volta a ser visível. */}
          <div class:list={['reveal plans-grid mt-6 -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pt-5 pb-10 lg:mx-0 lg:grid lg:overflow-visible lg:px-0 lg:pt-4 lg:pb-4', colunas(aba)]}>
            {aba.planos.map((plano, j) => (
              <div
                class:list={[
                  'w-[85vw] max-w-[330px] shrink-0 snap-start lg:w-auto lg:max-w-none',
                  plano.destaque === true && 'plan-glow',
                ]}
              >
                <PricingCard plano={plano} icone={iconePlano(aba, j)} cicloAnual={temAnual(aba)} />
              </div>
            ))}
          </div>
          {/* Garantias da família da aba: VPS não tem backup nem SSL em todos os planos */}
          <ul
            class:list={[
              'mt-8 grid gap-4 rounded-card border border-line bg-surface px-5 py-5 shadow-soft sm:grid-cols-2 lg:gap-0 lg:divide-x lg:divide-line lg:px-2',
              { 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4' }[garantiasDaAba(aba).length] ?? 'lg:grid-cols-5',
            ]}
          >
            {garantiasDaAba(aba).map((g) => (
              <li class="flex items-center gap-3 lg:px-5">
                <svg
                  viewBox="0 0 24 24"
                  class="size-7 shrink-0 text-green-ink"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={ICONES_GARANTIAS[g.icone]} />
                </svg>
                <span class="text-[13px] leading-snug text-ink">
                  <span class="block font-bold">{g.linha1}</span>
                  <span class="block text-ink-soft">{g.linha2}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <p class="mx-auto mt-6 max-w-[80ch] text-center text-[13px] leading-relaxed text-ink-soft">
      {notaPlanos}
    </p>
  </div>
</section>

<script>
  const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches

  // Planos (desktop com mouse): o card inclina na direção do ponteiro e o brilho o acompanha
  if (!reduzido && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.plan-card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect()
        const x = (e.clientX - r.left) / r.width
        const y = (e.clientY - r.top) / r.height
        card.style.setProperty('--ry', `${((x - 0.5) * 10).toFixed(2)}deg`)
        card.style.setProperty('--rx', `${((0.5 - y) * 8).toFixed(2)}deg`)
        card.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`)
        card.style.setProperty('--my', `${(y * 100).toFixed(1)}%`)
      })
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg')
        card.style.setProperty('--ry', '0deg')
      })
    })
  }

  // Celular: "Ver tudo que inclui" abre os grupos extras do card de plano
  document.querySelectorAll<HTMLButtonElement>('[data-toggle-recursos]').forEach((botao) => {
    botao.addEventListener('click', () => {
      const card = botao.closest('article')
      const aberto = botao.getAttribute('aria-expanded') === 'true'
      botao.setAttribute('aria-expanded', String(!aberto))
      card?.querySelectorAll<HTMLElement>('[data-recursos-extra]').forEach((g) => g.classList.toggle('hidden', aberto))
      const fechado = botao.querySelector<HTMLElement>('[data-label-fechado]')
      const abertoEl = botao.querySelector<HTMLElement>('[data-label-aberto]')
      if (fechado) fechado.hidden = !aberto
      if (abertoEl) abertoEl.hidden = aberto
      const seta = botao.querySelector<HTMLElement>('[aria-hidden]')
      if (seta) seta.style.transform = aberto ? '' : 'rotate(180deg)'
    })
  })

  // Produto (segmented), localização (dropdown) e ciclo de cobrança (interruptor)
  const barra = document.querySelector<HTMLElement>('[data-planos]')
  const paineis = [...document.querySelectorAll<HTMLElement>('[data-painel-plano]')]

  if (barra && paineis.length) {
    const botoesFamilia = [...barra.querySelectorAll<HTMLButtonElement>('[data-familia-btn]')]
    const dropdowns = [...barra.querySelectorAll<HTMLElement>('[data-local-wrap]')]
    const grupoCiclo = barra.querySelector<HTMLElement>('[data-ciclo-grupo]')
    const chave = barra.querySelector<HTMLButtonElement>('[data-ciclo-switch]')
    const rotulos = [...barra.querySelectorAll<HTMLButtonElement>('[data-ciclo-rotulo]')]
    const chip = barra.querySelector<HTMLElement>('[data-ciclo-chip]')

    let familia = paineis[0]!.dataset.familia!
    let anual = false
    // Última localização escolhida em cada produto (a primeira aba dele por padrão)
    const localDaFamilia: Record<string, string> = {}
    paineis.forEach((p) => {
      if (!(p.dataset.familia! in localDaFamilia)) localDaFamilia[p.dataset.familia!] = p.dataset.painelPlano!
    })

    const aplicarCiclo = () => {
      chave?.setAttribute('aria-checked', String(anual))
      rotulos.forEach((r) => r.setAttribute('aria-current', String((r.dataset.cicloRotulo === 'anual') === anual)))
      document.querySelectorAll<HTMLElement>('[data-ciclo-mensal]').forEach((el) => (el.hidden = anual))
      document.querySelectorAll<HTMLElement>('[data-ciclo-anual]').forEach((el) => (el.hidden = !anual))
    }

    const mostrar = (animar: boolean) => {
      const id = localDaFamilia[familia]
      botoesFamilia.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.familiaBtn === familia)))

      dropdowns.forEach((dd) => {
        dd.hidden = dd.dataset.familia !== familia
        const opcoes = [...dd.querySelectorAll<HTMLElement>('[data-local-opcao]')]
        opcoes.forEach((o) => o.setAttribute('aria-selected', String(o.dataset.localOpcao === id)))
        const atual = opcoes.find((o) => o.dataset.localOpcao === id)
        const botao = dd.querySelector<HTMLElement>('[data-local-botao]')
        if (atual && botao) {
          botao.querySelector('[data-local-flag]')!.innerHTML = atual.querySelector('[data-local-flag]')!.innerHTML
          botao.querySelector('[data-local-nome]')!.textContent = atual.querySelector('[data-local-nome]')!.textContent
        }
      })

      const painelAtual = paineis.find((p) => p.dataset.painelPlano === id)
      // Aba sem preço anual (Container, VPS): some o interruptor e volta ao mensal
      const anualDisponivel = painelAtual?.hasAttribute('data-tem-anual') ?? false
      if (grupoCiclo) grupoCiclo.hidden = !anualDisponivel
      if (!anualDisponivel) {
        anual = false
        aplicarCiclo()
      }
      if (chip) {
        const max = Number(painelAtual?.dataset.descontoMax ?? 0)
        chip.hidden = max <= 0
        if (max > 0) chip.textContent = `até ${max}% off`
      }

      paineis.forEach((p) => {
        p.hidden = p.dataset.painelPlano !== id
        if (!p.hidden && animar) {
          const grade = p.querySelector<HTMLElement>('.plans-grid')
          if (grade) {
            grade.classList.remove('is-in')
            void grade.offsetWidth
            grade.classList.add('is-in')
          }
        }
      })
    }

    // --- Localização (dropdown acessível: listbox/option, teclado, Esc e clique fora)
    const fechar = (dd: HTMLElement, voltarFoco = false) => {
      const menu = dd.querySelector<HTMLElement>('[data-local-menu]')!
      const botao = dd.querySelector<HTMLElement>('[data-local-botao]')!
      menu.hidden = true
      botao.setAttribute('aria-expanded', 'false')
      if (voltarFoco) botao.focus()
    }
    const fecharTodos = () => dropdowns.forEach((dd) => fechar(dd))

    // --- Produto
    botoesFamilia.forEach((botao, i) => {
      botao.addEventListener('click', () => {
        fecharTodos()
        familia = botao.dataset.familiaBtn!
        mostrar(true)
      })
      botao.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return
        e.preventDefault()
        const prox = botoesFamilia[(i + (e.key === 'ArrowRight' ? 1 : -1) + botoesFamilia.length) % botoesFamilia.length]!
        prox.focus()
        prox.click()
      })
    })

    dropdowns.forEach((dd) => {
      const botao = dd.querySelector<HTMLButtonElement>('[data-local-botao]')!
      const menu = dd.querySelector<HTMLElement>('[data-local-menu]')!
      const opcoes = [...menu.querySelectorAll<HTMLElement>('[data-local-opcao]')]

      const abrir = () => {
        menu.hidden = false
        botao.setAttribute('aria-expanded', 'true')
        const sel = opcoes.find((o) => o.getAttribute('aria-selected') === 'true') ?? opcoes[0]
        sel?.focus()
      }
      const escolher = (o: HTMLElement) => {
        localDaFamilia[dd.dataset.familia!] = o.dataset.localOpcao!
        fechar(dd, true)
        mostrar(true)
      }

      botao.addEventListener('click', () => (menu.hidden ? abrir() : fechar(dd)))
      botao.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault()
          if (menu.hidden) abrir()
        }
      })
      opcoes.forEach((o, i) => {
        o.addEventListener('click', () => escolher(o))
        o.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown') opcoes[(i + 1) % opcoes.length]!.focus()
          else if (e.key === 'ArrowUp') opcoes[(i - 1 + opcoes.length) % opcoes.length]!.focus()
          else if (e.key === 'Home') opcoes[0]!.focus()
          else if (e.key === 'End') opcoes[opcoes.length - 1]!.focus()
          else if (e.key === 'Enter' || e.key === ' ') escolher(o)
          else if (e.key === 'Escape') fechar(dd, true)
          else if (e.key === 'Tab') fechar(dd)
          else return
          e.preventDefault()
        })
      })
    })
    document.addEventListener('pointerdown', (e) => {
      dropdowns.forEach((dd) => {
        if (!dd.contains(e.target as Node)) fechar(dd)
      })
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') fecharTodos()
    })

    // --- Ciclo
    chave?.addEventListener('click', () => {
      anual = !anual
      aplicarCiclo()
    })
    rotulos.forEach((r) =>
      r.addEventListener('click', () => {
        anual = r.dataset.cicloRotulo === 'anual'
        aplicarCiclo()
      }),
    )

    // Link com âncora #planos-<id> (ex.: #planos-container, #planos-hospedagem-eua) abre essa aba
    const doHash = paineis.find((p) => `#planos-${p.dataset.painelPlano}` === location.hash)
    if (doHash) {
      familia = doHash.dataset.familia!
      localDaFamilia[familia] = doHash.dataset.painelPlano!
      mostrar(false)
    }
  }
</script>

