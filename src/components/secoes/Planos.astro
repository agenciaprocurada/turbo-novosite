  @media (prefers-reduced-motion: no-preference) {
    .menu-local:not([hidden]) {
      animation: menu-local-in 0.16s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes menu-local-in {
      from {
        opacity: 0;
        scale: 0.97;
      }
      to {
        opacity: 1;
        scale: 1;
      }
    }
  }
</style>
