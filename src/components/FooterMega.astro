---
import Logo from './Logo.astro'
import { marca, links, footer, provas, atendimento } from '../data/site'

const ano = new Date().getFullYear()
---

<footer class="border-t border-line bg-bg pt-14 pb-[max(2.5rem,env(safe-area-inset-bottom))]">
  <div class="container-page">
    <div class="grid grid-cols-2 gap-x-6 gap-y-9 max-lg:text-center lg:grid-cols-[1.5fr_1fr_1fr_1fr] lg:text-left">
      <div class="col-span-2 lg:col-span-1">
        <Logo height={26} class="mx-auto text-purple-logo lg:mx-0" />
        <p class="mx-auto mt-4 max-w-[30ch] text-[14.5px] leading-relaxed text-ink-soft lg:mx-0">
          Hospedagem de alta performance com servidores no Brasil. Desde {marca.desde}.
        </p>

        {/* Nasce neutro: só afirma que está tudo operacional depois de confirmar
            na status page. Se o fetch não acontecer, fica neste estado. */}
        <a
          href={links.status}
          rel="noopener"
          data-status-pill
          data-status-url={links.statusApi}
          class="mt-4 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 font-mono text-[11.5px] text-ink-soft transition-colors hover:border-ink/20 hover:text-ink"
          style="--pulse-color: var(--color-ink-soft)"
        >
          <span class="pulse-dot" data-pulse="off" aria-hidden="true"></span>
          <span data-status-texto>status dos serviços</span>
        </a>

        <dl class="mt-5 flex flex-col items-center gap-1 text-[14px] lg:items-start">
          <div class="flex gap-2">
            <dt class="sr-only">E-mail</dt>
            <dd>
              <a href={`mailto:${marca.email}`} class="inline-block rounded-full border border-line bg-surface px-3.5 py-1.5 text-ink-soft transition-colors hover:border-ink/20 hover:text-ink lg:border-0 lg:bg-transparent lg:px-0"
                >{marca.email}</a
              >
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="sr-only">Telefone</dt>
            <dd>
              <a href={links.whatsapp} rel="noopener" class="inline-block rounded-full border border-line bg-surface px-3.5 py-1.5 text-ink-soft transition-colors hover:border-ink/20 hover:text-ink lg:border-0 lg:bg-transparent lg:px-0"
                >{marca.telefone}</a
              >
            </dd>
          </div>
        </dl>
        <p class="mt-2 font-mono text-[11.5px] text-ink-soft">{atendimento.resumo}</p>
      </div>

      {
        footer.colunas.map((coluna) => (
          <nav aria-label={coluna.titulo}>
            <h2 class="border-b border-line pb-2 text-[13px] font-bold tracking-[0.02em] text-ink lg:border-0 lg:pb-0 lg:text-[14px]">
              {coluna.titulo}
            </h2>
            <ul class="mt-3 flex flex-col gap-0.5">
              {coluna.itens.map((item) => (
                <li>
                  <a
                    href={item.href}
                    rel="noopener"
                    class="block py-1.5 text-[14px] text-ink-soft transition-colors hover:text-ink"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- Selos de reputação -->
    <div class="mt-12 grid gap-3 border-t border-line pt-8 sm:grid-cols-3">
      <div class="flex items-center justify-center gap-3 rounded-card border border-line bg-surface px-4 py-3 sm:justify-start">
        <span class="text-[15px] tracking-[0.08em] text-star" aria-hidden="true">★★★★★</span>
        <span>
          <span class="block text-[14px] font-medium text-ink"
            >{provas.notaGoogle} no Google</span
          >
          <span class="block font-mono text-[11.5px] text-ink-soft"
            >{provas.avaliacoesGoogle.toLocaleString('pt-BR')} avaliações · Trustindex</span
          >
        </span>
      </div>
      <div class="flex items-center justify-center gap-3 rounded-card border border-line bg-surface px-4 py-3 sm:justify-start">
        <span class="font-mono text-[13px] text-green-deep">TIER III</span>
        <span class="block font-mono text-[11.5px] text-ink-soft">datacenter certificado</span>
      </div>
      <div class="flex items-center justify-center gap-3 rounded-card border border-line bg-surface px-4 py-3 sm:justify-start">
        <span class="font-mono text-[13px] text-green-deep">{provas.anosDeCasa} anos</span>
        <span class="block font-mono text-[11.5px] text-ink-soft">de mercado</span>
      </div>
    </div>

    <!-- Versículo — marca da casa, mantido -->
    <p class="mt-10 text-center text-[14px] text-ink-soft italic">
      “{marca.versiculo.texto}” — <span class="not-italic">{marca.versiculo.referencia}</span>
    </p>

    <p class="mt-8 border-t border-line pt-6 text-center text-[12.5px] leading-relaxed text-ink-soft">
      © Turbo Cloud {ano}. Todos os direitos reservados. CNPJ {marca.cnpj} · {marca.endereco}
    </p>
  </div>
</footer>

<script>
  /* Status real dos serviços, lido da status page (Better Stack).
     Só dispara depois da primeira interação do visitante — o JSON tem ~18 KB
     gzip e não pode competir com o carregamento da página. Se nada acontecer,
     a pílula fica no estado neutro que veio no HTML. */
  const pilula = document.querySelector<HTMLElement>('[data-status-pill]')

  if (pilula) {
    const texto = pilula.querySelector<HTMLElement>('[data-status-texto]')
    const ponto = pilula.querySelector<HTMLElement>('.pulse-dot')
    const url = pilula.dataset.statusUrl

    const estados: Record<string, { texto: string; cor: string }> = {
      operational: { texto: 'todos os sistemas operacionais', cor: 'var(--color-green)' },
      maintenance: { texto: 'manutenção programada', cor: 'var(--color-purple-800)' },
    }
    const instabilidade = {
      texto: 'instabilidade em alguns sistemas',
      cor: 'var(--color-amber-deep)',
    }

    const carregar = async () => {
      if (!url || !texto || !ponto) return
      try {
        const resposta = await fetch(url)
        if (!resposta.ok) return
        const dados = await resposta.json()
        const estado = dados?.data?.attributes?.aggregate_state
        if (typeof estado !== 'string') return

        const conhecido = estados[estado]
        const { texto: rotulo, cor } = conhecido ?? instabilidade
        texto.textContent = rotulo
        pilula.style.setProperty('--pulse-color', cor)
        ponto.removeAttribute('data-pulse')
        // Só instabilidade tinge o texto. Manutenção programada é aviso, não alarme.
        if (!conhecido) pilula.dataset.estado = 'alerta'
      } catch {
        /* Sem rede, bloqueador ou endpoint mudou: fica no estado neutro. */
      }
    }

    const eventos = ['pointerdown', 'keydown', 'scroll', 'touchstart'] as const
    const disparar = () => {
      eventos.forEach((evento) => window.removeEventListener(evento, disparar))
      carregar()
    }
    eventos.forEach((evento) =>
      window.addEventListener(evento, disparar, { once: true, passive: true })
    )
  }
</script>
