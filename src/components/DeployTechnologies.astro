---
import { turboDeploy as td } from '../data/turbodeploy'
import logo0 from '../assets/tecnologias/nextjs.svg?url'
import logo1 from '../assets/tecnologias/astro.svg?url'
import logo2 from '../assets/tecnologias/react.svg?url'
import logo3 from '../assets/tecnologias/nodejs.svg?url'
import logo4 from '../assets/tecnologias/express.svg?url'
import logo5 from '../assets/tecnologias/nestjs.svg?url'
import logo6 from '../assets/tecnologias/laravel.svg?url'
import logo7 from '../assets/tecnologias/python.svg?url'
import logo8 from '../assets/tecnologias/go.svg?url'
import logo9 from '../assets/tecnologias/rust.svg?url'
import logo10 from '../assets/tecnologias/dotnetcore.svg?url'
import logo11 from '../assets/tecnologias/docker.svg?url'
const logos = [logo0, logo1, logo2, logo3, logo4, logo5, logo6, logo7, logo8, logo9, logo10, logo11]
const groups = [td.tecnologias.frameworks.slice(0, 6), td.tecnologias.frameworks.slice(6)]
const routes = [0, 1].flatMap(row => Array.from({ length: 6 }, (_, i) => {
  const x = 50 + i * 100
  const y = row ? 290 : 70
  return { d: 'M' + x + ' ' + y + ' C' + x + ' 180 300 ' + y + ' 300 180', delay: (row * 6 + i) * -1.5 }
}))
---
<div class="deploy-technologies">
  <svg class="tech-connections" viewBox="0 0 600 360" preserveAspectRatio="none" aria-hidden="true">
    {routes.map(r => <path class="tech-route" d={r.d} />)}
    {routes.map(r => <circle class="tech-signal" r="3" style={{ 'offset-path': "path('" + r.d + "')", 'animation-delay': r.delay + 's' }} />)}
  </svg>
  {groups.map((group, row) => <>
    <ul class="tech-grid" aria-label={row ? td.tecnologias.grupoBackend : td.tecnologias.grupoFrontend}>
      {group.map((label, i) => <li class="tech-card" style={{ '--delay': (row * 6 + i) * -1.5 + 's' }}>
        <img src={logos[row * 6 + i]} alt="" width="32" height="32" loading="lazy" decoding="async" />
        <span>{label}</span>
        <span class="tech-check" aria-hidden="true">✓</span>
      </li>)}
    </ul>
    {row === 0 && <div class="tech-hub">
      <span class="tech-hub-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15c-1.5 1.5-2 4-2 6 2 0 4.5-.5 6-2M14 4c2-1.5 5-2 7-1 1 2 .5 5-1 7l-6 6-6-6 6-6Zm-4 8 2 2M15 8a1 1 0 1 0 0 .01" /></svg></span>
      <div><strong>{td.tecnologias.hub}</strong><p><span aria-hidden="true"></span>{td.tecnologias.hubStatus}</p></div>
    </div>}
  </>)}
</div>
<style>
  .deploy-technologies { position: relative; isolation: isolate; padding: 12px 4px; background: radial-gradient(ellipse at center, #5c1f850b, transparent 68%); }
  .tech-connections { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; overflow: visible; }
  .tech-route { fill: none; stroke: #5c1f8525; stroke-width: 1.2; }
  .tech-signal { fill: var(--color-purple-logo); animation: tech-flow 4.5s linear infinite; }
  .tech-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  .tech-card { position: relative; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 10px; min-height: 100px; padding: 14px 5px; border: 1px solid var(--color-line); border-radius: 16px; background: var(--color-surface); box-shadow: 0 5px 15px #300c5106; animation: tech-highlight 18s ease-in-out infinite; animation-delay: var(--delay); }
  .tech-card img { width: 32px; height: 32px; object-fit: contain; }
  .tech-card > span:not(.tech-check) { font: 10px/1.4 var(--font-mono); text-align: center; color: var(--color-ink); }
  .tech-check { position: absolute; top: -5px; right: -3px; display: grid; place-items: center; width: 17px; height: 17px; border-radius: 50%; background: #e9f6df; border: 2px solid var(--color-bg); color: var(--color-green-deep); font-size: 10px; }
  .tech-hub { display: flex; width: fit-content; align-items: center; gap: 12px; margin: 42px auto; padding: 17px 22px; border-radius: 20px; background: var(--color-purple-950); color: white; box-shadow: 0 0 0 7px #5c1f8508, 0 10px 28px #300c5118; }
  .tech-hub-icon { display: grid; place-items: center; width: 42px; height: 42px; background: #ffffff0c; border: 1px solid #ffffff18; border-radius: 12px; color: var(--color-green); }
  .tech-hub-icon svg { width: 27px; height: 27px; }
  .tech-hub strong { font-size: 19px; font-weight: 800; }
  .tech-hub p { display: flex; align-items: center; gap: 6px; font-size: 11px; margin-top: 3px; color: #ddcee9; }
  .tech-hub p span { width: 5px; height: 5px; border-radius: 50%; background: var(--color-green); }
  @keyframes tech-flow { 0% { offset-distance: 0%; opacity: 0; } 20%, 80% { opacity: .7; } 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes tech-highlight { 0%, 16%, 100% { border-color: var(--color-line); transform: translateY(0); } 5%, 11% { border-color: #5c1f8570; transform: translateY(-3px); box-shadow: 0 6px 20px #5c1f8515; } }
  @media(max-width:600px) {
    .tech-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .tech-card { min-height: 90px; }
    .tech-card > span:not(.tech-check) { font-size: 11px; }
    .tech-hub { margin: 28px auto; }
    .tech-connections { display: none; }
    .deploy-technologies::before { content: ''; position: absolute; z-index: -1; inset: 20px 50%; width: 1px; border-left: 2px dashed #5c1f8530; }
  }
  @media(prefers-reduced-motion:reduce) { .tech-card, .tech-signal { animation: none; } .tech-signal { display: none; } }
</style>
