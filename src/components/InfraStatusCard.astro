---
/**
 * Card de status da infraestrutura (S5): quatro linhas com ícone, rótulo e
 * valor. Vidro sobre o bloco roxo. Só número real de `provas`.
 */
import { infraCard } from '../data/site'

const icones = {
  pin: 'M12 21s-6-5.3-6-10a6 6 0 0 1 12 0c0 4.7-6 10-6 10Zm0-8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
  uptime: 'M3 12h4l2-6 4 12 2-6h6',
  latencia: 'M12 21a9 9 0 1 0-9-9M12 7v5l3 2M3 4v4h4',
  escudo: 'M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3Zm-3 9 2 2 4-4',
} as const
---

<div
  class="rounded-card border border-white/60 bg-white/72 p-2 text-ink shadow-lift backdrop-blur-xl backdrop-saturate-150"
  aria-label="Status da infraestrutura"
>
  <ul class="stagger divide-y divide-line">
    {
      infraCard.map((linha) => (
        <li class="flex items-center gap-3.5 px-3 py-3.5">
          <span
            class="grid size-10 shrink-0 place-items-center rounded-[12px] bg-purple-950/6 text-green-deep"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={icones[linha.icone]} />
            </svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-mono text-[11px] tracking-[0.1em] text-ink-soft uppercase">
              {linha.label}
            </span>
            <span class="mt-0.5 block text-[15px] font-bold text-ink">{linha.valor}</span>
          </span>
          {'status' in linha && linha.status && <span class="pulse-dot mr-1" aria-hidden="true" />}
        </li>
      ))
    }
  </ul>
</div>
