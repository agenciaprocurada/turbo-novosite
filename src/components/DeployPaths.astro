---
import { turboDeploy as td } from '../data/turbodeploy'
import DeployTerminalPanel from './mockups/DeployTerminalPanel.astro'
const paths = td.caminhos.itens
---

<div class="deploy-paths" data-deploy-paths>
  <div class="path-tabs" aria-label="Formas de publicar">
    {paths.map((path, i) => <button type="button" id={`path-tab-${i}`} aria-controls={`path-panel-${i}`} data-path-tab={i}><span aria-hidden="true">0{i + 1}</span>{path.titulo}<span class="tab-arrow" aria-hidden="true">↗</span></button>)}
  </div>
  {paths.map((path, i) => (
    <div id={`path-panel-${i}`} class="path-panel" data-path-panel={i} aria-labelledby={`path-tab-${i}`}>
      <div class="path-copy">
        <span class="path-number" aria-hidden="true">0{i + 1} / 03</span>
        <h3>{path.titulo}</h3>
        <p class="path-lead">{path.resumo}</p>
        <ul>{path.pontos.map(point => <li><span aria-hidden="true">✓</span>{point}</li>)}</ul>
        <p class="path-requirement">{path.requisito}</p>
      </div>
      <div class="path-visual">
        {i === 1 ? <DeployTerminalPanel /> : (
          <div class="flow-preview">
            <div class="preview-bar"><span aria-hidden="true">● ● ●</span><span>{td.demo.projeto} / {path.titulo}</span></div>
            <div class="flow-source"><span aria-hidden="true">{i === 0 ? '⑂' : '✦'}</span><strong>{path.titulo}</strong><p>{i === 0 ? td.demo.origem : path.pontos[1]}</p></div>
            <div class="flow-connector" aria-hidden="true">↓</div>
            <div class="flow-deploy"><span aria-hidden="true">✓</span><strong>{td.demo.etapas[3].rotulo}</strong><p>{td.demo.etapas[3].detalhe}</p></div>
            <div class="flow-address"><span aria-hidden="true">●</span>{td.demo.dominio}</div>
            <p class="preview-caption">{td.demo.legenda}</p>
          </div>
        )}
      </div>
    </div>
  ))}
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-deploy-paths]')!
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-path-tab]'))
  const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-path-panel]'))
  root.querySelector('.path-tabs')!.setAttribute('role', 'tablist')
  const activate = (index: number, focus = false) => {
    tabs.forEach((tab, i) => {
      tab.setAttribute('role', 'tab')
      tab.setAttribute('aria-selected', String(i === index))
      tab.tabIndex = i === index ? 0 : -1
      panels[i]!.setAttribute('role', 'tabpanel')
      panels[i]!.tabIndex = 0
      panels[i]!.hidden = i !== index
    })
    if (focus) tabs[index]!.focus()
  }
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(i))
    tab.addEventListener('keydown', (event) => {
      const next = event.key === 'ArrowRight' ? (i + 1) % tabs.length : event.key === 'ArrowLeft' ? (i + tabs.length - 1) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1
      if (next >= 0) { event.preventDefault(); activate(next, true) }
    })
  })
  activate(0)
</script>

<style>
  .deploy-paths { margin-top: 36px; border: 1px solid #ffffff30; border-radius: var(--radius-card); background: #ffffff06; overflow: hidden; }
  .path-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding: 10px; border-bottom: 1px solid #ffffff20; }
  .path-tabs button { display: flex; align-items: center; justify-content: flex-start; gap: 12px; min-height: 54px; padding: 12px 18px; border-radius: var(--radius-btn); text-align: left; font-size: 15px; font-weight: 700; color: #e0d3eb; cursor: pointer; transition: background .2s, color .2s; }
  .path-tabs button:hover { background: #ffffff10; }
  .path-tabs button[aria-selected="true"] { background: var(--color-green); color: var(--color-purple-950); }
  .path-tabs button > span:first-child { font: 11px var(--font-mono); }
  .tab-arrow { margin-left: auto; }
  .path-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 48px; padding: 40px; }
  .path-panel[hidden] { display: none; }
  .path-number { font: 11px var(--font-mono); color: var(--color-green); }
  h3 { font-size: 29px; font-weight: 700; margin-top: 16px; }
  .path-lead { font-size: 18px; line-height: 1.6; margin-top: 16px; color: #eee4f5; max-width: 38ch; }
  ul { display: grid; gap: 14px; margin: 25px 0; font-size: 14px; }
  li { display: flex; align-items: flex-start; gap: 12px; }
  li > span { color: var(--color-green); }
  .path-requirement { border-top: 1px solid #ffffff24; padding-top: 18px; color: #d9c7e7; font-size: 12px; line-height: 1.7; }
  .path-visual { min-width: 0; }
  .flow-preview { border: 1px solid #ffffff25; border-radius: 16px; overflow: hidden; background: var(--color-purple-950); text-align: center; }
  .preview-bar { display: flex; justify-content: space-between; gap: 12px; padding: 14px 16px; border-bottom: 1px solid #ffffff20; font: 10px var(--font-mono); color: #d9c7e7; }
  .preview-bar > span:first-child { color: #9f79bc; letter-spacing: 3px; }
  .flow-source { padding: 24px 20px 0; }
  .flow-source > span { display: block; font-size: 29px; color: var(--color-green); }
  .flow-source strong { display: block; margin-top: 6px; }
  .flow-source p, .flow-deploy p { margin-top: 6px; font: 11px/1.6 var(--font-mono); color: #d9c7e7; }
  .flow-connector { margin: 12px; color: var(--color-green); }
  .flow-deploy { margin: 0 24px; padding: 16px; border: 1px solid #ffffff25; border-radius: 12px; background: #ffffff06; font-size: 13px; }
  .flow-deploy > span { margin-right: 8px; color: var(--color-green); }
  .flow-address { margin: 18px 16px; font: 12px var(--font-mono); overflow-wrap: anywhere; }
  .flow-address > span { color: var(--color-green); margin-right: 8px; }
  .preview-caption { padding: 0 20px 20px; font-size: 10px; color: #d9c7e7; }
  @media (max-width: 760px) { .path-panel { grid-template-columns: 1fr; padding: 24px; gap: 28px; } .path-tabs button { padding: 12px 8px; font-size: 12px; justify-content: center; } .path-tabs button > span { display: none; } h3 { font-size: 25px; } .path-lead { font-size: 16px; } }
  :global(.no-js) .path-tabs { display: none; }
</style>
