---
/**
 * Moldura de janela para os mockups de UI. Toda ilustração da página é
 * HTML/CSS dentro dessa moldura — nada de screenshot pesado.
 */
interface Props {
  titulo: string
  tone?: 'light' | 'dark'
  class?: string
  bodyClass?: string
}

const { titulo, tone = 'light', class: className = '', bodyClass = '' } = Astro.props
---

<div
  aria-hidden="true"
  class:list={[
    'overflow-hidden rounded-card select-none',
    tone === 'dark'
      ? 'border border-white/10 bg-purple-950 shadow-lift'
      : 'border border-line bg-surface shadow-soft',
    className,
  ]}
>
  <div
    class:list={[
      'flex items-center gap-2 border-b px-3.5 py-2.5',
      tone === 'dark' ? 'border-white/8 bg-white/4' : 'border-line bg-bg',
    ]}
  >
    <span class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-[#FF5F57]"></span>
      <span class="size-2.5 rounded-full bg-[#FEBC2E]"></span>
      <span class="size-2.5 rounded-full bg-[#28C840]"></span>
    </span>
    <span
      class:list={[
        'ml-1.5 min-w-0 truncate font-mono text-[10.5px] tracking-[0.06em] uppercase',
        tone === 'dark' ? 'text-white/45' : 'text-ink-soft',
      ]}>{titulo}</span
    >
  </div>
  <div class:list={['p-4 sm:p-5', bodyClass]}>
    <slot />
  </div>
</div>
