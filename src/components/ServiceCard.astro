---
/**
 * Card de serviço (S4): ícone em quadrado lavanda, título, resumo, três
 * itens com check e rodapé roxo com o rótulo. O card inteiro é o link.
 */
interface Props {
  icone: 'wordpress' | 'loja' | 'nuvem' | 'email'
  titulo: string
  texto: string
  itens: readonly string[]
  rodape: string
  href: string
  class?: string
}

const { icone, titulo, texto, itens, rodape, href, class: className = '' } = Astro.props
---

<a
  href={href}
  rel="noopener"
  class:list={[
    'group flex flex-col overflow-hidden rounded-card border border-line bg-surface shadow-soft transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-lift',
    className,
  ]}
>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <span
      class="grid size-12 place-items-center rounded-[14px] bg-purple-logo/8 text-purple-logo"
      aria-hidden="true"
    >
      {
        icone === 'wordpress' && (
          <svg viewBox="0 0 24 24" class="size-6" fill="currentColor">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-8.6 10c0-1.2.3-2.4.7-3.4l4 10.9A8.6 8.6 0 0 1 3.4 12Zm8.6 8.6c-.8 0-1.7-.1-2.4-.4l2.6-7.5 2.6 7.3v.1c-.9.3-1.8.5-2.8.5Zm1.2-12.6c.5 0 1-.1 1-.1.5-.1.4-.8-.1-.7 0 0-1.4.1-2.4.1-.9 0-2.3-.1-2.3-.1-.5 0-.5.7-.1.7l.9.1 1.4 3.7-1.9 5.7-3.2-9.4c.5 0 1-.1 1-.1.5-.1.4-.8-.1-.7 0 0-1.4.1-2.3.1h-.6A8.6 8.6 0 0 1 12 3.4c2.2 0 4.3.9 5.8 2.3h-.1c-.8 0-1.4.7-1.4 1.5 0 .7.4 1.3.8 2 .3.5.7 1.2.7 2.2 0 .7-.3 1.5-.6 2.6l-.8 2.7-2.9-8.7Zm3.2 11.4 2.6-7.5c.5-1.2.7-2.2.7-3v-.8A8.6 8.6 0 0 1 16.4 19.4Z" />
          </svg>
        )
      }
      {
        icone === 'loja' && (
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9.5 4.5 4h15L21 9.5" />
            <path d="M3 9.5a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" />
            <path d="M5 12v8h14v-8" />
            <path d="M10 20v-5h4v5" />
          </svg>
        )
      }
      {
        icone === 'nuvem' && (
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 18a4 4 0 0 1-.6-7.95A6 6 0 0 1 18 8.5a4.5 4.5 0 0 1-.5 9.5H7Z" />
            <path d="M12 12v6" />
            <path d="m9.5 14.5 2.5-2.5 2.5 2.5" />
          </svg>
        )
      }
      {
        icone === 'email' && (
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="3" />
            <path d="m4 8 8 5 8-5" />
          </svg>
        )
      }
    </span>

    <h3 class="mt-5 text-[16.5px] font-bold text-ink">{titulo}</h3>
    <p class="mt-2 text-[14px] leading-relaxed text-ink-soft">{texto}</p>

    <ul class="mt-5 flex flex-col gap-2.5">
      {
        itens.map((item) => (
          <li class="flex items-start gap-2.5 text-[13.5px] text-ink">
            <svg
              viewBox="0 0 16 16"
              class="mt-0.5 size-4 shrink-0 text-green-deep"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8.5 6.5 12 13 4.5" />
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <span
    class="mt-auto flex items-center justify-between bg-purple-logo px-5 py-3 text-[13px] font-semibold text-white sm:px-6"
  >
    {rodape}
    <span
      class="text-green opacity-0 transition-[opacity,transform] duration-200 group-hover:translate-x-0.5 group-hover:opacity-100"
      aria-hidden="true">→</span
    >
  </span>
</a>
