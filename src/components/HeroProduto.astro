---
/**
 * Hero das páginas internas. Segue o mesmo sistema do hero da home: fundo
 * lilás-claro (#F6F1FA), título em duas cores (ink + green-ink), chips com
 * check verde e degradê no pé fundindo com a cor da página. Nada de bloco
 * roxo aqui — o roxo é do hero da home e dos blocos de seção, não das
 * páginas internas.
 *
 * O `-mt` + `pt` repete o gesto da home: a seção passa por baixo do header
 * pílula em vez de começar depois dele.
 *
 * O fundo é a mesma nuvem em movimento do hero da home (`FundoNuvens`): 10 KB
 * de ladrilho que emenda consigo mesmo, então repetir em nove páginas não pesa
 * como repetir a arte antiga pesaria (regra 4).
 *
 * A arte em si é opcional e por página, via prop `astronauta`. A ideia é cada
 * página ter o seu, temático — e enquanto a arte de uma página não existe, ela
 * fica só com a nuvem, sem buraco no layout.
 */
import { Image } from 'astro:assets'
import Button from './Button.astro'
import Trilha from './Trilha.astro'
import SectionEyebrow from './SectionEyebrow.astro'
import FundoNuvens from './FundoNuvens.astro'
import { links } from '../data/site'

interface Props {
  eyebrow: string
  /** primeira parte do H1, em text-ink */
  titulo: string
  /** segunda parte do H1, em verde. Mesmo par do hero da home. */
  tituloVerde?: string
  lead: string
  badges?: readonly string[]
  aPartirDe?: number
  ctaPrimario?: { label: string; href: string }
  ctaSecundario?: { label: string; href: string }
  /** Arte temática da página, já tratada e recortada com fundo transparente.
   *  Entra à direita no desktop e acima do texto no celular, com o mesmo voo
   *  leve do astronauta da home. Sem ela, o hero fica só com a nuvem.
   *
   *  O tamanho vem do próprio arquivo: cada arte é gerada na maior largura em
   *  que aparece (regra 7), então não há medida escrita aqui e formatos
   *  diferentes — em pé ou deitado — convivem sem ajuste no componente. */
  astronauta?: ImageMetadata
  trilha: readonly { label: string; href: string }[]
}

const {
  eyebrow,
  titulo,
  tituloVerde,
  lead,
  badges = [],
  aPartirDe,
  ctaPrimario = { label: 'Ver planos', href: '#planos' },
  ctaSecundario = { label: 'Falar no WhatsApp', href: links.whatsapp },
  astronauta,
  trilha,
} = Astro.props

const preco = aPartirDe?.toLocaleString('pt-BR', { minimumFractionDigits: 2 })

/* Slot `visual`: um mockup HTML/CSS no lugar do card de preço, à direita no
   desktop e abaixo do texto no celular. Quem passa o visual não mostra o card. */
const temVisual = Astro.slots.has('visual')
---

<section
  class="relative overflow-clip bg-[#F6F1FA] -mt-[76px] pt-[76px] sm:-mt-[84px] sm:pt-[84px]"
>
  <FundoNuvens velocidade={60} ancora="topo-no-celular" />

  {/* Brilho verde bem de leve no canto direito — o mesmo acento da marca, sem peso de imagem */}
  <div
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(52% 62% at 88% 6%, rgba(107,221,18,.10), rgba(246,241,250,0) 72%)"
    aria-hidden="true"
  >
  </div>

  {/* Degradê no pé: a cor do hero some para a cor de fundo da página, sem linha dura */}
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[160px]"
    style="background:linear-gradient(180deg, rgba(251,251,250,0) 0%, rgba(251,251,250,.6) 50%, #FBFBFA 100%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative container-page pt-[clamp(20px,3vw,32px)] pb-[clamp(48px,7vw,88px)]">
    {
      astronauta && (
        <div class="arte-hero" aria-hidden="true">
          <Image src={astronauta} alt="" loading="eager" class="astro-voo h-auto w-full" />
        </div>
      )
    }

    <Trilha itens={trilha} tone="light" />

    <div
      class:list={[
        'mt-8 grid gap-y-8 lg:items-center lg:gap-x-12',
        temVisual ? 'lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]' : 'lg:grid-cols-[minmax(0,1fr)_auto]',
      ]}
    >
      {/* No celular a mesma arte entra no fluxo, antes do texto. São dois
          elementos apontando para o MESMO arquivo, e cada um só existe na sua
          faixa de tela, então o navegador baixa uma vez só. */}
      {
        astronauta && (
          <div class="arte-hero-fluxo lg:hidden" aria-hidden="true">
            <Image
              src={astronauta}
              alt=""
              loading="eager"
              class="astro-voo h-auto w-full"
            />
          </div>
        )
      }

      <div
        class:list={[
          'reveal stagger mx-auto max-w-[54ch] text-center lg:mx-0 lg:text-left',
          astronauta && 'lg:col-start-1 lg:row-start-1',
        ]}
      >
        <SectionEyebrow>{eyebrow}</SectionEyebrow>

        {/* O piso de 2rem deixava o H1 em quatro linhas no celular nas páginas de
            título mais longo. A rampa aqui é uma reta que passa pelos dois
            pontos que importam: 27px a 390px de tela (onde o texto respira) e os
            mesmos 35,3px de antes a 768px — daí o termo composto, em vez de só
            `vw`. Um `vw` puro grande o bastante para o celular inflava o
            tablet, porque chegaria ao teto cedo demais. */}
        <h1
          class="mt-4 text-[clamp(1.5rem,1.15rem+2.2vw,2.9rem)] leading-[1.08] font-bold tracking-[-0.024em] text-balance text-ink lg:mt-5"
        >
          <span>{titulo}</span>{tituloVerde && (
            <>
              <br />
              <span class="text-green-ink">{tituloVerde}</span>
            </>
          )}
        </h1>

        <p
          class="mx-auto mt-5 max-w-[52ch] text-[clamp(1rem,1.6vw,1.125rem)] leading-relaxed text-ink-soft lg:mx-0"
        >
          {lead}
        </p>

        {
          badges.length > 0 && (
            <ul class="mt-7 flex flex-wrap justify-center gap-0.5 sm:gap-1.5 lg:justify-start">
              {/* No celular as tags encolhem para caber lado a lado: texto, ícone,
                  respiro e padding. É o mesmo tratamento dos chips do hero da
                  home, e sem ele três tags de texto longo ocupavam até 516px numa
                  faixa de 350px — viravam duas ou três linhas empilhadas. */}
              {badges.map((badge) => (
                <li class="inline-flex items-center gap-0.5 rounded-btn border border-line bg-surface/80 py-1.5 pr-1 pl-1 text-[9px] font-semibold whitespace-nowrap text-ink shadow-soft sm:gap-2 sm:pr-3 sm:pl-1.5 sm:text-[12.5px]">
                  <span
                    class="grid size-4 place-items-center rounded-full bg-green-deep text-white sm:size-5"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 12 12" class="size-2.5 sm:size-3" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M2.5 6.4L4.8 8.7L9.5 3.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  {badge}
                </li>
              ))}
            </ul>
          )
        }

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center lg:justify-start">
          <Button href={ctaPrimario.href} variant="green" size="lg" fullWidth class="sm:w-auto">
            {ctaPrimario.label}
          </Button>
          <Button href={ctaSecundario.href} variant="white" size="lg" fullWidth class="sm:w-auto">
            {ctaSecundario.label}
          </Button>
        </div>
      </div>

      {
        temVisual && (
          <div class="reveal min-w-0" data-delay="2">
            <slot name="visual" />
          </div>
        )
      }

      {
        preco && !temVisual && (
          <div
            class:list={[
              'reveal stagger w-full rounded-card border border-line bg-surface px-6 py-5 text-center shadow-soft lg:w-auto lg:min-w-[230px] lg:text-left',
              // recuado da borda direita: encostado nela o card caía em cima do
              // painel principal da arte. O `mr` o tira de lá sem sair do vão.
              astronauta && 'relative z-10 lg:mr-[70px] lg:self-end',
            ]}
            data-delay="2"
          >
            <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">A partir de</p>
            <p class="mt-2 text-[clamp(2rem,4vw,2.5rem)] leading-none font-bold tracking-[-0.02em] text-ink tabular-nums">
              <span class="align-top text-[0.5em] text-ink-soft">R$</span>{' '}{preco}
            </p>
            <p class="mt-2 text-[13px] leading-snug text-ink-soft">por mês, no plano mais em conta</p>
          </div>
        )
      }
    </div>
  </div>
</section>
