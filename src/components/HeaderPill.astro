---
import Logo from './Logo.astro'
import Button from './Button.astro'
import { nav, links } from '../data/site'

const temSubmenu = (
  item: (typeof nav)[number],
): item is Extract<(typeof nav)[number], { itens: readonly unknown[] }> => 'itens' in item
---

<header
  id="site-header"
  class="sticky top-0 z-40 pt-3 transition-[padding] duration-300 sm:pt-4"
>
  <div class="container-page">
    <nav
      id="header-pill"
      aria-label="Navegação principal"
      class="flex items-center gap-2 rounded-btn border border-line/80 bg-surface/75 py-2 pr-2 pl-4 backdrop-blur-xl transition-shadow duration-300 sm:pl-5"
    >
      <a href="/" class="mr-1 shrink-0 py-1" aria-label="Turbo Cloud — página inicial">
        <Logo height={24} class="text-purple-logo" />
      </a>

      <!-- Menu desktop -->
      <ul class="ml-2 hidden items-center gap-0.5 lg:flex">
        {
          nav.map((item) =>
            temSubmenu(item) ? (
              <li class="group relative">
                <button
                  type="button"
                  class="flex items-center gap-1 rounded-full px-3 py-2 text-[14.5px] text-ink-soft transition-colors group-hover:bg-ink/4 group-hover:text-ink"
                  aria-expanded="false"
                >
                  {item.label}
                  <svg
                    viewBox="0 0 12 12"
                    class="size-3 opacity-50 transition-transform duration-200 group-hover:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M3 4.5L6 7.5L9 4.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div class="invisible absolute top-full left-0 pt-2 opacity-0 transition-[opacity,transform] duration-200 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 sm:translate-y-1">
                  <ul class="w-[290px] rounded-card border border-line bg-surface p-1.5 shadow-lift">
                    {item.itens.map((sub) => (
                      <li>
                        <a
                          href={sub.href}
                          class="block rounded-[14px] px-3 py-2.5 transition-colors hover:bg-bg"
                        >
                          <span class="block text-[14.5px] font-medium text-ink">{sub.label}</span>
                          <span class="block text-[13px] text-ink-soft">{sub.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="block rounded-full px-3 py-2 text-[14.5px] text-ink-soft transition-colors hover:bg-ink/4 hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <div class="ml-auto flex shrink-0 items-center gap-1.5 sm:gap-3">
        <a
          href={links.areaCliente}
          rel="noopener"
          class="hidden h-11 items-center gap-2 rounded-btn border border-line bg-surface px-5 text-[14.5px] font-semibold text-ink shadow-soft transition-[background-color,border-color,box-shadow] hover:border-ink/20 hover:shadow-lift sm:inline-flex"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-[19px] text-ink-soft"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="8" r="3.6"></circle>
            <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
          </svg>
          Área do cliente
        </a>
        {/* O wrapper controla a visibilidade: `hidden` no próprio Button perderia
            para o `inline-flex` da variante base na ordem da folha de estilo. */}
        <span class="hidden sm:block">
          <Button href="#planos" variant="green" class="h-11 px-5 text-[14.5px]">
            <svg
              viewBox="0 0 24 24"
              class="size-[19px]"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 15c-1.4 1.4-1.9 3.8-2 5.9 2.1-.1 4.5-.6 5.9-2"></path>
              <path d="M13.5 4.2c2.2-1.6 5.2-2.1 7.3-1.1.9 2.1.5 5.1-1.1 7.3l-5.9 6-6.2-6.2 5.9-6Z"></path>
              <path d="m9.6 12.4 2 2"></path>
              <circle cx="15.6" cy="8.4" r="1.2"></circle>
            </svg>
            Comece agora
          </Button>
        </span>

        <a
          href={links.areaCliente}
          rel="noopener"
          class="grid size-10 shrink-0 place-items-center rounded-full text-green-deep transition-colors hover:bg-green/10 sm:hidden"
          aria-label="Área do cliente"
          title="Área do cliente"
        >
          <svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="3.6"></circle>
            <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
          </svg>
        </a>

        <button
          type="button"
          id="menu-toggle"
          class="grid size-10 place-items-center rounded-full text-ink transition-colors hover:bg-ink/5 lg:hidden"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="menu-mobile"
        >
          <svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M3 6h14M3 12h14" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Menu mobile -->
    <div
      id="menu-mobile"
      hidden
      class="mt-2 rounded-card border border-line bg-surface p-3 shadow-lift lg:hidden"
    >
      <ul class="flex flex-col gap-0.5">
        {
          nav.map((item) =>
            temSubmenu(item) ? (
              <li class="py-1">
                <p class="eyebrow px-3 py-2 text-ink-soft">{item.label}</p>
                <ul>
                  {item.itens.map((sub) => (
                    <li>
                      <a
                        href={sub.href}
                        class="block rounded-[14px] px-3 py-2 text-[15px] text-ink transition-colors hover:bg-bg"
                      >
                        {sub.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class="block rounded-[14px] px-3 py-2.5 text-[15px] text-ink transition-colors hover:bg-bg"
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="mt-3 flex flex-col gap-2 border-t border-line pt-3">
        <Button href={links.areaCliente} variant="outline-dark" fullWidth>Área do cliente</Button>
        <Button href="#planos" variant="green" fullWidth>Comece agora</Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Sombra na pílula ao rolar
  const pill = document.getElementById('header-pill')
  const onScroll = () => {
    if (!pill) return
    pill.classList.toggle('shadow-pill', window.scrollY > 8)
    pill.classList.toggle('border-line', window.scrollY <= 8)
  }
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  // Menu mobile
  const toggle = document.getElementById('menu-toggle')
  const menu = document.getElementById('menu-mobile')

  toggle?.addEventListener('click', () => {
    const aberto = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!aberto))
    toggle.setAttribute('aria-label', aberto ? 'Abrir menu' : 'Fechar menu')
    if (menu) menu.hidden = aberto
  })

  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      menu.hidden = true
      toggle?.setAttribute('aria-expanded', 'false')
    }
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      menu.hidden = true
      toggle?.setAttribute('aria-expanded', 'false')
      toggle?.focus()
    }
  })
</script>
