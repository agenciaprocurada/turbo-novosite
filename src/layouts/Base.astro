---
import '../styles/global.css'
import { marca, links, abasPlanos } from '../data/site'
import type { Faq } from '../data/site'

interface Props {
  titulo: string
  descricao: string
  /** FAQPage do schema.org. Só entra na página que realmente mostra esse FAQ —
   *  repetir o mesmo FAQPage em 9 URLs é o tipo de coisa que o Google ignora. */
  faq?: readonly Faq[]
  /** Product do schema.org. Só onde a tabela de planos aparece de fato. */
  comProduto?: boolean
  /** Trilha de navegação para o BreadcrumbList. A home não passa nada. */
  trilha?: readonly { label: string; href: string }[]
  /** Tira a página do índice. Só o 404 usa — URL de erro não indexa. */
  noindex?: boolean
}

const { titulo, descricao, faq, comProduto = false, trilha, noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://turbocloud.com.br').toString()

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://turbocloud.com.br/#organizacao',
      name: 'Turbo Cloud',
      url: 'https://turbocloud.com.br/',
      email: marca.email,
      telephone: '+5511948600000',
      foundingDate: String(marca.desde),
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Av. Carlos Gomes, 700, 5º Andar, Bela Vista',
        addressLocality: 'Porto Alegre',
        addressRegion: 'RS',
        addressCountry: 'BR',
      },
      sameAs: [links.status],
    },
    ...(comProduto ? [{
      '@type': 'Product',
      name: 'Hospedagem de sites Turbo Cloud',
      description:
        'Hospedagem WordPress e WooCommerce com recursos dedicados, servidores no Brasil, backup a cada 12 horas e suporte humano por WhatsApp.',
      brand: { '@id': 'https://turbocloud.com.br/#organizacao' },
      offers: abasPlanos[0]!.planos.map((plano) => ({
        '@type': 'Offer',
        name: `Plano ${plano.nome}`,
        price: plano.precoMensal.toFixed(2),
        priceCurrency: 'BRL',
        url: plano.href,
        availability: 'https://schema.org/InStock',
      })),
    }] : []),
    ...(faq ? [{
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.p,
        acceptedAnswer: { '@type': 'Answer', text: item.r },
      })),
    }] : []),
    ...(trilha ? [{
      '@type': 'BreadcrumbList',
      itemListElement: trilha.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.label,
        item: new URL(item.href, 'https://turbocloud.com.br').toString(),
      })),
    }] : []),
  ],
}
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js')</script>
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#300C51" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Turbo Cloud" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only rounded-btn focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-green focus:px-4 focus:py-2 focus:text-purple-950"
      >Ir para o conteúdo</a
    >
    <slot />

    <script>
      const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches

      // Números contam do zero até o valor real quando entram na tela (99,982%, 18 ms, 1.366…)
      const contadores = document.querySelectorAll<HTMLElement>('[data-count]')
      if (contadores.length && !reduzido && 'IntersectionObserver' in window) {
        const anima = (el: HTMLElement) => {
          const original = el.textContent ?? ''
          const m = original.match(/^([\d.]+)(,(\d+))?/)
          if (!m) return
          const inteiro = Number(m[1].replace(/\./g, ''))
          const dec = m[3] ?? ''
          const alvo = Number(`${inteiro}.${dec || 0}`)
          const resto = original.slice(m[0].length)
          const casas = dec.length
          const ini = performance.now()
          const dur = 1400
          const tick = (t: number) => {
            const p = Math.min(1, (t - ini) / dur)
            const e = 1 - Math.pow(2, -10 * p) // ease-out expo
            const v = alvo * (p === 1 ? 1 : e)
            el.textContent =
              v.toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas }) + resto
            if (p < 1) requestAnimationFrame(tick)
            else el.textContent = original
          }
          requestAnimationFrame(tick)
        }
        const io = new IntersectionObserver(
          (es) => es.forEach((e) => { if (e.isIntersecting) { anima(e.target as HTMLElement); io.unobserve(e.target) } }),
          { threshold: 0.6 },
        )
        contadores.forEach((el) => io.observe(el))
      }

      // Reveal on scroll — uma vez só, e desligado em prefers-reduced-motion
      const alvos = document.querySelectorAll('.reveal')
      if (reduzido) {
        alvos.forEach((el) => el.classList.add('is-in'))
      } else {
        const io = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (!entrada.isIntersecting) return
              entrada.target.classList.add('is-in')
              io.unobserve(entrada.target)
            })
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        )
        alvos.forEach((el) => io.observe(el))
      }
    </script>
  </body>
</html>
