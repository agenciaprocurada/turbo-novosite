---
/**
 * /planos/ — a tabela completa, com as três abas e os planos de e-mail.
 * É a única página em que todo preço da Turbo aparece junto.
 */
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import HeaderPill from '../components/HeaderPill.astro'
import FooterMega from '../components/FooterMega.astro'

import HeroProduto from '../components/HeroProduto.astro'
import Planos from '../components/secoes/Planos.astro'
import PlanosEmail from '../components/secoes/PlanosEmail.astro'
import ProvaSocial from '../components/secoes/ProvaSocial.astro'
import Faq from '../components/secoes/Faq.astro'
import Migracao from '../components/secoes/Migracao.astro'
import CtaFinal from '../components/secoes/CtaFinal.astro'

import { faq } from '../data/site'

const trilha = [
  { label: 'Home', href: '/' },
  { label: 'Planos', href: '/planos/' },
]
---

<Base
  titulo="Planos e preços de hospedagem, Container e VPS — Turbo Cloud"
  descricao="Todos os planos da Turbo Cloud num lugar só: hospedagem de sites a partir de R$ 35,90, revenda, Container, Cloud VPS e servidor de e-mail. Preço em real, migração grátis e 7 dias de teste."
  faq={faq}
  comProduto
  trilha={trilha}
>
  <TopBar />
  <HeaderPill ctaPlanos="#planos" />

  <main id="conteudo">
    <HeroProduto
      eyebrow="Planos e preços"
      titulo="Todo preço da Turbo,"
      tituloVerde="numa página só."
      lead="Preço em real, sem surpresa de câmbio e sem taxa de instalação. A migração é feita pela nossa equipe e você tem 7 dias para testar."
      badges={['Migração grátis', '7 dias de teste', 'PIX, boleto e cartão']}
      trilha={trilha}
      ctaPrimario={{ label: 'Ver os planos', href: '#planos' }}
    />

    <Planos
      titulo1="Escolha o plano"
      titulo2a="que o seu projeto"
      titulo2b="precisa hoje."
      texto="Hospedagem de sites e revenda, Container e Cloud VPS. Todos rodam na mesma estrutura TIER III no Brasil."
      selo={false}
      class="pt-[clamp(48px,6vw,80px)] pb-[clamp(40px,5vw,64px)]"
    />

    <PlanosEmail
      id="planos-email"
      titulo1="Servidor de e-mail"
      titulo2a="separado"
      titulo2b="do site."
      texto="Se a hospedagem cair ou o site for atacado, a comunicação da empresa continua de pé. Contas ilimitadas em todas as faixas."
    />

    <ProvaSocial class="pt-[clamp(48px,6vw,80px)] pb-[clamp(40px,5vw,64px)]" />

    <Faq itens={faq} comArte />

    <Migracao class="py-[clamp(72px,9vw,132px)]" />

    <CtaFinal />
  </main>

  <FooterMega />
</Base>
