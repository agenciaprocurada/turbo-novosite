---
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import HeaderPill from '../components/HeaderPill.astro'
import FooterMega from '../components/FooterMega.astro'

import ProvaSocial from '../components/secoes/ProvaSocial.astro'
import Planos from '../components/secoes/Planos.astro'
import Faq from '../components/secoes/Faq.astro'
import Migracao from '../components/secoes/Migracao.astro'
import CtaFinal from '../components/secoes/CtaFinal.astro'

import Button from '../components/Button.astro'
import Badge from '../components/Badge.astro'
import SectionEyebrow from '../components/SectionEyebrow.astro'
import HeadingDuo from '../components/HeadingDuo.astro'
import StatBlock from '../components/StatBlock.astro'
import PorqueCard from '../components/PorqueCard.astro'
import ChatMockup from '../components/ChatMockup.astro'
import MapDots from '../components/MapDots.astro'

import FundoNuvens from '../components/FundoNuvens.astro'
import HeroPaineis from '../components/mockups/HeroPaineis.astro'
import astronautaHero from '../assets/imagens/empresa-de-hospedagem-de-site-astronauta-notebook-nuvem.webp'
import fundoInfra from '../assets/fundo-site-01.webp'
import InfraStatusCard from '../components/InfraStatusCard.astro'
import ServiceCard from '../components/ServiceCard.astro'
import { Image } from 'astro:assets'
import foguete from '../assets/imagens/empresa-de-hospedagem-de-site-foguete-caminho-turbo.webp'
import planeta from '../assets/imagens/empresa-de-hospedagem-de-site-planeta-anel.webp'
import racksMobile from '../assets/imagens/empresa-de-hospedagem-de-site-datacenter-racks-mobile.webp'
import iconeCaminho from '../assets/imagens/empresa-de-hospedagem-de-site-icone-caminho-turbo.webp'

import {
  hero,
  provas,
  servicos,
  infraLista,
  porque,
  bannerTurbo,
  suporte,
  stats,
  brasil,
  faq,
  atendimento,
  marca,
} from '../data/site'

const SECAO = 'py-[clamp(72px,9vw,132px)]'

const provasTexto = 'Clientes que confiam na Turbo Cloud para manter tudo no ar, rápido e seguro.'

// Fundo do hero: WebP já otimizado (1698×1006, ~38 KB), servido como está.
---

<Base
  titulo="Turbo Cloud — hospedagem de alta performance no Brasil"
  descricao="Hospedagem WordPress e WooCommerce com CPU e memória dedicadas, TTFB de 18 ms, backup a cada 12 horas e suporte humano no WhatsApp. Servidores em datacenter TIER III no Brasil. Migração grátis."
  faq={faq}
  comProduto
>
  <TopBar />
  <HeaderPill ctaPlanos="#planos" />

  <main id="conteudo">
    {/* ============================== S2 · HERO ============================== */}
    <section class="relative -mt-[76px] overflow-clip bg-[#F6F1FA] pt-[76px] sm:-mt-[84px] sm:pt-[84px]">
      {/* Fundo do topo: nuvens que atravessam a tela em looping. Entrou no lugar
          da arte estática, que trazia o astronauta e os cartões gravados — o
          astronauta agora é um recorte próprio e os cartões são HTML. O degradê
          que existia nas laterais era só para esconder a emenda da arte de
          1698px; a nuvem repete sem costura, então saiu junto. */}
      <FundoNuvens velocidade={60} ancora="topo-no-celular" />

      {/* Degradê no pé do hero: a arte lilás some para a cor de fundo da página, sem linha dura */}
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-[220px]"
        style="background:linear-gradient(180deg, rgba(251,251,250,0) 0%, rgba(251,251,250,.55) 45%, rgba(251,251,250,.92) 82%, #FBFBFA 100%)"
        aria-hidden="true"
      >
      </div>

      {/* No celular a ordem é: imagem → título → texto e botões. No desktop os dois blocos de
          texto ficam empilhados na coluna da esquerda (lg:col-start-1) e a imagem some. */}
      <div
        class="relative container-page grid gap-y-7 py-[clamp(40px,7vw,88px)] lg:min-h-[720px] lg:grid-cols-[minmax(0,616px)_1fr] lg:content-center lg:gap-x-6 lg:gap-y-0"
      >
        {/* Palco da arte do hero: astronauta + painéis numa composição só, a
            mesma em qualquer largura de tela — muda apenas o fator de escala.
            No desktop ele se apoia na borda direita da coluna e transborda para
            a esquerda, o que põe o astronauta no vão entre o texto e os
            painéis; no celular fica centrado, acima do título.
            O `data-parallax` move o astronauta com o ponteiro por `transform`,
            enquanto o voo usa `translate`/`rotate` — as duas coisas convivem no
            mesmo elemento sem uma apagar a outra. */}
        <div
          class="palco-caixa reveal lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center"
          data-delay="3"
        >
          <div class="palco">
            <div
              class="astro-voo astro-hero palco-astro bg-contain bg-no-repeat"
              data-parallax
              style={`background-image:url(${astronautaHero.src})`}
              aria-hidden="true"
            >
            </div>
            <div class="palco-paineis">
              <HeroPaineis />
            </div>
          </div>
        </div>

        <div class="reveal stagger text-center lg:self-end lg:text-left">
          <SectionEyebrow class="justify-center lg:justify-start">{hero.eyebrow}</SectionEyebrow>

          {/* O piso do clamp era 2,3rem: no celular a primeira metade do título
              não cabia numa linha e o H1 ia para três. Medindo o quanto a frase
              ocupa por px de fonte, 32,8px é o limite a 390px de tela — daí o
              termo em vw, que acompanha da faixa de 320px até 580px, e um piso
              baixo que na prática nunca entra. Acima de 580px o teto de 2,9rem
              manda, então o desktop não mudou. */}
          <h1
            class="mt-4 text-[clamp(1.6rem,8vw,2.9rem)] leading-[1.08] font-bold tracking-[-0.024em] text-ink lg:mt-5"
          >
            <span>{hero.titulo1}</span><br /><span class="text-green-ink">{hero.titulo2}</span>
          </h1>
        </div>


        <div class="reveal stagger text-center lg:col-start-1 lg:self-start lg:text-left" data-delay="2">
          <p class="mx-auto max-w-[50ch] lg:mx-0 lg:mt-5 text-[clamp(1rem,1.6vw,1.125rem)] leading-relaxed text-ink-soft">
            <strong class="font-bold text-ink">{hero.subLead}</strong>
            {' '}{hero.sub}
          </p>

          {/* `text-center` do bloco não alinha filho flex, então a fila precisa do
              seu próprio `justify-center`. */}
          <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap lg:justify-start">
            <Button href={hero.ctaPrimario.href} variant="green" size="lg" fullWidth class="sm:w-auto"
              >{hero.ctaPrimario.label}</Button
            >
            <Button href={hero.ctaSecundario.href} variant="white" size="lg" fullWidth class="sm:w-auto"
              >{hero.ctaSecundario.label}</Button
            >
          </div>

          {/* No celular os três chips cabem numa linha só: texto, ícone e respiro
              encolhem até 640px. Abaixo de 375px não há largura para os três, então
              ali eles voltam a quebrar em vez de sair da tela. */}
          <ul class="mt-8 flex flex-wrap justify-center gap-1 min-[375px]:flex-nowrap sm:flex-wrap sm:gap-1.5 lg:justify-start">
            {
              hero.beneficios.map((item) => (
                <li class="inline-flex items-center gap-1 rounded-btn border border-line bg-surface/80 py-1.5 pr-1.5 pl-1 text-[9.5px] font-semibold whitespace-nowrap text-ink shadow-soft sm:gap-2 sm:pr-3 sm:pl-1.5 sm:text-[12.5px]">
                  <span
                    class="grid size-4 place-items-center rounded-full bg-green-deep text-white sm:size-5"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 12 12" class="size-2.5 sm:size-3" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M2.5 6.4L4.8 8.7L9.5 3.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>

          <p class="mt-6 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 font-mono text-[11.5px] tracking-[0.06em] text-ink-soft uppercase lg:justify-start">
            <span class="text-[14px] tracking-[0.08em] text-green-deep" aria-hidden="true">★★★★★</span>
            <span>
              {provas.notaGoogle} no Google · {provas.avaliacoesGoogle.toLocaleString('pt-BR')} avaliações · desde {marca.desde}
            </span>
          </p>
        </div>
      </div>
    </section>

    <ProvaSocial texto={provasTexto} />

    {/* ============================ S4 · SERVIÇOS =========================== */}
    <section class="pt-[clamp(40px,5vw,64px)] pb-[clamp(72px,9vw,132px)]" id="servicos">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[680px] text-center">
          <SectionEyebrow class="justify-center">Recursos</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.9rem,4.2vw,2.6rem)] leading-[1.1] font-bold tracking-[-0.018em] text-ink"
          >
            Um único lugar para tudo<br class="hidden sm:block" /> o que <span class="text-green-ink">você precisa no ar.</span>
          </h2>
        </div>

        <div
          class="mt-10 -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pb-4 sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4"
        >
          {
            servicos.map((servico, i) => (
              <div class="reveal flex w-[82vw] max-w-[320px] shrink-0 snap-start sm:w-auto sm:max-w-none" data-delay={String(i + 1)}>
                <ServiceCard
                  icone={servico.icone}
                  titulo={servico.titulo}
                  texto={servico.texto}
                  itens={servico.itens}
                  rodape={servico.rodape}
                  href={servico.href}
                  class="w-full"
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ========================= S5 · INFRAESTRUTURA ======================== */}
    <section class="block-dark relative overflow-hidden bg-purple-950 text-white" id="estrutura">
      {/* Racks: a arte cobre o bloco inteiro no desktop; no mobile fica só o roxo */}
      <img
        src={fundoInfra.src}
        width={fundoInfra.width}
        height={fundoInfra.height}
        alt=""
        loading="lazy"
        decoding="async"
        class="pointer-events-none absolute top-1/2 left-1/2 hidden h-[70%] w-auto max-w-none -translate-x-1/2 -translate-y-1/2 lg:block"
        style="mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent),linear-gradient(180deg,transparent,#000 14%,#000 86%,transparent);mask-composite:intersect;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent),linear-gradient(180deg,transparent,#000 14%,#000 86%,transparent);-webkit-mask-composite:source-in"
      />
      <div
        class="pointer-events-none absolute inset-0"
        style="background:linear-gradient(90deg,#300C51 0%,rgba(48,12,81,.85) 22%,rgba(48,12,81,0) 46%),linear-gradient(180deg,rgba(48,12,81,.35) 0%,rgba(48,12,81,0) 30%,rgba(48,12,81,0) 70%,rgba(48,12,81,.45) 100%)"
        aria-hidden="true"
      >
      </div>

      {/* Celular: título → racks → lista → card. Desktop: título e lista empilhados na
          coluna 1, card na coluna 3 ocupando as duas linhas. */}
      <div
        class="relative container-page grid gap-y-8 py-[clamp(56px,7vw,96px)] lg:min-h-[560px] lg:grid-cols-[minmax(0,440px)_1fr_minmax(0,320px)] lg:content-center lg:gap-x-8 lg:gap-y-0"
      >
        <div class="reveal">
          <SectionEyebrow tone="dark">Infraestrutura</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.7rem,3vw,2.1rem)] leading-[1.15] font-bold tracking-[-0.018em] text-white"
          >
            Infraestrutura otimizada,<br /><span class="text-green">do jeito que deveria ser.</span>
          </h2>
        </div>

        {/* No celular os racks entram como recorte dedicado, com bordas fundindo no roxo */}
        <div class="relative -mx-5 -my-4 lg:hidden" aria-hidden="true">
          <Image
            src={racksMobile}
            alt=""
            loading="lazy"
            class="h-auto w-full"
            style="mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent),linear-gradient(180deg,transparent,#000 18%,#000 82%,transparent);mask-composite:intersect;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent),linear-gradient(180deg,transparent,#000 18%,#000 82%,transparent);-webkit-mask-composite:source-in"
          />
        </div>

        <div class="reveal lg:col-start-1" data-delay="1">
          <ul class="stagger flex flex-col gap-3 lg:mt-8">
            {
              infraLista.map((item) => (
                <li class="flex items-center gap-3 text-[14.5px] text-white/85">
                  <span
                    class="grid size-6 shrink-0 place-items-center rounded-full border border-white/20 bg-white/6"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 12 12" class="size-3 text-green" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M2.5 6.4L4.8 8.7L9.5 3.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        {/* Card de status só no desktop — no celular os racks + a lista já contam a história */}
        <div class="reveal hidden lg:col-start-3 lg:row-start-1 lg:row-span-2 lg:block lg:self-center" data-delay="2">
          <InfraStatusCard />
        </div>
      </div>
    </section>

    {/* ==================== S6 · POR QUE ESCOLHER + O CAMINHO TURBO ============ */}
    <section class={`relative overflow-x-clip ${SECAO}`}>
      {/* Planetas decorativos ao fundo — mesma imagem, a da esquerda espelhada e menor. Só no desktop. */}
      <Image
        src={planeta}
        alt=""
        loading="lazy"
        class="pointer-events-none absolute top-[8%] right-[max(12px,calc(50%-720px))] planet-float hidden h-auto w-[190px] opacity-60 lg:block"
        aria-hidden="true"
      />
      <Image
        src={planeta}
        alt=""
        loading="lazy"
        class="pointer-events-none absolute top-[24%] left-[max(12px,calc(50%-720px))] planet-float-slow hidden h-auto w-[150px] -scale-x-100 opacity-50 lg:block"
        aria-hidden="true"
      />

      <div class="relative container-page">
        <div class="reveal mx-auto max-w-[680px] text-center">
          <SectionEyebrow class="justify-center">Por que escolher a Turbo Cloud?</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.9rem,4.2vw,2.6rem)] leading-[1.1] font-bold tracking-[-0.018em] text-ink"
          >
            Cansado de escolher entre<br class="hidden sm:block" /> barato, <span class="text-green-ink">simples</span>{' '}ou{' '}<span class="text-green-ink">rápido?</span>
          </h2>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {
            porque.map((item, i) => (
              <div class="reveal" data-delay={String(i + 1)}>
                <PorqueCard icone={item.icone} titulo={item.titulo} texto={item.texto} />
              </div>
            ))
          }
        </div>

        {/* Banner "O caminho Turbo": card branco, ícone, texto, CTA e o foguete à direita */}
        <div
          class="group reveal relative mt-4 overflow-hidden rounded-card border border-line bg-surface p-5 shadow-soft sm:p-7 sm:pr-[130px] lg:min-h-[180px] lg:pr-[210px]"
        >
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-6 lg:min-h-[124px]">
            <span
              class="grid size-16 shrink-0 place-items-center rounded-full bg-purple-950/6"
              aria-hidden="true"
            >
              <Image src={iconeCaminho} alt="" loading="lazy" class="h-auto w-[40px] max-h-[44px] object-contain" />
            </span>

            <div class="min-w-0 flex-1">
              <h3 class="text-[clamp(1.35rem,2.4vw,1.6rem)] font-bold tracking-[-0.018em] text-ink">
                {bannerTurbo.titulo}
              </h3>
              <p class="mt-1.5 text-[15px] leading-relaxed font-bold text-ink">{bannerTurbo.destaque}</p>
              <p class="text-[14.5px] leading-relaxed text-ink-soft">{bannerTurbo.texto}</p>
            </div>

            <div class="shrink-0">
              <Button href={bannerTurbo.cta.href} variant="green" size="lg" fullWidth class="sm:w-auto">{bannerTurbo.cta.label}</Button>
            </div>
          </div>

          {/* Foguete 3D (WebP 2×, exibido em 170px de altura) */}
          <Image
            src={foguete}
            alt=""
            loading="lazy"
            class="rocket-float pointer-events-none absolute top-4 right-4 h-[96px] w-auto transition-transform duration-500 group-hover:-translate-y-2 group-hover:-rotate-3 sm:top-auto sm:right-5 sm:bottom-0 sm:h-[112px] lg:right-7 lg:h-[152px]"
            aria-hidden="true"
          />
        </div>
      </div>
    </section>

    <Migracao class={SECAO} />

    {/* ============================ S8 · SUPORTE ============================ */}
    <section class="py-2" id="suporte">
      <div class="block-section block-dark bg-purple-950 py-[clamp(56px,7vw,104px)] text-white">
        {/* Celular: título → conversa → texto e CTAs. Desktop: texto à esquerda, conversa à direita. */}
        <div class="container-page grid gap-y-8 lg:grid-cols-2 lg:content-center lg:gap-x-16 lg:gap-y-0">
          <div class="reveal lg:self-end">
            <SectionEyebrow
              tone="dark"
              class="mx-auto w-fit max-w-[24ch] rounded-full border border-green/25 bg-green/10 px-4 py-2 text-[11px] leading-[1.7] text-balance lg:mx-0 lg:max-w-none lg:rounded-none lg:border-0 lg:bg-transparent lg:px-0 lg:py-0 lg:text-[12px] lg:leading-[1.2]"
              >{suporte.eyebrow}</SectionEyebrow>
            <HeadingDuo
              parte1={suporte.titulo1}
              parte2={suporte.titulo2}
              tone="dark"
              class="mt-4"
            />
          </div>

          <div class="reveal lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center" data-delay="1">
            <ChatMockup />
            <p class="mt-3 text-center font-mono text-[11px] text-white/35">
              Conversa ilustrativa do fluxo de atendimento.
            </p>
          </div>

          <div class="reveal text-center lg:col-start-1 lg:self-start lg:text-left" data-delay="2">
            <p class="mx-auto max-w-[46ch] text-[16px] leading-relaxed text-white/70 lg:mx-0 lg:mt-4">
              {suporte.texto}
            </p>

            <dl class="mt-7 flex flex-col gap-3 border-t border-white/10 pt-6 font-mono text-[12.5px] sm:gap-2">
              <div class="flex flex-wrap justify-center gap-x-2 max-sm:flex-col max-sm:gap-y-0.5 lg:justify-start">
                <dt class="text-white/40 uppercase">WhatsApp</dt>
                <dd class="text-white/75">{atendimento.whatsapp}</dd>
              </div>
              <div class="flex flex-wrap justify-center gap-x-2 max-sm:flex-col max-sm:gap-y-0.5 lg:justify-start">
                <dt class="text-white/40 uppercase">Ticket</dt>
                <dd class="text-white/75">{atendimento.ticket}</dd>
              </div>
            </dl>

            <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <Button href={suporte.ctaWhats.href} variant="green" size="lg" fullWidth class="sm:w-auto"
                >{suporte.ctaWhats.label}</Button
              >
              <Button href={suporte.ctaTicket.href} variant="outline-light" size="lg" fullWidth class="sm:w-auto"
                >{suporte.ctaTicket.label}</Button
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ========================= S9 · BRASIL / STATS ======================== */}
    <section class={SECAO}>
      <div class="container-page">
        {/* Celular: título → mapa → texto e link. Desktop: texto à esquerda, mapa à direita. */}
        <div class="grid gap-y-8 lg:grid-cols-[0.85fr_1.15fr] lg:content-center lg:gap-x-16 lg:gap-y-0">
          <div class="reveal lg:self-end">
            <SectionEyebrow>{brasil.eyebrow}</SectionEyebrow>
            <HeadingDuo parte1={brasil.titulo1} parte2={brasil.titulo2} class="mt-4" />
          </div>

          <div class="reveal lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center" data-delay="1">
            <div class="rounded-block bg-purple-950 p-5 text-white sm:p-9">
              <MapDots />
            </div>
          </div>

          <div class="reveal text-center lg:col-start-1 lg:self-start lg:text-left" data-delay="2">
            <p class="mx-auto max-w-[42ch] text-[16px] leading-relaxed text-ink-soft lg:mx-0 lg:mt-4">{brasil.texto}</p>
            <a
              href={brasil.link.href}
              class="mt-5 inline-flex items-center gap-1.5 py-2 -my-2 text-[14.5px] font-bold text-green-deep underline decoration-green-deep/40 underline-offset-4 transition-colors hover:decoration-green-deep"
              >{brasil.link.label} <span aria-hidden="true">→</span></a
            >
          </div>
        </div>

        <div
          class="reveal stagger mt-10 grid grid-cols-2 gap-x-3 gap-y-6 rounded-card border border-line bg-surface p-5 shadow-soft sm:gap-y-8 sm:p-6 lg:grid-cols-4 lg:gap-4 lg:p-7"
        >
          {
            stats.map((stat, i) => (
              <StatBlock
                icone={stat.icone}
                valor={stat.valor}
                sufixo={'sufixo' in stat ? stat.sufixo : undefined}
                label={stat.label}
                class={i > 0 ? 'lg:border-l lg:border-line lg:pl-6' : ''}
              />
            ))
          }
        </div>
      </div>
    </section>

    <Planos class={SECAO} />

    <Faq comArte />

    <CtaFinal />
  </main>

  <FooterMega />
</Base>

<script>
  const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches

  // Hero (desktop, mouse): a arte acompanha o ponteiro com um deslocamento leve
  const arte = document.querySelector<HTMLElement>('[data-parallax]')
  const heroSec = arte?.closest('section')
  if (arte && heroSec && !reduzido && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    heroSec.addEventListener('pointermove', (e) => {
      const r = heroSec.getBoundingClientRect()
      const x = (e.clientX - r.left) / r.width - 0.5
      const y = (e.clientY - r.top) / r.height - 0.5
      arte.style.setProperty('--px', `${(-x * 14).toFixed(1)}px`)
      arte.style.setProperty('--py', `${(-y * 10).toFixed(1)}px`)
    })
    heroSec.addEventListener('pointerleave', () => {
      arte.style.setProperty('--px', '0px')
      arte.style.setProperty('--py', '0px')
    })
  }

</script>
