<script>
  const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches

  // Números contam do zero até o valor real quando entram na tela (99,982%, 18 ms, 1.366…)
  const contadores = document.querySelectorAll<HTMLElement>('[data-count]')
  if (contadores.length && !reduzido && 'IntersectionObserver' in window) {
    const anima = (el: HTMLElement) => {
      const original = el.textContent ?? ''
      const m = original.match(/^([\d.]+)(,(\d+))?/)
      if (!m) return
      const inteiro = Number(m[1].replace(/\./g, ''))
      const dec = m[3] ?? ''
      const alvo = Number(`${inteiro}.${dec || 0}`)
      const resto = original.slice(m[0].length)
      const casas = dec.length
      const ini = performance.now()
      const dur = 1400
      const tick = (t: number) => {
        const p = Math.min(1, (t - ini) / dur)
        const e = 1 - Math.pow(2, -10 * p) // ease-out expo
        const v = alvo * (p === 1 ? 1 : e)
        el.textContent =
          v.toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas }) + resto
        if (p < 1) requestAnimationFrame(tick)
        else el.textContent = original
      }
      requestAnimationFrame(tick)
    }
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) { anima(e.target as HTMLElement); io.unobserve(e.target) } }),
      { threshold: 0.6 },
    )
    contadores.forEach((el) => io.observe(el))
  }

  // Hero (desktop, mouse): a arte acompanha o ponteiro com um deslocamento leve
  const arte = document.querySelector<HTMLElement>('[data-parallax]')
  const heroSec = arte?.closest('section')
  if (arte && heroSec && !reduzido && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    heroSec.addEventListener('pointermove', (e) => {
      const r = heroSec.getBoundingClientRect()
      const x = (e.clientX - r.left) / r.width - 0.5
      const y = (e.clientY - r.top) / r.height - 0.5
      arte.style.setProperty('--px', `${(-x * 14).toFixed(1)}px`)
      arte.style.setProperty('--py', `${(-y * 10).toFixed(1)}px`)
    })
    heroSec.addEventListener('pointerleave', () => {
      arte.style.setProperty('--px', '0px')
      arte.style.setProperty('--py', '0px')
    })
  }

  // Planos (desktop com mouse): o card inclina na direção do ponteiro e o brilho o acompanha
  if (!reduzido && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.plan-card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect()
        const x = (e.clientX - r.left) / r.width
        const y = (e.clientY - r.top) / r.height
        card.style.setProperty('--ry', `${((x - 0.5) * 10).toFixed(2)}deg`)
        card.style.setProperty('--rx', `${((0.5 - y) * 8).toFixed(2)}deg`)
        card.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`)
        card.style.setProperty('--my', `${(y * 100).toFixed(1)}%`)
      })
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg')
        card.style.setProperty('--ry', '0deg')
      })
    })
  }

  // Celular: "Ver tudo que inclui" abre os grupos extras do card de plano
  document.querySelectorAll<HTMLButtonElement>('[data-toggle-recursos]').forEach((botao) => {
    botao.addEventListener('click', () => {
      const card = botao.closest('article')
      const aberto = botao.getAttribute('aria-expanded') === 'true'
      botao.setAttribute('aria-expanded', String(!aberto))
      card?.querySelectorAll<HTMLElement>('[data-recursos-extra]').forEach((g) => g.classList.toggle('hidden', aberto))
      const fechado = botao.querySelector<HTMLElement>('[data-label-fechado]')
      const abertoEl = botao.querySelector<HTMLElement>('[data-label-aberto]')
      if (fechado) fechado.hidden = !aberto
      if (abertoEl) abertoEl.hidden = aberto
      const seta = botao.querySelector<HTMLElement>('[aria-hidden]')
      if (seta) seta.style.transform = aberto ? '' : 'rotate(180deg)'
    })
  })

  // Abas de categoria e ciclo de cobrança dos planos
  const barra = document.querySelector<HTMLElement>('[data-planos]')

  if (barra) {
    const abas = [...barra.querySelectorAll<HTMLButtonElement>('[data-aba-plano]')]
    const paineis = [...document.querySelectorAll<HTMLElement>('[data-painel-plano]')]

    abas.forEach((aba) => {
      aba.addEventListener('click', () => {
        const id = aba.dataset.abaPlano
        abas.forEach((a) => a.setAttribute('aria-selected', String(a === aba)))
        paineis.forEach((p) => {
          p.hidden = p.dataset.painelPlano !== id
          if (!p.hidden) {
            const grade = p.querySelector<HTMLElement>('.plans-grid')
            if (grade) {
              grade.classList.remove('is-in')
              void grade.offsetWidth
              grade.classList.add('is-in')
            }
          }
        })
      })
    })

    const botoesCiclo = [...barra.querySelectorAll<HTMLButtonElement>('[data-ciclo]')]

    botoesCiclo.forEach((botao) => {
      botao.addEventListener('click', () => {
        const anual = botao.dataset.ciclo === 'anual'
        botoesCiclo.forEach((b) => b.setAttribute('aria-pressed', String(b === botao)))
        document
          .querySelectorAll<HTMLElement>('[data-ciclo-mensal]')
          .forEach((el) => (el.hidden = anual))
        document
          .querySelectorAll<HTMLElement>('[data-ciclo-anual]')
          .forEach((el) => (el.hidden = !anual))
      })
    })
  }
</script>
