---
/**
 * /afiliados/ — programa de afiliados.
 *
 * Público diferente do resto do site: quem chega aqui já conhece a Turbo e
 * quer saber quanto ganha. Por isso a tabela de comissão vem antes de
 * qualquer argumento de produto.
 *
 * A ordem das seções segue a página atual: comissões → painel → gerente →
 * como funciona → vantagens → FAQ → fechamento.
 */
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import HeaderPill from '../components/HeaderPill.astro'
import FooterMega from '../components/FooterMega.astro'

import HeroProduto from '../components/HeroProduto.astro'
import BeneficioCard from '../components/BeneficioCard.astro'
import SectionEyebrow from '../components/SectionEyebrow.astro'
import Button from '../components/Button.astro'

import Faq from '../components/secoes/Faq.astro'
import ProvaSocial from '../components/secoes/ProvaSocial.astro'

import { afiliados } from '../data/afiliados'

const trilha = [
  { label: 'Home', href: '/' },
  { label: 'Afiliados', href: '/afiliados/' },
]

const brl = (v: number) => v.toLocaleString('pt-BR', { minimumFractionDigits: 2 })

/** CTA que se repete três vezes na página, igual ao site atual. */
const Cta = afiliados.cta
---

<Base
  titulo={afiliados.titulo}
  descricao={afiliados.descricao}
  faq={afiliados.faq}
  trilha={trilha}
>
  <TopBar />
  <HeaderPill />

  <main id="conteudo">
    <HeroProduto
      eyebrow={afiliados.eyebrow}
      titulo={afiliados.h1}
      tituloVerde={afiliados.h1Verde}
      lead={afiliados.lead}
      badges={afiliados.badges}
      trilha={trilha}
      ctaPrimario={Cta}
      ctaSecundario={afiliados.termos}
    />

    {/* --------------------------- Comissões ---------------------------- */}
    <section class="pt-[clamp(56px,7vw,96px)] pb-[clamp(56px,7vw,96px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[640px] text-center">
          <SectionEyebrow align="center">{afiliados.comissoes.eyebrow}</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.7rem,3.6vw,2.3rem)] leading-[1.12] font-bold tracking-[-0.018em] text-balance text-ink"
          >
            {afiliados.comissoes.titulo1}<br /><span class="text-green-ink">{afiliados.comissoes.titulo2}</span>
          </h2>
          <p class="mx-auto mt-4 max-w-[58ch] text-[16px] leading-relaxed text-ink-soft">
            {afiliados.comissoes.texto}
          </p>
        </div>

        <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            afiliados.comissoes.tabela.map((linha, i) => (
              <li class="reveal flex" data-delay={String((i % 4) + 1)}>
                <div class="flex w-full flex-col gap-1 rounded-card border border-line bg-surface px-5 py-4 shadow-soft">
                  <span class="font-mono text-[11px] tracking-[0.1em] text-ink-soft uppercase">
                    {linha.plano}
                  </span>
                  <span class="text-[26px] leading-none font-bold tracking-[-0.02em] text-ink tabular-nums">
                    <span class="align-top text-[0.5em] text-ink-soft">R$</span>{' '}{brl(linha.valor)}
                  </span>
                  <span class="text-[12.5px] text-ink-soft">por venda, todo mês</span>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="mx-auto mt-6 max-w-[70ch] text-center text-[13px] leading-relaxed text-ink-soft">
          {afiliados.comissoes.nota}
        </p>
      </div>
    </section>

    {/* --------------------- Painel + gerente (roxo) -------------------- */}
    <section class="py-2">
      <div class="block-section block-dark bg-purple-950 py-[clamp(56px,7vw,104px)] text-white">
        <div class="container-page">
          <div class="grid gap-y-10 lg:grid-cols-2 lg:items-center lg:gap-x-16">
            <div class="reveal">
              <SectionEyebrow tone="dark">{afiliados.painel.eyebrow}</SectionEyebrow>
              <h2
                class="mt-4 text-[clamp(1.7rem,3.6vw,2.3rem)] leading-[1.12] font-bold tracking-[-0.02em] text-balance"
              >
                {afiliados.painel.titulo1}{' '}<span class="text-green">{afiliados.painel.titulo2}</span>
              </h2>
              <p class="mt-5 max-w-[52ch] text-[16px] leading-relaxed text-white/70">
                {afiliados.painel.texto}
              </p>
            </div>

            <ul class="reveal flex flex-col gap-2.5 lg:col-start-2" data-delay="1">
              {
                afiliados.painel.itens.map((item) => (
                  <li class="flex items-start gap-3 rounded-[14px] border border-white/12 bg-white/5 px-5 py-3.5">
                    <span
                      class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-green text-purple-950"
                      aria-hidden="true"
                    >
                      <svg viewBox="0 0 12 12" class="size-3" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M2.5 6.4L4.8 8.7L9.5 3.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                    <span class="text-[15px] leading-snug text-white/80">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          {/* Gerente de contas */}
          <div class="reveal mt-12 border-t border-white/10 pt-10 text-center" data-delay="2">
            <SectionEyebrow tone="dark" align="center">{afiliados.gerente.eyebrow}</SectionEyebrow>
            <h3
              class="mt-4 text-[clamp(1.5rem,3vw,1.95rem)] leading-[1.15] font-bold tracking-[-0.02em] text-balance"
            >
              {afiliados.gerente.titulo1}{' '}<span class="text-green">{afiliados.gerente.titulo2}</span>
            </h3>
            <p class="mx-auto mt-4 max-w-[60ch] text-[15.5px] leading-relaxed text-white/70">
              {afiliados.gerente.texto}
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ------------------------- Como funciona -------------------------- */}
    <section class="pt-[clamp(64px,8vw,110px)] pb-[clamp(56px,7vw,96px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[620px] text-center">
          <SectionEyebrow align="center">{afiliados.comoFunciona.eyebrow}</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.7rem,3.6vw,2.3rem)] leading-[1.12] font-bold tracking-[-0.018em] text-balance text-ink"
          >
            {afiliados.comoFunciona.titulo1}{' '}<span class="text-green-ink">{afiliados.comoFunciona.titulo2}</span>
          </h2>
        </div>

        {/* Numerado porque é sequência de verdade: um passo depende do anterior */}
        <ol class="mt-10 grid gap-4 md:grid-cols-3">
          {
            afiliados.comoFunciona.passos.map((passo, i) => (
              <li
                class="reveal flex flex-col gap-3 rounded-card border border-line bg-surface p-6 shadow-soft"
                data-delay={String(i + 1)}
              >
                <span class="font-mono text-[12px] tracking-[0.1em] text-green-deep">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="text-[17px] leading-snug font-bold text-ink">{passo.titulo}</h3>
                <p class="text-[14.5px] leading-relaxed text-ink-soft">{passo.texto}</p>
              </li>
            ))
          }
        </ol>

        <div class="reveal mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
          <Button href={Cta.href} variant="green" size="lg" fullWidth class="sm:w-auto">
            {Cta.label}
          </Button>
          <a
            href={afiliados.termos.href}
            target="_blank"
            rel="noopener"
            class="py-2 text-[14px] font-semibold text-ink-soft underline decoration-line underline-offset-4 transition-colors hover:text-green-deep hover:decoration-green-deep"
            >{afiliados.termos.label}</a
          >
        </div>
      </div>
    </section>

    {/* --------------------------- Vantagens ---------------------------- */}
    <section class="pb-[clamp(64px,8vw,110px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[640px] text-center">
          <SectionEyebrow align="center">{afiliados.vantagens.eyebrow}</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.7rem,3.6vw,2.3rem)] leading-[1.12] font-bold tracking-[-0.018em] text-balance text-ink"
          >
            {afiliados.vantagens.titulo1}<br /><span class="text-green-ink">{afiliados.vantagens.titulo2}</span>
          </h2>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            afiliados.vantagens.itens.map((item, i) => (
              <div class="reveal flex" data-delay={String((i % 4) + 1)}>
                <BeneficioCard icone={item.icone} titulo={item.titulo} texto={item.texto} class="w-full" />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <ProvaSocial
      texto="Você não indica no escuro: são avaliações públicas de quem já é cliente."
      class="pb-[clamp(48px,6vw,80px)]"
    />

    <Faq itens={afiliados.faq} comArte />

    {/* --------------------------- Fechamento --------------------------- */}
    <section class="py-2">
      <div
        class="block-section block-dark bg-purple-950 py-[clamp(56px,7vw,88px)] text-center text-white"
      >
        <div class="container-page reveal">
          <h2 class="text-[clamp(1.9rem,4.4vw,2.6rem)] leading-[1.1] font-bold tracking-[-0.02em]">
            <span class="text-white">{afiliados.fechamento.titulo1}</span><br /><span class="text-white/60"
              >{afiliados.fechamento.titulo2}</span
            >
          </h2>
          <p class="mx-auto mt-4 max-w-[54ch] text-[15px] leading-relaxed text-white/65">
            {afiliados.fechamento.texto}
          </p>
          <div class="mt-7 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <Button href={Cta.href} variant="green" size="lg" fullWidth class="sm:w-auto">
              {Cta.label}
            </Button>
            <a
              href={afiliados.termos.href}
              target="_blank"
              rel="noopener"
              class="py-2 text-[14px] font-semibold text-white/70 underline decoration-white/25 underline-offset-4 transition-colors hover:text-green hover:decoration-green"
              >{afiliados.termos.label}</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>

  <FooterMega />
</Base>
