---
/**
 * /legal/ — documentos e políticas, com o texto completo.
 *
 * Os dez documentos saem da Central de Ajuda (WHMCS) e ficam em
 * `src/data/legal/*.html`, copiados literalmente em 21/10/2026 por
 * `scripts/importa-legal.mjs`. A página mostra o índice (âncoras) e, depois,
 * cada documento inteiro, com o link da versão oficial. Detalhes e a razão de
 * a política de privacidade ser a do WHMCS: comentário em `institucional.ts`.
 *
 * A antiga /politica-de-privacidade/ redireciona para a âncora dela aqui
 * (astro.config.mjs).
 */
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import HeaderPill from '../components/HeaderPill.astro'
import FooterMega from '../components/FooterMega.astro'

import HeroProduto from '../components/HeroProduto.astro'
import SectionEyebrow from '../components/SectionEyebrow.astro'
import Button from '../components/Button.astro'

import { legal, legalCopiadoEm } from '../data/institucional'
import { textosLegais } from '../data/legal-textos'
import { marca, links } from '../data/site'

/** Os dez documentos na ordem do índice. */
const documentos: { label: string; slug: string; fonte: string }[] = legal.grupos.flatMap((grupo) => [...grupo.itens])

const trilha = [
  { label: 'Home', href: '/' },
  { label: 'Documentos', href: '/legal/' },
]
---

<Base titulo={legal.titulo} descricao={legal.descricao} trilha={trilha}>
  <TopBar />
  <HeaderPill />

  <main id="conteudo">
    <HeroProduto
      eyebrow={legal.eyebrow}
      titulo={legal.h1}
      tituloVerde={legal.h1Verde}
      lead={legal.lead}
      trilha={trilha}
      ctaPrimario={{ label: 'Ver os documentos', href: '#documentos' }}
      ctaSecundario={{ label: 'Falar com a equipe', href: links.equipe }}
    />

    <section class="pt-[clamp(48px,6vw,80px)] pb-[clamp(72px,9vw,120px)]" id="documentos">
      <div class="container-page">
        <div class="mx-auto flex max-w-[820px] flex-col gap-10">
          {/* Índice: cada item leva ao texto do documento, mais abaixo na página */}
          {
            legal.grupos.map((grupo, g) => (
              <div class="reveal" data-delay={String(g + 1)}>
                <SectionEyebrow>{grupo.titulo}</SectionEyebrow>

                <ul class="mt-4 divide-y divide-line overflow-hidden rounded-card border border-line bg-surface shadow-soft">
                  {grupo.itens.map((item) => (
                    <li>
                      <a
                        href={`#${item.slug}`}
                        class="group flex items-center justify-between gap-4 px-5 py-4 transition-colors hover:bg-green/4 sm:px-6"
                      >
                        <span class="text-[15.5px] leading-snug font-semibold text-ink">
                          {item.label}
                        </span>
                        <span
                          class="grid size-7 shrink-0 place-items-center rounded-full border border-line text-ink-soft transition-[background-color,border-color,color,transform] duration-200 group-hover:translate-y-0.5 group-hover:border-green-deep group-hover:bg-green-deep group-hover:text-white"
                          aria-hidden="true"
                        >
                          <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M8 3v10m0 0 4-4m-4 4L4 9" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }

          <p
            class="reveal rounded-card border border-line bg-surface px-6 py-5 text-[14px] leading-relaxed text-ink-soft shadow-soft"
          >
            Os textos abaixo são cópia dos documentos publicados na Central de Ajuda em {legalCopiadoEm}.
            Cada documento tem, no fim, o link da versão oficial.
          </p>

          {/* Os documentos, na ordem do índice */}
          {
            documentos.map((item) => (
              <article
                id={item.slug}
                class="scroll-mt-28 rounded-card border border-line bg-surface p-6 shadow-soft sm:p-9"
                aria-labelledby={`${item.slug}-titulo`}
              >
                <h2
                  id={`${item.slug}-titulo`}
                  class="text-[clamp(1.4rem,2.8vw,1.8rem)] leading-[1.15] font-bold tracking-[-0.018em] text-ink"
                >
                  {item.label}
                </h2>
                <div class="texto-legal mt-6" set:html={textosLegais[item.slug]} />
                <div class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line pt-5 text-[13.5px]">
                  <a
                    href={item.fonte}
                    target="_blank"
                    rel="noopener"
                    class="font-semibold text-green-deep underline underline-offset-4 hover:text-ink"
                  >
                    Versão oficial na Central de Ajuda ↗
                  </a>
                  <a href="#documentos" class="font-semibold text-ink-soft hover:text-ink">
                    ↑ Voltar ao índice
                  </a>
                </div>
              </article>
            ))
          }

          {/* Dados da empresa, que costumam ser pedidos junto com os documentos */}
          <div class="reveal grid gap-8 rounded-card border border-line bg-surface p-6 shadow-soft sm:p-8 md:grid-cols-2">
            <div>
              <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">Empresa</p>
              <p class="mt-3 text-[15px] leading-relaxed text-ink">
                {marca.nome}<br />
                <span class="text-ink-soft">CNPJ {marca.cnpj}</span><br />
                <span class="text-ink-soft">No ar desde {marca.desde}</span>
              </p>
            </div>
            <div>
              <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">Endereço</p>
              <address class="mt-3 text-[15px] leading-relaxed text-ink-soft not-italic">
                {marca.endereco}
              </address>
            </div>
          </div>

          <div class="reveal text-center">
            <h2 class="text-[clamp(1.4rem,2.6vw,1.7rem)] leading-snug font-bold tracking-[-0.018em] text-ink">
              {legal.rodape.titulo}
            </h2>
            <p class="mx-auto mt-3 max-w-[48ch] text-[15px] leading-relaxed text-ink-soft">
              {legal.rodape.texto}
            </p>
            <div class="mt-6 flex justify-center">
              <Button href={legal.rodape.cta.href} variant="green" size="lg">
                {legal.rodape.cta.label}
              </Button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FooterMega />
</Base>

<style is:global>
  /* Texto dos documentos: HTML cru vindo do WHMCS (p, h3–h5, ul, br, strong, a). */
  .texto-legal {
    color: var(--color-ink);
    font-size: 15.5px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .texto-legal p {
    margin-top: 0.9em;
  }
  .texto-legal p:first-child {
    margin-top: 0;
  }
  .texto-legal h3,
  .texto-legal h4,
  .texto-legal h5 {
    margin-top: 1.9em;
    color: var(--color-ink);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .texto-legal h3 {
    font-size: 1.2rem;
  }
  .texto-legal h4 {
    font-size: 1.08rem;
  }
  .texto-legal h5 {
    font-size: 1rem;
  }
  .texto-legal h3:first-child,
  .texto-legal h4:first-child,
  .texto-legal h5:first-child {
    margin-top: 0;
  }
  .texto-legal h3 + p,
  .texto-legal h4 + p,
  .texto-legal h5 + p {
    margin-top: 0.6em;
  }
  .texto-legal ul {
    margin-top: 0.9em;
    padding-left: 1.4em;
    list-style: disc;
  }
  .texto-legal li + li {
    margin-top: 0.35em;
  }
  .texto-legal a {
    color: var(--color-green-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .texto-legal a:hover {
    color: var(--color-ink);
  }
</style>
