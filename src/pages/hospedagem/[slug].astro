---
/**
 * As seis páginas de produto saem daqui. Uma rota, seis conjuntos de dados
 * em `src/data/produtos.ts` — é a mesma regra da home: conteúdo em dado,
 * nunca escrito no HTML.
 */
import type { GetStaticPaths } from 'astro'

import Base from '../../layouts/Base.astro'
import TopBar from '../../components/TopBar.astro'
import HeaderPill from '../../components/HeaderPill.astro'
import FooterMega from '../../components/FooterMega.astro'

import HeroProduto from '../../components/HeroProduto.astro'
import BeneficioCard from '../../components/BeneficioCard.astro'
import SectionEyebrow from '../../components/SectionEyebrow.astro'
import Button from '../../components/Button.astro'

import Planos from '../../components/secoes/Planos.astro'
import PlanosEmail from '../../components/secoes/PlanosEmail.astro'
import ProvaSocial from '../../components/secoes/ProvaSocial.astro'
import Faq from '../../components/secoes/Faq.astro'
import Migracao from '../../components/secoes/Migracao.astro'
import CtaFinal from '../../components/secoes/CtaFinal.astro'

import astroSitesInstitucionais from '../../assets/imagens/empresa-de-hospedagem-de-site-astronauta-pagespeed-sites-institucionais.webp'
import astroLojaVirtual from '../../assets/imagens/empresa-de-hospedagem-de-site-astronauta-loja-virtual-woocommerce.webp'

import { produtos, seguranca } from '../../data/produtos'
import type { Produto } from '../../data/produtos'
import { abasPlanos, links } from '../../data/site'

export const getStaticPaths = (() =>
  produtos.map((produto) => ({
    params: { slug: produto.slug },
    props: { produto },
  }))) satisfies GetStaticPaths

const { produto } = Astro.props as { produto: Produto }

/** Arte do hero por produto. Cada página ganha a sua, temática; enquanto a de
 *  um slug não existe, aquele hero fica só com a nuvem de fundo. */
const artesHero: Partial<Record<string, ImageMetadata>> = {
  'sites-institucionais': astroSitesInstitucionais,
  'lojas-virtuais-woocommerce': astroLojaVirtual,
}

const abas = produto.abaPlanos ? abasPlanos.filter((aba) => aba.id === produto.abaPlanos) : []

const trilha = [
  { label: 'Home', href: '/' },
  { label: 'Hospedagem', href: '/hospedagem/' },
  { label: produto.nome, href: `/hospedagem/${produto.slug}/` },
]

const SECAO = 'py-[clamp(72px,9vw,132px)]'
---

<Base titulo={produto.titulo} descricao={produto.descricao} faq={produto.faq} trilha={trilha} comProduto={abas.length > 0}>
  <TopBar />
  <HeaderPill ctaPlanos="#planos" />

  <main id="conteudo">
    <HeroProduto
      eyebrow={produto.eyebrow}
      titulo={produto.h1}
      tituloVerde={produto.h1Verde}
      lead={produto.lead}
      badges={produto.badges}
      aPartirDe={produto.aPartirDe}
      astronauta={artesHero[produto.slug]}
      trilha={trilha}
    />

    {/* ---------------------- Por que escolher ---------------------- */}
    <section class="pt-[clamp(56px,7vw,96px)] pb-[clamp(40px,5vw,64px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[640px] text-center">
          <SectionEyebrow class="justify-center">Motivos para escolher a Turbo</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.7rem,3.6vw,2.3rem)] leading-[1.12] font-bold tracking-[-0.018em] text-balance text-ink"
          >
            Por que a Turbo Cloud é a escolha certa <span class="text-green-ink">para {produto.nome.toLowerCase()}.</span>
          </h2>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            produto.porque.map((item, i) => (
              <div class="reveal flex" data-delay={String((i % 4) + 1)}>
                <BeneficioCard icone={item.icone} titulo={item.titulo} texto={item.texto} class="w-full" />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* --------------------------- Planos --------------------------- */}
    {
      abas.length > 0 ? (
        <Planos
          abas={abas}
          titulo1={produto.planosTitulo1}
          titulo2a={produto.planosTitulo2a}
          titulo2b={produto.planosTitulo2b}
          texto={produto.planosTexto}
          selo={false}
          class="pt-[clamp(40px,5vw,64px)] pb-[clamp(56px,7vw,96px)]"
        />
      ) : (
        <PlanosEmail
          titulo1={produto.planosTitulo1}
          titulo2a={produto.planosTitulo2a}
          titulo2b={produto.planosTitulo2b}
          texto={produto.planosTexto}
        />
      )
    }

    {/* ------------------------- Benefícios ------------------------- */}
    {
      produto.beneficios.length > 0 && (
        <section class={SECAO}>
          <div class="container-page">
            <div class="reveal mx-auto max-w-[640px] text-center">
              <SectionEyebrow class="justify-center">Veja por que a Turbo é pra você</SectionEyebrow>
              <h2 class="mt-4 text-[clamp(1.7rem,3.6vw,2.3rem)] leading-[1.12] font-bold tracking-[-0.018em] text-balance text-ink">
                O que vem junto <span class="text-green-ink">em todo plano.</span>
              </h2>
            </div>

            <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {produto.beneficios.map((item, i) => (
                <div class="reveal flex" data-delay={String((i % 4) + 1)}>
                  <BeneficioCard icone={item.icone} titulo={item.titulo} texto={item.texto} class="w-full" />
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* -------------------------- Segurança -------------------------- */}
    <section class="py-2">
      <div class="block-section block-dark bg-purple-950 py-[clamp(56px,7vw,104px)] text-white">
        <div class="container-page">
          <div class="reveal mx-auto max-w-[640px] text-center">
            <SectionEyebrow tone="dark" class="justify-center">Segurança</SectionEyebrow>
            <h2 class="mt-4 text-[clamp(1.7rem,3.6vw,2.3rem)] leading-[1.12] font-bold tracking-[-0.02em] text-balance">
              Além de Turbo, <span class="text-green">seu projeto é seguro.</span>
            </h2>
            <p class="mx-auto mt-4 max-w-[56ch] text-[15.5px] leading-relaxed text-white/70">
              {seguranca.texto}
            </p>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-3">
            {
              seguranca.itens.map((item, i) => (
                <div class="reveal flex" data-delay={String(i + 1)}>
                  <BeneficioCard
                    icone={item.icone}
                    titulo={item.titulo}
                    texto={item.texto}
                    tone="dark"
                    class="w-full"
                  />
                </div>
              ))
            }
          </div>

          <div class="reveal mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center">
            <Button href="#planos" variant="green" size="lg" fullWidth class="sm:w-auto">Conheça os planos</Button>
            <Button href={links.whatsapp} variant="outline-light" size="lg" fullWidth class="sm:w-auto">
              Tirar dúvida no WhatsApp
            </Button>
          </div>
        </div>
      </div>
    </section>

    <ProvaSocial class="pt-[clamp(64px,8vw,110px)] pb-[clamp(40px,5vw,64px)]" />

    <Faq itens={produto.faq} />

    <Migracao class={SECAO} />

    <CtaFinal />
  </main>

  <FooterMega />
</Base>
