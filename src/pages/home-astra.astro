---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import HeaderPill from '../components/HeaderPill.astro'
import FooterMega from '../components/FooterMega.astro'
import Button from '../components/Button.astro'
import SectionEyebrow from '../components/SectionEyebrow.astro'
import Avatar from '../components/Avatar.astro'
import FundoNuvens from '../components/FundoNuvens.astro'
import MigrationFunnel from '../components/MigrationFunnel.astro'
import Faq from '../components/secoes/Faq.astro'
import PlanosAstra from '../components/home-astra/PlanosAstra.astro'
import { homeAstra as copy } from '../data/home-astra'
import { provas, marca, links, depoimentos, faq, atendimento } from '../data/site'
import astronauta from '../assets/imagens/empresa-de-hospedagem-de-site-astronauta-notebook-nuvem.webp'
import racks from '../assets/fundo-site-01.webp'
import foguete from '../assets/imagens/empresa-de-hospedagem-de-site-foguete-caminho-turbo.webp'

const brl = (valor: number) => valor.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
const icones = {
  wordpress: 'M4 5h16v14H4zM4 9h16M7 7h.01M10 7h.01M8 12l2 4 2-4 2 4 2-4',
  servidor: 'M4 4h16v6H4zM4 14h16v6H4zM7 7h.01M7 17h.01M11 7h6M11 17h6',
  email: 'M3 6h18v12H3zM3 7l9 6 9-6',
}
---

<Base titulo={copy.titulo} descricao={copy.descricao} faq={faq} comProduto noindex>
  <div id="home-astra">
    <div class="astra-announcement block-dark">
      <div class="container-page">
        <a href="#migracao"><span aria-hidden="true">↗</span> {copy.aviso}</a>
        <a class="original-link" href="/">Ver home original <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <HeaderPill ctaPlanos="#planos" />

    <main id="conteudo">
      <section class="astra-hero" aria-labelledby="astra-hero-title">
        <FundoNuvens velocidade={160} opacidade={0.45} />
        <div class="container-page hero-grid">
          <div class="hero-copy">
            <SectionEyebrow>{copy.hero.eyebrow}</SectionEyebrow>
            <h1 id="astra-hero-title">{copy.hero.titulo}<span>{copy.hero.destaque}</span></h1>
            <p class="hero-description">{copy.hero.texto}</p>
            <div class="hero-actions">
              <Button href="#planos" size="lg">{copy.hero.principal} <span aria-hidden="true">→</span></Button>
              <Button href={links.whatsapp} variant="outline-dark" size="lg">{copy.hero.secundario}</Button>
            </div>
            <p class="hero-price">A partir de <strong>R$ {brl(copy.hero.preco)}/mês</strong> <span>· cobrança mensal</span></p>
            <ul class="hero-benefits">
              {copy.hero.beneficios.map((item) => <li><span aria-hidden="true">✓</span> {item}</li>)}
            </ul>
          </div>

          <div class="hero-visual" aria-label="Servidores no Brasil, com a performance Turbo Cloud">
            <div class="orbit orbit-one" aria-hidden="true"></div>
            <div class="orbit orbit-two" aria-hidden="true"></div>
            <span class="orbit-dot" aria-hidden="true"></span>
            <span class="visual-caption" aria-hidden="true">SEU PRÓXIMO DESTINO: TURBO CLOUD</span>
            <Image src={astronauta} width={325} quality={85} alt="" loading="eager" fetchpriority="high" class="astra-astronaut" aria-hidden="true" />
            <div class="hero-metric">
              <span class="metric-icon" aria-hidden="true">↗</span>
              <div><p>Tempo até o primeiro byte</p><strong>{provas.ttfb}</strong><span>nos servidores do Brasil</span></div>
            </div>
            <div class="hero-datacenter">
              <span class="location-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 21s7-6 7-12a7 7 0 0 0-14 0c0 6 7 12 7 12Z" /><circle cx="12" cy="9" r="2.5" /></svg></span>
              <span><strong>Brasil. Perto de você.</strong><small>Datacenter TIER III · São Paulo</small></span>
            </div>
          </div>
        </div>

        <div class="container-page">
          <div class="hero-trust">
            <a href={links.avaliacoes} target="_blank" rel="noopener" class="rating">
              <span class="stars" aria-hidden="true">★★★★★</span>
              <span><strong>{provas.notaGoogle} no Google</strong><small>{provas.avaliacoesGoogle.toLocaleString('pt-BR')} avaliações de clientes <span aria-hidden="true">↗</span></small></span>
            </a>
            <div><strong>{provas.uptimeTier3}</strong><span>Disponibilidade do datacenter</span></div>
            <div><strong>Desde {marca.desde}</strong><span>Hospedando histórias no Brasil</span></div>
          </div>
        </div>
      </section>

      <section class="astra-section solutions" id="solucoes" aria-labelledby="solutions-title">
        <div class="container-page">
          <div class="section-heading reveal">
            <SectionEyebrow align="center">{copy.solucao.eyebrow}</SectionEyebrow>
            <h2 id="solutions-title">{copy.solucao.titulo}<br /><span>{copy.solucao.destaque}</span></h2>
          </div>
          <div class="solution-grid">
            {copy.solucao.itens.map((item) => (
              <a class="solution-card" href={item.href}>
                <div class="solution-top"><span class="solution-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={icones[item.icone]} /></svg></span><span class="solution-number">{item.numero}</span></div>
                <p class="solution-detail">{item.detalhe}</p>
                <h3>{item.titulo}</h3>
                <p class="solution-description">{item.texto}</p>
                <p class="solution-price">A partir de <strong>R$ {brl(item.preco)}</strong>/mês</p>
                <span class="solution-cta">{item.cta}<span aria-hidden="true">↗</span></span>
              </a>
            ))}
          </div>
          <a class="builder-link" href={links.ferramentasIa.turboBuilder}><span aria-hidden="true">✦</span><span>Ainda não tem um site? <strong>Crie com IA no Turbo Builder.</strong></span><span aria-hidden="true">→</span></a>
        </div>
      </section>

      <PlanosAstra />

      <section class="astra-infra block-dark" id="infraestrutura" aria-labelledby="infra-title">
        <div class="container-page infra-grid">
          <div class="infra-copy">
            <SectionEyebrow tone="dark">{copy.infra.eyebrow}</SectionEyebrow>
            <h2 id="infra-title">{copy.infra.titulo}<br /><span>{copy.infra.destaque}</span></h2>
            <p>{copy.infra.texto}</p>
            <ol class="infra-benefits">
              {copy.infra.itens.map((item) => (
                <li><span>{item.numero}</span><div><h3>{item.titulo}</h3><p>{item.texto}</p></div></li>
              ))}
            </ol>
            <a class="infra-link" href={links.estrutura}>Conheça nossa estrutura <span aria-hidden="true">↗</span></a>
          </div>
          <div class="infra-visual">
            <Image src={racks} width={940} quality={85} alt="Ilustração de racks de servidores na identidade roxa da Turbo Cloud" loading="lazy" class="racks" />
            <div class="infra-location"><span aria-hidden="true">◎</span><span>ASCENTY · SÃO PAULO, BRASIL</span></div>
            <div class="infra-proof"><span>Infraestrutura TIER III</span><strong>{provas.uptimeTier3}</strong><span>de disponibilidade do datacenter</span></div>
          </div>
        </div>
      </section>

      <section class="astra-section" id="migracao" aria-labelledby="migration-title">
        <div class="container-page migration-grid">
          <div class="migration-copy reveal">
            <SectionEyebrow>{copy.migracao.eyebrow}</SectionEyebrow>
            <h2 id="migration-title">{copy.migracao.titulo}<br /><span>{copy.migracao.destaque}</span></h2>
            <p>{copy.migracao.texto}</p>
            <Button href={links.whatsapp} size="lg">{copy.migracao.cta} <span aria-hidden="true">↗</span></Button>
            <p class="support-hours">{atendimento.whatsapp}.<br />{atendimento.ticket}.</p>
          </div>
          <div class="migration-visual reveal"><MigrationFunnel /></div>
        </div>
      </section>

      <section class="astra-section astra-social" aria-labelledby="social-title">
        <div class="container-page">
          <div class="section-heading reveal"><SectionEyebrow align="center">{copy.social.eyebrow}</SectionEyebrow><h2 id="social-title">{copy.social.titulo}<br /><span>{copy.social.destaque}</span></h2></div>
          <div class="review-grid">
            {depoimentos.slice(0, 3).map((review) => (
              <figure class="review-card">
                <span class="stars" aria-label="5 de 5 estrelas">★★★★★</span>
                <blockquote>“{review.texto}”</blockquote>
                <figcaption><Avatar nome={review.nome} size={42} /><span><strong>{review.nome}</strong><small>Avaliação no Google · {review.data}</small></span></figcaption>
              </figure>
            ))}
          </div>
          <a class="all-reviews" href={links.avaliacoes} target="_blank" rel="noopener">{copy.social.nota} · Veja as {provas.avaliacoesGoogle.toLocaleString('pt-BR')} avaliações <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <Faq itens={faq} class="astra-faq" />

      <section class="astra-final block-dark" aria-labelledby="final-title">
        <div class="container-page">
          <div class="final-content"><h2 id="final-title">{copy.final.titulo}<br /><span>{copy.final.destaque}</span></h2><p>{copy.final.texto}</p><div class="hero-actions"><Button href="#planos" size="lg">Escolher meu plano <span aria-hidden="true">→</span></Button><Button href={links.whatsapp} size="lg" variant="outline-light">Conversar com a equipe</Button></div></div>
          <Image src={foguete} width={150} quality={85} alt="" aria-hidden="true" loading="lazy" class="final-rocket" />
        </div>
      </section>
    </main>
    <FooterMega />
    <div class="astra-compare"><a href="/">← Comparar com a home original</a><span>Turbo Cloud · Proposta Astra</span></div>
  </div>

  <a slot="whatsapp" class="astra-whatsapp" href={links.whatsapp} target="_blank" rel="noopener" aria-label="Falar com a Turbo Cloud no WhatsApp">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l1.9-5.4A8.5 8.5 0 1 1 21 11.5Z" /><path d="m8 7 1.5 2-1 1.5a8 8 0 0 0 4 4l1.5-1 2 1.5c0 2-2 2-3 1.5-3-1-5-3-6-6C6.5 8.5 7 7 8 7Z" /></svg>
  </a>
</Base>

<script>
  // Os atalhos de planos ficam nesta proposta, inclusive no header e no rodapé.
  document.querySelectorAll<HTMLAnchorElement>('#home-astra a[href="/#planos"]').forEach((link) => { link.href = '#planos' })
  // Completa o comportamento de teclado do menu compartilhado nesta página.
  const header = document.querySelector('#home-astra #site-header')
  header?.querySelectorAll<HTMLButtonElement>('nav > ul > li > button').forEach((button) => {
    const group = button.parentElement!
    const sync = () => button.setAttribute('aria-expanded', String(group.matches(':hover') || group.contains(document.activeElement)))
    group.addEventListener('mouseenter', sync)
    group.addEventListener('mouseleave', sync)
    group.addEventListener('focusin', sync)
    group.addEventListener('focusout', () => requestAnimationFrame(sync))
  })
</script>

<style>
  #home-astra { background: var(--color-bg); }
  .astra-announcement { background: var(--color-purple-950); color: white; font-size: 12px; }
  .astra-announcement > div { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .astra-announcement a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; }
  .astra-announcement a > span { color: var(--color-green); }
  .original-link { color: #ded3e8; }
  .astra-hero { position: relative; margin-top: -76px; padding-top: 76px; overflow: clip; background: linear-gradient(155deg, #f9f6fc, #f1eaf8 72%, #fbfbfa); }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 32px; padding-block: 68px 54px; }
  .hero-copy { position: relative; z-index: 2; }
  h1 { max-width: 590px; margin: 20px 0 24px; font-size: clamp(38px, 4.15vw, 60px); line-height: 1.05; font-weight: 700; letter-spacing: -.022em; }
  h1 span, h2 span { color: var(--color-green-ink); }
  h1 > span { display: block; text-wrap: balance; }
  .hero-description { max-width: 46ch; font-size: 18px; line-height: 1.65; color: var(--color-ink-soft); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero-actions :global(a) { padding-inline: 20px; font-size: 13px; }
  .hero-price { margin-top: 22px; font-size: 14px; color: var(--color-ink-soft); }
  .hero-price strong { color: var(--color-ink); }
  .hero-benefits { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 14px; font-size: 13px; }
  .hero-benefits li span { margin-right: 4px; color: var(--color-green-deep); font-weight: 700; }
  .hero-visual { position: relative; min-width: 0; height: 480px; }
  .orbit { position: absolute; width: 440px; height: 440px; left: 50%; top: 20px; translate: -50% 0; border-radius: 50%; border: 1px solid #5c1f851a; background: radial-gradient(circle, #decee985, #f2eaf900 68%); }
  .orbit-two { width: 360px; height: 360px; top: 60px; border-style: dashed; background: none; rotate: -18deg; }
  .orbit-dot { position: absolute; left: 5%; top: 105px; width: 12px; height: 12px; border-radius: 50%; background: var(--color-green); box-shadow: 0 0 0 7px #6bdd1214; }
  .visual-caption { position: absolute; top: -2px; right: 20px; font-family: var(--font-mono); font-size: 10px; letter-spacing: .1em; color: var(--color-purple-logo); }
  .hero-visual :global(.astra-astronaut) { position: absolute; width: 325px; height: auto; top: 10px; left: 36px; z-index: 1; animation: turbo-float 9s ease-in-out infinite; }
  .hero-metric { position: absolute; z-index: 2; top: 110px; right: 0; display: flex; gap: 12px; align-items: flex-start; background: #fffffff0; border: 1px solid #e8e0ef; padding: 18px; border-radius: var(--radius-card); box-shadow: var(--shadow-lift); }
  .metric-icon { display: grid; place-items: center; width: 32px; height: 32px; background: #eef7e6; border-radius: 10px; color: var(--color-green-deep); font-size: 21px; }
  .hero-metric p { font-size: 12px; color: var(--color-ink-soft); }
  .hero-metric strong { display: block; font-size: 38px; font-weight: 700; letter-spacing: -.025em; line-height: 1.2; margin-block: 5px; }
  .hero-metric div > span { font-size: 12px; color: var(--color-ink-soft); }
  .hero-datacenter { position: absolute; z-index: 2; right: 8px; bottom: 20px; display: flex; align-items: center; gap: 14px; background: var(--color-purple-950); color: white; padding: 18px 22px; border-radius: var(--radius-card); box-shadow: var(--shadow-lift); }
  .location-icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; background: #ffffff12; color: var(--color-green); }
  .location-icon svg { width: 24px; }
  .hero-datacenter strong { display: block; font-size: 15px; }
  .hero-datacenter small { display: block; font-size: 12px; color: #d7cbe1; margin-top: 3px; }
  .hero-trust { position: relative; display: grid; grid-template-columns: 1.3fr 1fr 1fr; align-items: center; border-top: 1px solid #5c1f851f; padding-block: 26px 30px; }
  .hero-trust > * { padding-inline: 32px; border-left: 1px solid #5c1f851f; }
  .hero-trust > :first-child { padding-left: 0; border: 0; }
  .hero-trust strong { display: block; font-size: 19px; font-weight: 700; }
  .hero-trust > div > span, .hero-trust small { display: block; font-size: 13px; color: var(--color-ink-soft); }
  .rating { display: flex; align-items: center; gap: 18px; }
  .stars { letter-spacing: .08em; color: var(--color-green-deep); font-size: 17px; }
  .astra-section { padding-block: clamp(60px, 6.5vw, 92px); scroll-margin-top: 96px; }
  .section-heading { text-align: center; }
  h2 { margin-top: 16px; font-size: clamp(30px, 3.5vw, 42px); font-weight: 700; line-height: 1.12; letter-spacing: -.02em; }
  .solution-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 36px; }
  .solution-card { display: flex; flex-direction: column; padding: 26px 26px 0; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: white; transition: border-color .2s, box-shadow .2s, transform .2s; }
  .solution-card:hover { border-color: #5c1f8555; box-shadow: var(--shadow-soft); transform: translateY(-3px); }
  .solution-top { display: flex; align-items: center; justify-content: space-between; }
  .solution-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius-btn); color: var(--color-purple-logo); background: #f2ecf7; }
  .solution-icon svg { width: 25px; }
  .solution-number { font-size: 12px; font-family: var(--font-mono); color: var(--color-ink-soft); }
  .solution-detail { margin-top: 24px; font-size: 11px; letter-spacing: .025em; font-family: var(--font-mono); color: var(--color-purple-logo); }
  .solution-card h3 { margin-top: 9px; font-size: 23px; font-weight: 700; }
  .solution-description { margin-top: 12px; font-size: 15px; line-height: 1.65; color: var(--color-ink-soft); }
  .solution-price { margin-top: auto; padding-top: 24px; font-size: 13px; color: var(--color-ink-soft); }
  .solution-price strong { font-size: 19px; color: var(--color-ink); }
  .solution-cta { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-block: 18px; margin-top: 18px; border-top: 1px solid var(--color-line); font-size: 13px; font-weight: 700; color: var(--color-purple-logo); }
  .solution-cta > span { font-size: 21px; }
  .builder-link { display: flex; align-items: center; justify-content: center; gap: 14px; padding: 20px; margin-top: 20px; background: #f3eef7; border-radius: var(--radius-btn); font-size: 14px; }
  .builder-link > span:first-child { color: var(--color-purple-logo); font-size: 23px; }
  .builder-link strong { color: var(--color-purple-logo); }
  .solutions { padding-bottom: 20px; }
  .astra-infra { overflow: clip; position: relative; background: var(--color-purple-950); color: white; padding-block: clamp(56px, 6.5vw, 88px); scroll-margin-top: 96px; }
  .infra-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .infra-copy h2 span, .final-content h2 span { color: var(--color-green); }
  .infra-copy > p { margin-top: 20px; max-width: 49ch; font-size: 16px; color: #d7cbe1; }
  .infra-benefits { margin-top: 32px; }
  .infra-benefits li { display: flex; gap: 18px; padding-block: 18px; border-top: 1px solid #ffffff20; }
  .infra-benefits li > span { margin-top: 3px; font-family: var(--font-mono); font-size: 11px; color: var(--color-green); }
  .infra-benefits h3 { font-size: 17px; font-weight: 700; line-height: 1.3; }
  .infra-benefits p { margin-top: 7px; font-size: 14px; color: #d7cbe1; line-height: 1.6; }
  .infra-link { display: inline-flex; gap: 22px; align-items: center; min-height: 44px; margin-top: 12px; color: var(--color-green); font-size: 14px; font-weight: 700; }
  .infra-visual { position: relative; min-width: 0; height: 510px; border: 1px solid #ffffff20; border-radius: var(--radius-block); background: radial-gradient(ellipse at 50% 48%, #6d339f75, #300c51 72%); overflow: hidden; }
  .infra-visual :global(.racks) { position: absolute; width: 940px; max-width: none; height: auto; top: 60px; left: 50%; translate: -50% 0; mask-image: linear-gradient(180deg, transparent, black 15%, black 75%, transparent); }
  .infra-location { position: relative; display: flex; align-items: center; gap: 10px; justify-content: center; padding: 24px 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .07em; color: #e5d9ee; }
  .infra-location > span:first-child { color: var(--color-green); }
  .infra-proof { position: absolute; bottom: 20px; left: 20px; right: 20px; border: 1px solid #ffffff25; border-radius: var(--radius-card); background: #300c51e6; text-align: center; padding: 20px; }
  .infra-proof span { display: block; font-size: 12px; color: #d7cbe1; }
  .infra-proof strong { display: block; margin-block: 4px; font-size: 38px; font-weight: 700; letter-spacing: -.02em; color: var(--color-green); }
  .migration-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 88px; }
  .migration-copy > p { margin-block: 22px 28px; font-size: 16px; line-height: 1.7; color: var(--color-ink-soft); }
  .migration-copy .support-hours { font-size: 12px; margin-bottom: 0; }
  .migration-visual { background: #f8f5fb; padding: 32px; border-radius: var(--radius-block); border: 1px solid var(--color-line); }
  .astra-social { background: #f4f0f7; }
  .review-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 36px; }
  .review-card { display: flex; flex-direction: column; background: white; border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 26px; }
  blockquote { margin-top: 20px; font-size: 17px; line-height: 1.65; font-weight: 600; }
  figcaption { display: flex; gap: 12px; align-items: center; margin-top: auto; padding-top: 28px; }
  figcaption strong { display: block; font-size: 14px; }
  figcaption small { display: block; font-size: 11px; color: var(--color-ink-soft); }
  .all-reviews { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; margin-top: 24px; color: var(--color-purple-logo); font-size: 14px; font-weight: 700; text-align: center; }
  #home-astra :global(.astra-faq) { padding-block: clamp(60px, 6.5vw, 92px); }
  .astra-final { background: var(--color-purple-950); color: white; overflow: clip; }
  .astra-final > div { position: relative; padding-block: 64px; }
  .final-content { position: relative; z-index: 1; max-width: 780px; }
  .final-content h2 { margin-top: 0; }
  .final-content > p { color: #d7cbe1; margin-top: 20px; font-size: 16px; }
