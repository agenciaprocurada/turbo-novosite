---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import HeaderPill from '../components/HeaderPill.astro'
import FooterMega from '../components/FooterMega.astro'
import ConfiancaInfra from '../components/ConfiancaInfra.astro'
import FundoNuvens from '../components/FundoNuvens.astro'
import Button from '../components/Button.astro'
import HeadingDuo from '../components/HeadingDuo.astro'
import SectionEyebrow from '../components/SectionEyebrow.astro'
import HeroVisualAstra from '../components/home-astra/HeroVisualAstra.astro'
import HeroTrust from '../components/home-astra/HeroTrust.astro'
import InfraStatusCard from '../components/InfraStatusCard.astro'
import ProvaSocial from '../components/secoes/ProvaSocial.astro'
import Faq from '../components/secoes/Faq.astro'
import CtaFinal from '../components/secoes/CtaFinal.astro'
import racks from '../assets/fundo-site-01.webp'
import { links } from '../data/site'
import { homeN2 as copy } from '../data/home-n2'

const icons: Record<string, string> = {
  site: 'M3 5h18v14H3zM3 9h18M7 7h.01M10 7h.01M7 13h4M7 16h8',
  codigo: 'm8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16',
  ia: 'm12 3 2.3 6.7L21 12l-6.7 2.3L12 21l-2.3-6.7L3 12l6.7-2.3L12 3Z',
  fluxo: 'M3 3h6v6H3zM15 15h6v6h-6zM9 6h9v9M6 9v9h9',
  email: 'M3 5h18v14H3zM3 6l9 7 9-7',
}
const brl = (value: number) => value.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
---

<Base titulo={copy.titulo} descricao={copy.descricao} faq={copy.faq} noindex>
  <TopBar />
  <HeaderPill ctaPlanos="#planos" />
  <main id="conteudo" class="home-n2">
    <section class="relative -mt-[76px] overflow-clip bg-[#F6F1FA] pt-[76px] sm:-mt-[84px] sm:pt-[84px]">
      <FundoNuvens velocidade={60} ancora="topo-no-celular" />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[220px]" style="background:linear-gradient(180deg, rgba(251,251,250,0) 0%, rgba(251,251,250,.55) 45%, rgba(251,251,250,.92) 82%, #FBFBFA 100%)" aria-hidden="true"></div>
      <div class="relative container-page n2-hero-grid">
        <div class="n2-hero-copy">
          <SectionEyebrow>{copy.hero.eyebrow}</SectionEyebrow>
          <h1>{copy.hero.titulo}<span>{copy.hero.destaque}</span></h1>
          <p class="n2-lead"><strong>{copy.hero.lead}</strong> {copy.hero.texto}</p>
          <div class="n2-actions"><Button href="#solucoes" size="lg">{copy.hero.principal}<span aria-hidden="true">→</span></Button><Button href={links.whatsapp} size="lg" variant="outline-purple">{copy.hero.secundario}</Button></div>
          <ul class="n2-hero-benefits">{copy.hero.beneficios.map(item => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
        </div>
        <div class="n2-hero-art"><HeroVisualAstra /><p>{copy.hero.legenda}</p></div>
      </div>
      <div class="relative container-page"><HeroTrust /></div>
    </section>

    <ConfiancaInfra />

    <section id="solucoes" class="n2-section">
      <div class="container-page">
        <div class="n2-section-heading reveal"><SectionEyebrow align="center">{copy.projetos.eyebrow}</SectionEyebrow><h2>{copy.projetos.titulo}<span>{copy.projetos.destaque}</span></h2><p>{copy.projetos.texto}</p></div>
        <div class="n2-project-grid">
          {copy.projetos.itens.map((item, i) => <article class="n2-project-card reveal" data-delay={String(i + 1)}>
            <div class="n2-card-top"><span class="n2-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[item.icone]} /></svg></span><span class="n2-number">0{i + 1}</span></div>
            <h3>{item.titulo}</h3><p>{item.texto}</p><span class="n2-examples">{item.exemplos}</span><a class="n2-text-link" href={item.href}>{item.cta}<span aria-hidden="true">→</span></a>
          </article>)}
        </div>
      </div>
    </section>

    <section id="estrutura" class="n2-infra block-dark">
      <Image src={racks} alt="" loading="lazy" class="n2-racks" aria-hidden="true" />
      <div class="n2-infra-shade" aria-hidden="true"></div>
      <div class="container-page n2-infra-grid">
        <div class="reveal"><SectionEyebrow tone="dark">{copy.infra.eyebrow}</SectionEyebrow><HeadingDuo parte1={copy.infra.titulo} parte2={copy.infra.destaque} tone="dark" class="mt-4" /><p class="n2-infra-lead">{copy.infra.texto}</p>
          <ul class="n2-infra-list">{copy.infra.itens.map((item, i) => <li><span aria-hidden="true">0{i + 1}</span><div><h3>{item.titulo}</h3><p>{item.texto}</p></div></li>)}</ul>
          <div class="n2-infra-cta"><Button href={links.estrutura} variant="outline-light">{copy.infra.cta}<span aria-hidden="true">→</span></Button></div>
        </div>
        <div class="n2-infra-status reveal" data-delay="1"><InfraStatusCard /></div>
      </div>
    </section>

    <section class="n2-section" id="crie-com-ia">
      <div class="container-page">
        <div class="n2-ia-heading reveal"><div><SectionEyebrow>{copy.ia.eyebrow}</SectionEyebrow><HeadingDuo parte1={copy.ia.titulo} parte2={copy.ia.destaque} class="mt-4" /></div><p>{copy.ia.texto}</p></div>
        <ol class="n2-workflow">{copy.ia.passos.map(passo => <li class="reveal"><span>{passo.numero}</span><h3>{passo.titulo}</h3><p>{passo.texto}</p></li>)}</ol>
        <div class="n2-tools">{copy.ia.ferramentas.map((tool, i) => <article class:list={['n2-tool reveal', i === 1 && 'n2-tool-deploy']}><span class="n2-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d={icons[i === 0 ? 'ia' : 'codigo']} /></svg></span><div><h3>{tool.nome}</h3><p>{tool.texto}</p><a class="n2-text-link" href={tool.href}>{tool.cta}<span aria-hidden="true">→</span></a></div></article>)}</div>
        <p class="n2-note">{copy.ia.nota}</p>
      </div>
    </section>

    <section class="n2-plans-section" id="planos">
      <div class="container-page">
        <div class="n2-section-heading reveal"><SectionEyebrow align="center">{copy.planos.eyebrow}</SectionEyebrow><h2>{copy.planos.titulo}<span>{copy.planos.destaque}</span></h2><p>{copy.planos.texto}</p></div>
        <div class="n2-plans-grid">{copy.planos.itens.map(plan => <article class="n2-plan reveal"><div class="n2-plan-heading"><h3>{plan.nome}</h3><p>{plan.para}</p></div><div class="n2-plan-price"><span>{copy.planos.aPartir}</span><p><small>R$</small> {brl(plan.preco)}<small>{copy.planos.periodo}</small></p></div><ul>{plan.itens.map(item => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul><Button href={plan.href} fullWidth variant="outline-purple">{plan.cta}</Button></article>)}</div>
        <p class="n2-note">{copy.planos.nota}</p><div class="n2-plan-help"><p>{copy.planos.ajuda}</p><a class="n2-text-link" href={links.whatsapp} target="_blank" rel="noopener">{copy.planos.ctaAjuda}<span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <ProvaSocial texto={copy.social} class="py-[clamp(64px,8vw,104px)]" />

    <section class="n2-support-section" id="migracao">
      <div class="container-page">
        <div class="n2-section-heading reveal"><SectionEyebrow align="center">{copy.apoio.eyebrow}</SectionEyebrow><h2>{copy.apoio.titulo}<span>{copy.apoio.destaque}</span></h2></div>
        <div class="n2-support-grid">{[copy.apoio.migracao, copy.apoio.suporte].map((item, i) => <article class="n2-support-card reveal"><span class="n2-support-symbol" aria-hidden="true">{i === 0 ? '↗' : '+'}</span><h3>{item.titulo}</h3><p>{item.texto}</p><Button href={links.whatsapp} variant={i === 0 ? 'green' : 'outline-purple'}>{item.cta}</Button></article>)}</div>
        <p class="n2-note">{copy.apoio.horario}</p>
      </div>
    </section>

    <Faq itens={copy.faq} class="py-[clamp(64px,8vw,104px)]" />
    <CtaFinal titulo1={copy.final.titulo} titulo2={copy.final.destaque} texto={copy.final.texto} primario={{ label: copy.final.principal, href: '#solucoes' }} secundario={{ label: copy.final.secundario, href: links.whatsapp }} />
  </main>
  <FooterMega />
</Base>

<style>
  .n2-hero-grid { display: grid; grid-template-columns: minmax(0, 616px) minmax(0, 1fr); align-items: center; gap: 24px; padding-top: clamp(40px, 7vw, 88px); padding-bottom: 44px; }
  .n2-hero-copy h1 { margin-top: 20px; font-size: clamp(2.5rem, 4.5vw, 3.85rem); line-height: 1.04; font-weight: 700; letter-spacing: -.025em; }
  .n2-hero-copy h1 span { display: block; color: var(--color-green-ink); text-wrap: balance; }
  .n2-lead { margin-top: 26px; max-width: 52ch; font-size: 18px; line-height: 1.7; color: var(--color-ink-soft); }
  .n2-lead strong { color: var(--color-ink); }
  .n2-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .n2-actions :global(a) { padding-inline: 20px; font-size: 13px; }
  .n2-hero-benefits { display: flex; flex-wrap: wrap; gap: 12px 22px; margin-top: 22px; color: var(--color-ink-soft); font-size: 13px; }
  .n2-hero-benefits li { display: flex; align-items: center; gap: 7px; }
  .n2-hero-benefits span { color: var(--color-green-deep); font-weight: 700; }
  .n2-hero-art { min-width: 0; }
  .n2-hero-art > p { max-width: 37ch; margin: 10px auto 0; text-align: center; color: var(--color-ink-soft); font: 10px/1.8 var(--font-mono); }
  .n2-section { padding-block: clamp(64px, 8vw, 104px); }
  .n2-section-heading { text-align: center; max-width: 780px; margin-inline: auto; }
  .n2-section-heading h2 { margin-top: 18px; font-size: clamp(1.9rem, 3.5vw, 2.6rem); line-height: 1.12; font-weight: 700; }
  .n2-section-heading h2 > span { display: block; color: var(--color-green-ink); }
  .n2-section-heading > p { margin: 20px auto 0; max-width: 64ch; font-size: 16px; line-height: 1.8; color: var(--color-ink-soft); }
  .n2-project-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 38px; }
  .n2-project-card { display: flex; flex-direction: column; padding: 24px; background: white; border: 1px solid var(--color-line); border-radius: var(--radius-card); box-shadow: var(--shadow-soft); transition: transform .2s, box-shadow .2s; }
  .n2-project-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .n2-card-top { display: flex; justify-content: space-between; align-items: center; }
  .n2-icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 13px; background: #5c1f850c; color: var(--color-purple-logo); flex-shrink: 0; }
  .n2-icon svg { width: 23px; height: 23px; }
  .n2-number { color: var(--color-ink-soft); font: 10px var(--font-mono); }
  .n2-project-card h3 { margin-top: 24px; font-size: 21px; font-weight: 700; line-height: 1.2; min-height: 2.4em; }
  .n2-project-card > p { color: var(--color-ink-soft); font-size: 14px; line-height: 1.8; margin: 12px 0 20px; }
  .n2-examples { margin-top: auto; font: 10px/1.8 var(--font-mono); color: var(--color-purple-logo); padding-bottom: 18px; }
  .n2-text-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 44px; color: var(--color-purple-logo); font-size: 13px; font-weight: 700; }
  .n2-text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .n2-project-card > a { border-top: 1px solid var(--color-line); padding-top: 12px; }
  .n2-infra { position: relative; overflow: hidden; background: var(--color-purple-950); color: white; }
  .n2-infra :global(.n2-racks) { position: absolute; right: -15%; top: 0; height: 100%; width: 100%; object-fit: cover; opacity: .6; }
  .n2-infra-shade { position: absolute; inset: 0; background: linear-gradient(90deg, #300c51 0%, #300c51ed 32%, #300c5160 70%, #300c5180); }
  .n2-infra-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: 100px; padding-block: clamp(56px, 7vw, 88px); align-items: center; }
  .n2-infra-lead { font-size: 16px; line-height: 1.8; color: #e0d3eb; margin-top: 22px; }
  .n2-infra-list { display: grid; gap: 24px; margin-top: 30px; }
  .n2-infra-list li { display: flex; gap: 15px; }
  .n2-infra-list li > span { font: 11px var(--font-mono); color: var(--color-green); margin-top: 5px; }
  .n2-infra-list h3 { font-size: 17px; font-weight: 700; line-height: 1.4; }
  .n2-infra-list p { font-size: 14px; color: #e0d3eb; line-height: 1.7; margin-top: 5px; }
  .n2-infra-status { max-width: 350px; width: 100%; justify-self: end; }
  .n2-infra-cta { margin-top: 30px; }
  .n2-ia-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: end; }
  .n2-ia-heading > p { color: var(--color-ink-soft); font-size: 16px; line-height: 1.8; }
  .n2-workflow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; margin: 40px 0; }
  .n2-workflow li { border-top: 2px solid var(--color-line); padding-top: 20px; }
  .n2-workflow li > span { display: block; font: 12px var(--font-mono); color: var(--color-purple-logo); margin-bottom: 16px; }
  .n2-workflow h3 { font-size: 19px; font-weight: 700; }
  .n2-workflow p { color: var(--color-ink-soft); font-size: 14px; margin-top: 10px; line-height: 1.8; }
  .n2-tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .n2-tool { display: flex; align-items: start; gap: 20px; padding: 28px; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: white; }
  .n2-tool-deploy { background: #f4effa; border-color: #5c1f8525; }
  .n2-tool h3 { font-size: 22px; font-weight: 700; color: var(--color-purple-logo); }
  .n2-tool p { color: var(--color-ink-soft); font-size: 14px; line-height: 1.8; margin-top: 10px; }
  .n2-note { font-size: 12px; line-height: 1.8; color: var(--color-ink-soft); text-align: center; margin: 24px auto 0; max-width: 90ch; }
  .n2-plans-section { padding-block: clamp(56px, 7vw, 88px); background: #f5f2f8; }
  .n2-plans-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 38px; }
  .n2-plan { padding: 24px 20px; background: white; border: 1px solid var(--color-line); border-radius: var(--radius-card); display: flex; flex-direction: column; }
  .n2-plan-heading h3 { font-size: 22px; font-weight: 700; }
  .n2-plan-heading > p { min-height: 3.4em; font-size: 13px; line-height: 1.7; color: var(--color-ink-soft); margin-top: 10px; }
  .n2-plan-price { margin: 26px 0 24px; }
  .n2-plan-price > span { font-size: 11px; color: var(--color-ink-soft); }
  .n2-plan-price > p { font-size: 34px; line-height: 1.3; letter-spacing: -.02em; font-weight: 700; white-space: nowrap; }
  .n2-plan-price small { font-size: 13px; font-weight: 400; letter-spacing: 0; }
  .n2-plan ul { display: grid; gap: 14px; padding-top: 24px; margin-bottom: 28px; border-top: 1px solid var(--color-line); }
  .n2-plan li { display: flex; align-items: start; gap: 8px; font-size: 13px; line-height: 1.6; }
  .n2-plan li > span { color: var(--color-green-deep); }
  .n2-plan :global(a) { margin-top: auto; padding-inline: 10px; font-size: 12px; }
  .n2-plan-help { text-align: center; margin-top: 32px; }
  .n2-plan-help > p { font-size: 15px; }
  .n2-support-section { padding-block: 56px; background: #f7f6f9; }
  .n2-support-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 34px; }
  .n2-support-card { border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 32px; background: white; }
  .n2-support-symbol { display: grid; place-items: center; width: 44px; height: 44px; font-size: 24px; color: var(--color-purple-logo); background: #5c1f8510; border-radius: 13px; }
  .n2-support-card h3 { margin-top: 20px; font-size: 24px; font-weight: 700; }
  .n2-support-card p { color: var(--color-ink-soft); font-size: 15px; line-height: 1.8; margin: 18px 0 24px; }
  #solucoes, #planos, #estrutura, #crie-com-ia, #migracao { scroll-margin-top: 105px; }
  @media (max-width: 1100px) { .n2-project-grid, .n2-plans-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .n2-infra-grid { gap: 45px; } .n2-hero-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); } }
  @media (max-width: 1023px) { .n2-hero-grid { grid-template-columns: 1fr; gap: 38px; } .n2-hero-copy { text-align: center; max-width: 700px; margin-inline: auto; } .n2-hero-copy h1 { font-size: clamp(2.4rem, 6vw, 3.85rem); } .n2-lead { margin-inline: auto; } .n2-actions, .n2-hero-benefits { justify-content: center; } .n2-ia-heading { grid-template-columns: 1fr; gap: 24px; text-align: center; } .n2-ia-heading > p { max-width: 65ch; margin-inline: auto; } }
  @media (max-width: 760px) { .n2-infra-grid { grid-template-columns: 1fr; } .n2-infra-status { justify-self: center; } .n2-infra-lead { text-align: center; } .n2-infra-cta { text-align: center; } .n2-infra-shade { background: #300c51d9; } .n2-tools, .n2-support-grid { grid-template-columns: 1fr; } .n2-workflow { gap: 20px; } }
  @media (max-width: 540px) { .n2-project-grid, .n2-plans-grid, .n2-workflow { grid-template-columns: 1fr; } .n2-hero-copy h1 { font-size: clamp(2rem, 9vw, 2.9rem); } .n2-lead { font-size: 16px; } .n2-actions { flex-direction: column; } .n2-hero-benefits { gap: 10px 14px; font-size: 12px; } .n2-project-card h3 { min-height: 0; } .n2-plan-heading > p { min-height: 0; } .n2-tool, .n2-support-card { padding: 24px; } .n2-tool { flex-direction: column; gap: 18px; } .n2-support-card :global(a) { white-space: normal; height: auto; min-height: 44px; text-align: center; padding-block: 10px; } }
</style>
