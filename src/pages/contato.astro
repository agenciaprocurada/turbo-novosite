---
/**
 * /contato/ — central de contato, sem formulário.
 *
 * O site é `output: 'static'`: não há servidor para processar POST. Em vez de
 * pendurar o lead num serviço de terceiro, a página manda direto para os
 * canais que a Turbo já opera — chat com a equipe, e-mail e ticket. Menos etapa entre
 * a dúvida e a resposta, e nada de dado pessoal passando por fora.
 */
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import HeaderPill from '../components/HeaderPill.astro'
import FooterMega from '../components/FooterMega.astro'

import HeroProduto from '../components/HeroProduto.astro'
import SectionEyebrow from '../components/SectionEyebrow.astro'
import CtaFinal from '../components/secoes/CtaFinal.astro'

import { marca, links, atendimento } from '../data/site'

const trilha = [
  { label: 'Home', href: '/' },
  { label: 'Contato', href: '/contato/' },
]

/** Os canais, na ordem em que a Turbo realmente responde mais rápido. */
const canais: readonly {
  titulo: string
  texto: string
  quando: string
  cta: string
  href: string
  /** Abre o TurboBot Livechat em vez de navegar (o href é só o fallback). */
  chat?: boolean
  destaque?: boolean
  icone: string
}[] = [
  {
    titulo: 'Falar com a equipe',
    texto: 'O canal mais rápido. Chat direto com quem mexe no servidor.',
    quando: atendimento.whatsapp,
    cta: 'Abrir o chat',
    href: links.equipe,
    chat: true,
    destaque: true,
    icone: 'M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z',
  },
  {
    titulo: 'Abrir um ticket',
    texto: 'Para assunto técnico que precisa de histórico, print ou acompanhamento. Todos os dias.',
    quando: atendimento.ticket,
    cta: 'Abrir ticket',
    href: links.ticket,
    icone: 'M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4V5Zm6 0v14M14 9h3M14 13h3',
  },
  {
    titulo: 'E-mail',
    texto: 'Assunto comercial, proposta, parceria e o que não tem pressa.',
    quando: marca.email,
    cta: 'Enviar e-mail',
    href: `mailto:${marca.email}`,
    icone: 'M3 6h18v12H3zM3 7l9 6 9-6',
  },
] as const

/** Atalhos que já existem e resolvem sozinhos a maior parte das dúvidas. */
const atalhos = [
  { label: 'Área do cliente', desc: 'Painel, serviços e dados', href: links.areaCliente },
  { label: 'Faturas', desc: 'Segunda via e pagamento', href: links.faturas },
  { label: 'Central de ajuda', desc: 'Tutoriais e passo a passo', href: links.ajuda },
  { label: 'Status dos serviços', desc: 'Ver se algo está fora do ar', href: links.status },
] as const
---

<Base
  titulo="Contato — fale com a Turbo Cloud"
  descricao="Fale com a equipe da Turbo Cloud pelo chat das 8h à 1h, de segunda a sábado, por ticket todos os dias ou por e-mail. Atendimento humano, feito por quem mexe no servidor."
  trilha={trilha}
>
  <TopBar />
  <HeaderPill />

  <main id="conteudo">
    <HeroProduto
      eyebrow="Contato"
      titulo="Fale com"
      tituloVerde="a Turbo."
      lead="Suporte humano, feito por quem mexe no servidor. Escolha o canal pela pressa do assunto — o chat com a equipe é o mais rápido."
      badges={[atendimento.resumo]}
      trilha={trilha}
      ctaPrimario={{ label: 'Falar com a equipe', href: links.equipe }}
      ctaSecundario={{ label: 'Abrir um ticket', href: links.ticket }}
    />

    {/* ---------------------------- Canais ---------------------------- */}
    <section class="pt-[clamp(56px,7vw,96px)] pb-[clamp(40px,5vw,64px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[620px] text-center">
          <SectionEyebrow class="justify-center">Canais de atendimento</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.7rem,3.6vw,2.3rem)] leading-[1.12] font-bold tracking-[-0.018em] text-ink"
          >
            Três jeitos de falar com a gente<br /><span class="text-green-ink">— escolha o seu.</span>
          </h2>
        </div>

        <div class="mt-10 grid gap-4 lg:grid-cols-3">
          {
            canais.map((canal, i) => (
              <div class="reveal flex" data-delay={String(i + 1)}>
                <article
                  class:list={[
                    'flex w-full flex-col gap-4 rounded-card border bg-surface p-6 transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lift',
                    canal.destaque ? 'border-green-deep/40 shadow-soft' : 'border-line shadow-soft',
                  ]}
                >
                  <span
                    class="grid size-11 place-items-center rounded-[13px] bg-purple-logo/8 text-purple-800"
                    aria-hidden="true"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      class="size-[22px]"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={canal.icone} />
                    </svg>
                  </span>

                  <div>
                    <h3 class="text-[18px] leading-snug font-bold tracking-[-0.015em] text-ink">
                      {canal.titulo}
                    </h3>
                    <p class="mt-2 text-[14.5px] leading-relaxed text-ink-soft">{canal.texto}</p>
                  </div>

                  <p class="mt-auto border-t border-line pt-4 font-mono text-[11.5px] tracking-[0.04em] text-ink-soft">
                    {canal.quando}
                  </p>

                  <a
                    href={canal.href}
                    target={canal.chat ? undefined : '_blank'}
                    rel={canal.chat ? undefined : 'noopener'}
                    data-abrir-chat={canal.chat ? '' : undefined}
                    class="inline-flex items-center gap-1.5 text-[14px] font-bold text-green-deep transition-[gap] duration-200 hover:gap-2.5"
                  >
                    {canal.cta} <span aria-hidden="true">→</span>
                  </a>
                </article>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* --------------------------- Atalhos ---------------------------- */}
    <section class="pb-[clamp(56px,7vw,96px)]">
      <div class="container-page">
        <div class="reveal rounded-card border border-line bg-surface p-6 shadow-soft sm:p-8">
          <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">
            Talvez resolva sem falar com ninguém
          </p>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {
              atalhos.map((atalho) => (
                <li>
                  <a
                    href={atalho.href}
                    target="_blank"
                    rel="noopener"
                    class="group flex h-full flex-col gap-1 rounded-[14px] border border-line px-4 py-3.5 transition-colors hover:border-green-deep/40 hover:bg-green/4"
                  >
                    <span class="inline-flex items-center gap-1.5 text-[14.5px] font-bold text-ink">
                      {atalho.label}
                      <span
                        class="text-green-deep transition-transform duration-200 group-hover:translate-x-0.5"
                        aria-hidden="true"
                        >→</span
                      >
                    </span>
                    <span class="text-[13px] leading-snug text-ink-soft">{atalho.desc}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ------------------------- Dados da empresa ------------------------- */}
    <section class="pb-[clamp(72px,9vw,120px)]">
      <div class="container-page">
        <div class="reveal grid gap-8 rounded-card border border-line bg-surface p-6 shadow-soft sm:p-8 lg:grid-cols-3">
          <div>
            <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">Empresa</p>
            <p class="mt-3 text-[15px] leading-relaxed text-ink">
              {marca.nome}<br />
              <span class="text-ink-soft">CNPJ {marca.cnpj}</span><br />
              <span class="text-ink-soft">No ar desde {marca.desde}</span>
            </p>
          </div>

          <div>
            <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">Endereço</p>
            <address class="mt-3 text-[15px] leading-relaxed text-ink-soft not-italic">
              {marca.endereco}
            </address>
          </div>

          <div>
            <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">Fale direto</p>
            <p class="mt-3 flex flex-col gap-1.5 text-[15px] leading-relaxed">
              <a
                href={`mailto:${marca.email}`}
                class="text-ink underline decoration-line underline-offset-4 transition-colors hover:text-green-deep hover:decoration-green-deep"
                >{marca.email}</a
              >
              <a
                href={links.telefone}
                class="text-ink underline decoration-line underline-offset-4 transition-colors hover:text-green-deep hover:decoration-green-deep"
                >{marca.telefone}</a
              >
            </p>
          </div>
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <FooterMega />
</Base>
