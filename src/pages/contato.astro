---
/**
 * /contato/ — central de contato, sem formulário.
 *
 * O site é `output: 'static'`: não há servidor para processar POST. Em vez de
 * pendurar o lead num serviço de terceiro, a página tem um único canal de
 * atendimento — "Falar com a equipe", que abre o chat TurboBot — e, antes dele,
 * o autoatendimento (ajuda, status, faturas, área do cliente). Nada de WhatsApp
 * nem telefone como canal; o e-mail só aparece como dado da empresa.
 */
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import HeaderPill from '../components/HeaderPill.astro'
import FooterMega from '../components/FooterMega.astro'

import HeroProduto from '../components/HeroProduto.astro'
import SectionEyebrow from '../components/SectionEyebrow.astro'
import Button from '../components/Button.astro'
import CtaFinal from '../components/secoes/CtaFinal.astro'

import { marca, links, atendimento } from '../data/site'

const trilha = [
  { label: 'Home', href: '/' },
  { label: 'Contato', href: '/contato/' },
]

/** Autoatendimento: o que resolve sozinho a maior parte das dúvidas. Todos os
 *  links vêm de `links` (site.ts). O card de faturas tem um segundo link, a 2ª
 *  via por e-mail, que não exige login. */
const autoatendimento: readonly {
  titulo: string
  texto: string
  href: string
  icone: string
  /** Quadrado roxo com ícone verde, ou verde com ícone roxo (contraste da regra 2). */
  tom: 'roxo' | 'verde'
  extra?: { label: string; href: string }
}[] = [
  {
    titulo: 'Central de ajuda',
    texto: 'Tutoriais e passo a passo para os pedidos mais comuns.',
    href: links.ajuda,
    tom: 'roxo',
    icone: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-2.6-11.3a2.7 2.7 0 1 1 3.7 2.5c-.7.3-1.1.9-1.1 1.6v.4M12 17v.01',
  },
  {
    titulo: 'Status dos serviços',
    texto: 'Veja em tempo real se alguma coisa está fora do ar.',
    href: links.status,
    tom: 'verde',
    icone: 'M3 12h4l2.5-6.5 4 13L16 12h5',
  },
  {
    titulo: 'Faturas e 2ª via',
    texto: 'Veja, pague e baixe as suas faturas na área do cliente.',
    href: links.faturas,
    tom: 'roxo',
    icone: 'M6 3h12v18l-3-2-3 2-3-2-3 2V3Zm3 5h6M9 12h6',
    extra: { label: '2ª via sem entrar na conta', href: links.segundaVia },
  },
  {
    titulo: 'Área do cliente',
    texto: 'Serviços, domínios, dados e pedidos num só lugar.',
    href: links.areaCliente,
    tom: 'verde',
    icone: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7.5 8.5a7.5 7.5 0 0 1 15 0',
  },
] as const
---

<Base
  titulo="Contato — fale com a Turbo Cloud"
  descricao="Fale com a equipe da Turbo Cloud pelo chat, das 8h à 1h, de segunda a sábado. Atendimento humano, feito por quem mexe no servidor. Central de ajuda, status e faturas à mão."
  trilha={trilha}
>
  <TopBar />
  <HeaderPill />

  <main id="conteudo">
    <HeroProduto
      eyebrow="Contato"
      titulo="Fale com"
      tituloVerde="a Turbo."
      lead="Suporte humano, feito por quem mexe no servidor. Um canal só: o chat com a equipe."
      badges={[atendimento.resumo]}
      trilha={trilha}
      ctaPrimario={{ label: 'Falar com a equipe', href: links.equipe }}
      ctaSecundario={{ label: 'Resolver sozinho', href: '#autoatendimento' }}
    />

    {/* ------------------------ Falar com a equipe ------------------------ */}
    <section id="falar-com-a-equipe" class="pt-[clamp(56px,7vw,96px)] pb-[clamp(40px,5vw,64px)]">
      <div class="container-page">
        <div
          class="reveal block-dark relative overflow-hidden rounded-card bg-purple-950 p-7 text-white shadow-lift sm:p-10 lg:flex lg:items-center lg:justify-between lg:gap-10"
        >
          <div class="flex items-start gap-5">
            <span
              class="grid size-14 shrink-0 place-items-center rounded-[16px] bg-green text-purple-950"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                class="size-7"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"
                ></path>
              </svg>
            </span>
            <div>
              <h2 class="text-[clamp(1.5rem,3vw,1.9rem)] leading-[1.15] font-bold tracking-[-0.018em]">
                Falar com a equipe
              </h2>
              <p class="mt-2 max-w-[52ch] text-[15.5px] leading-relaxed text-white/80">
                Chat direto com quem mexe no servidor. Dúvida técnica, plano, migração, cobrança ou
                proposta: é por aqui que a gente resolve.
              </p>
              <p class="mt-4 font-mono text-[11.5px] tracking-[0.04em] text-green">
                {atendimento.whatsapp} · {atendimento.ticket}
              </p>
            </div>
          </div>
          <div class="mt-7 lg:mt-0 lg:shrink-0">
            <Button href={links.equipe} variant="green" size="lg" fullWidth class="sm:w-auto">
              Abrir o chat
            </Button>
          </div>
        </div>
      </div>
    </section>

    {/* ---------------------------- Autoatendimento ---------------------------- */}
    <section id="autoatendimento" class="pb-[clamp(56px,7vw,96px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[620px] text-center">
          <SectionEyebrow align="center">Autoatendimento</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.7rem,3.6vw,2.3rem)] leading-[1.12] font-bold tracking-[-0.018em] text-ink"
          >
            Talvez resolva<br /><span class="text-green-ink">sem falar com ninguém.</span>
          </h2>
        </div>

        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            autoatendimento.map((item, i) => (
              <li class="reveal flex" data-delay={String(i + 1)}>
                <article class="group relative flex w-full flex-col gap-4 rounded-card border border-line bg-surface p-6 shadow-soft transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:border-green-deep/40 hover:shadow-lift">
                  <span
                    class:list={[
                      'grid size-16 place-items-center rounded-[18px]',
                      item.tom === 'roxo' ? 'bg-purple-950 text-green' : 'bg-green text-purple-950',
                    ]}
                    aria-hidden="true"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      class="size-8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d={item.icone} />
                    </svg>
                  </span>

                  <div>
                    <h3 class="text-[18px] leading-snug font-bold tracking-[-0.015em] text-ink">
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener"
                        class="after:absolute after:inset-0 after:rounded-card"
                      >
                        {item.titulo}
                      </a>
                    </h3>
                    <p class="mt-2 text-[14.5px] leading-relaxed text-ink-soft">{item.texto}</p>
                  </div>

                  <span
                    class="mt-auto inline-flex items-center gap-1.5 text-[14px] font-bold text-green-deep transition-[gap] duration-200 group-hover:gap-2.5"
                    aria-hidden="true"
                  >
                    Acessar <span>→</span>
                  </span>

                  {item.extra && (
                    <a
                      href={item.extra.href}
                      target="_blank"
                      rel="noopener"
                      class="relative z-10 -mt-2 text-[13px] font-semibold text-purple-logo underline underline-offset-4 hover:text-purple-950"
                    >
                      {item.extra.label}
                    </a>
                  )}
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ------------------------- Dados da empresa ------------------------- */}
    <section class="pb-[clamp(72px,9vw,120px)]">
      <div class="container-page">
        <div class="reveal grid gap-8 rounded-card border border-line bg-surface p-6 shadow-soft sm:p-8 lg:grid-cols-3">
          <div>
            <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">Empresa</p>
            <p class="mt-3 text-[15px] leading-relaxed text-ink">
              {marca.nome}<br />
              <span class="text-ink-soft">CNPJ {marca.cnpj}</span><br />
              <span class="text-ink-soft">No ar desde {marca.desde}</span>
            </p>
          </div>

          <div>
            <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">Endereço</p>
            <address class="mt-3 text-[15px] leading-relaxed text-ink-soft not-italic">
              {marca.endereco}
            </address>
          </div>

          <div>
            <p class="font-mono text-[11px] tracking-[0.12em] text-ink-soft uppercase">E-mail institucional</p>
            <p class="mt-3 text-[15px] leading-relaxed">
              <a
                href={`mailto:${marca.email}`}
                class="text-ink underline decoration-line underline-offset-4 transition-colors hover:text-green-deep hover:decoration-green-deep"
                >{marca.email}</a
              >
            </p>
          </div>
        </div>
      </div>
    </section>

    <CtaFinal />
  </main>

  <FooterMega />
</Base>
