---
/**
 * /ferramentas-ia/turbo-deploy/ — publicação e hospedagem para quem cria com IA.
 *
 * Rota própria em "Ferramentas IA", irmã do Turbo Builder. A ordem das seções
 * segue a sequência proposta em `SALES-ANALYSIS.md` §12: promessa e CTA →
 * como funciona → três caminhos de entrada → benefícios da operação →
 * tecnologias e casos → acompanhamento → equipes → planos → quem faz →
 * FAQ → CTA final. A "prova social" do documento (§12, bloco 9) não entra
 * porque não há caso nem depoimento autorizado do produto; o que existe é a
 * casa (Turbo Cloud), e é isso que a faixa "Quem faz" mostra.
 *
 * Todo texto vem de `src/data/turbodeploy.ts`, que explica os limites que a
 * página respeita (nada de "zero downtime", "ilimitado", número de
 * performance ou preço não homologado).
 *
 * Está no menu "Ferramentas IA" e no rodapé, e é indexável. O que ainda
 * falta do time (URL de cadastro, preço do Turbo, suporte) está em `PENDENTE`.
 */
import Base from '../../layouts/Base.astro'
import TopBar from '../../components/TopBar.astro'
import HeaderPill from '../../components/HeaderPill.astro'
import FooterMega from '../../components/FooterMega.astro'

import Trilha from '../../components/Trilha.astro'
import FundoNuvens from '../../components/FundoNuvens.astro'
import DeployPaths from '../../components/DeployPaths.astro'
import DeployPlans from '../../components/DeployPlans.astro'
import DeployTechnologies from '../../components/DeployTechnologies.astro'
import BeneficioCard from '../../components/BeneficioCard.astro'
import SectionEyebrow from '../../components/SectionEyebrow.astro'
import HeadingDuo from '../../components/HeadingDuo.astro'
import Button from '../../components/Button.astro'
import FaixaProvas from '../../components/FaixaProvas.astro'
import DeployDashboardPanel from '../../components/mockups/DeployDashboardPanel.astro'

import Faq from '../../components/secoes/Faq.astro'
import CtaFinal from '../../components/secoes/CtaFinal.astro'

import { turboDeploy as td } from '../../data/turbodeploy'
import { links } from '../../data/site'

const trilha = [
  { label: 'Home', href: '/' },
  { label: 'Turbo Deploy', href: links.ferramentasIa.turboDeploy },
]

/* Ícones de traço desta página (24×24), só usados aqui. */
const ICONES: Record<string, string> = {
  ramificacao: 'M6 3v12M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM18 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM18 9c0 4-4 5-8 6',
  camadas: 'M12 3 3 8l9 5 9-5-9-5ZM3 12l9 5 9-5M3 16l9 5 9-5',
  cadeado: 'M6 11h12v9H6zM9 11V8a3 3 0 0 1 6 0v3M12 15v2',
  painel: 'M4 5h16v14H4zM4 10h16M9 10v9M12 14h5M12 17h3',
  enviar: 'M21 3 3 10.5l7.5 3L13.5 21 21 3ZM10.5 13.5 21 3',
  engrenagem:
    'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z',
  foguete:
    'M5 15c-1.5 1.5-2 4-2 6 2 0 4.5-.5 6-2M14 4c2-1.5 5-2 7-1 1 2 .5 5-1 7l-6 6-6-6 6-6Zm-4 8 2 2M15 8a1 1 0 1 0 0 .01',
  github: 'M9 19c-4 1.5-4-2.5-6-3M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
  terminal: 'M4 17l6-5-6-5M12 19h8',
  brilho:
    'M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3ZM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z',
  documento: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h5M10 17h5',
  pasta: 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7ZM12 11v5M9.5 13.5 12 11l2.5 2.5',
  grupo:
    'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM3 20a6 6 0 0 1 12 0M15 20a5 5 0 0 1 6-4.9',
  convite: 'M3 6h18v12H3zM3 7l9 6 9-6M17 3v4M15 5h4',
  historico: 'M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4M12 8v4l3 2',
  bandeira: 'M6 21V4M6 4h11l-2.5 3.5L17 11H6',
}

---

<Base titulo={td.titulo} descricao={td.descricao} trilha={trilha} faq={td.faq}>
  <TopBar />
  <HeaderPill ctaPlanos="#planos" />

  <main id="conteudo">
    <section class="deploy-hero relative overflow-clip bg-[#F6F1FA] -mt-[76px] pt-[76px] sm:-mt-[84px] sm:pt-[84px]">
      <FundoNuvens velocidade={60} ancora="topo-no-celular" />
      <div
        class="pointer-events-none absolute inset-0"
        style="background:radial-gradient(52% 62% at 88% 6%, rgba(107,221,18,.10), rgba(246,241,250,0) 72%)"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-[160px]"
        style="background:linear-gradient(180deg, rgba(251,251,250,0) 0%, rgba(251,251,250,.6) 50%, #FBFBFA 100%)"
        aria-hidden="true"
      ></div>
      <div class="relative container-page pt-[clamp(20px,3vw,32px)] pb-[clamp(48px,7vw,88px)]">
        <Trilha itens={trilha} />
        <div class="deploy-hero-grid">
          <div class="deploy-hero-copy">
            <SectionEyebrow>{td.eyebrow}</SectionEyebrow>
            <h1>{td.h1}<br /><span>{td.h1Verde}</span></h1>
            <p class="deploy-lead">{td.lead}</p>
            <div class="deploy-hero-actions">
              <Button href={td.cta.href} size="lg">{td.cta.label}<span aria-hidden="true">↗</span></Button>
              <Button href="#planos" variant="outline-purple" size="lg">{td.planos.eyebrow}<span aria-hidden="true">↓</span></Button>
            </div>
            <p class="deploy-availability">{td.disponibilidade}</p>
            <ul class="deploy-hero-badges">{td.badges.map(badge => <li><span aria-hidden="true">✓</span>{badge}</li>)}</ul>
          </div>
          <div class="deploy-hero-visual"><DeployDashboardPanel /></div>
        </div>
        <nav class="deploy-jump" aria-label={td.eyebrow}>{td.atalhos.map(link => <a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>)}</nav>
      </div>
    </section>

    {/* -------------------------------- Fatos -------------------------------- */}
    <section class="pt-[clamp(8px,1vw,16px)]">
      <div class="container-page">
        <div
          class="reveal grid grid-cols-2 gap-x-4 gap-y-6 rounded-card border border-line bg-surface p-5 shadow-soft sm:grid-cols-4 sm:gap-x-0 sm:divide-x sm:divide-line sm:p-6"
        >
          {
            td.fatos.map((f) => (
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:px-5 sm:first:pl-0 sm:last:pr-0">
                <span
                  class="grid size-11 shrink-0 place-items-center rounded-[13px] bg-purple-logo/8 text-purple-800"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d={ICONES[f.icone]} />
                  </svg>
                </span>
                <div class="min-w-0">
                  <p class="text-[24px] leading-none font-bold tracking-[-0.02em] text-ink">
                    {f.valor}
                    {f.unidade && <span class="ml-1 text-[13px] font-bold text-green-deep">{f.unidade}</span>}
                  </p>
                  <p class="mt-1.5 text-[13px] leading-snug text-ink-soft">{f.texto}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* --------------------------- Como funciona ---------------------------- */}
    <section id="como-funciona" class="pt-[clamp(56px,6vw,80px)] pb-[clamp(40px,5vw,64px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[720px] lg:mx-0">
          <SectionEyebrow>{td.comoFunciona.eyebrow}</SectionEyebrow>
          <HeadingDuo parte1={td.comoFunciona.titulo1} parte2={td.comoFunciona.titulo2} class="mt-4" />
        </div>

        <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-6">
          {
            td.comoFunciona.passos.map((passo, i) => (
              <li class="reveal" data-delay={String(i + 1)}>
                <div class="flex items-center gap-3">
                  <span class="grid h-10 w-11 shrink-0 place-items-center rounded-[12px] border border-purple-logo/15 bg-purple-logo/6 font-mono text-[12px] text-purple-logo">
                    0{i + 1}
                  </span>
                  <span
                    class="grid size-11 shrink-0 place-items-center rounded-full bg-purple-logo text-white shadow-soft"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d={ICONES[passo.icone]} />
                    </svg>
                  </span>
                  {i < td.comoFunciona.passos.length - 1 && (
                    <span class="hidden flex-1 items-center gap-1 pl-2 md:flex" aria-hidden="true">
                      <span class="h-0 flex-1 border-t-2 border-dashed border-purple-logo/25" />
                      <span class="size-1.5 rounded-full bg-purple-logo/40" />
                    </span>
                  )}
                </div>
                <h3 class="mt-5 text-[17px] font-bold text-ink">{passo.titulo}</h3>
                <p class="mt-2 max-w-[40ch] text-[14.5px] leading-relaxed text-ink-soft">{passo.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ------------------------- Três caminhos de entrada -------------------- */}
    <section class="py-2" id="caminhos">
      <div class="block-section block-dark bg-purple-950 py-[clamp(48px,6vw,72px)] text-white">
        <div class="container-page">
          <div class="deploy-path-heading">
            <div>
              <SectionEyebrow tone="dark">{td.caminhos.eyebrow}</SectionEyebrow>
              <HeadingDuo parte1={td.caminhos.titulo1} parte2={td.caminhos.titulo2} tone="dark" class="mt-4" />
            </div>
            <p>{td.caminhos.texto}</p>
          </div>
          <DeployPaths />
        </div>
      </div>
    </section>

    {/* --------------------------- Benefícios da operação -------------------- */}
    <section class="pt-[clamp(56px,6vw,80px)] pb-[clamp(48px,6vw,88px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[680px] text-center">
          <SectionEyebrow align="center">{td.operacao.eyebrow}</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.8rem,3.8vw,2.5rem)] leading-[1.1] font-bold tracking-[-0.02em] text-balance text-ink"
          >
            {td.operacao.titulo1}<br /><span class="text-green-ink">{td.operacao.titulo2}</span>
          </h2>
          <p class="mx-auto mt-4 max-w-[56ch] text-[16px] leading-relaxed text-ink-soft">{td.operacao.texto}</p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            td.operacao.itens.map((item, i) => (
              <div class="reveal" data-delay={String((i % 3) + 1)}>
                <BeneficioCard icone={item.icone} titulo={item.titulo} texto={item.texto} class="h-full" />
              </div>
            ))
          }
        </div>

        <div class="reveal mt-10 text-center">
          <Button href={td.cta.href} variant="green" size="lg">{td.cta.label}</Button>
          <FaixaProvas itens={td.provas} class="mt-6" />
        </div>
      </div>
    </section>

    {/* ------------------------- Tecnologias e casos ------------------------- */}
    <section id="tecnologias" class="py-[clamp(40px,5vw,64px)]">
      <div class="container-page">
        <div class="grid gap-y-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-x-12">
          <div class="reveal">
            <SectionEyebrow>{td.tecnologias.eyebrow}</SectionEyebrow>
            <HeadingDuo parte1={td.tecnologias.titulo1} parte2={td.tecnologias.titulo2} class="mt-4" />
            <p class="mx-auto mt-4 max-w-[48ch] text-center text-[16px] leading-relaxed text-ink-soft lg:mx-0 lg:text-left">
              {td.tecnologias.texto}
            </p>
          </div>

          <div class="reveal" data-delay="1"><DeployTechnologies /></div>
        </div>

        <p class="reveal mx-auto mt-8 max-w-[860px] text-center text-[14px] leading-relaxed text-ink-soft lg:mx-0 lg:text-left">
          {td.tecnologias.nota}
        </p>

        <div class="reveal mt-12">
          <p class="font-mono text-[12px] tracking-[0.12em] text-green-deep uppercase">{td.tecnologias.casosTitulo}</p>
        </div>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          {
            td.tecnologias.casos.map((caso, i) => (
              <article
                class="reveal flex flex-col rounded-card border border-line bg-surface p-6 shadow-soft"
                data-delay={String(i + 1)}
              >
                <span class="grid size-11 place-items-center rounded-[13px] bg-purple-logo/8 text-purple-800" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d={ICONES[caso.icone]} />
                  </svg>
                </span>
                <h3 class="mt-5 text-[16.5px] font-bold text-ink">{caso.titulo}</h3>
                <dl class="mt-4 flex flex-col gap-3 text-[14px] leading-relaxed">
                  <div>
                    <dt class="font-mono text-[10.5px] tracking-[0.1em] text-ink-soft uppercase">Jornada</dt>
                    <dd class="text-ink">{caso.jornada}</dd>
                  </div>
                  <div>
                    <dt class="font-mono text-[10.5px] tracking-[0.1em] text-ink-soft uppercase">Resultado</dt>
                    <dd class="text-ink">{caso.resultado}</dd>
                  </div>
                  <div class="border-t border-line pt-3">
                    <dt class="font-mono text-[10.5px] tracking-[0.1em] text-ink-soft uppercase">Fica por sua conta</dt>
                    <dd class="text-ink-soft">{caso.depende}</dd>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="painel" class="panel-guide py-[clamp(40px,5vw,64px)]">
      <div class="container-page">
        <div class="guide-heading">
          <div><SectionEyebrow>{td.painel.eyebrow}</SectionEyebrow><HeadingDuo parte1={td.painel.titulo1} parte2={td.painel.titulo2} class="mt-4" /></div>
          <p>{td.interface.guia}</p>
        </div>
        <div class="guide-layout">
          <div class="guide-project">
            <p class="guide-label">{td.interface.projetoLabel}</p>
            {td.interface.abas.map((tab, i) => <details open={i === 0} class="guide-detail"><summary><span class="guide-index">0{i + 1}</span><span>{tab.nome}</span><span class="guide-plus" aria-hidden="true">+</span></summary><div><p class="guide-path">{tab.caminho}</p><h3>{tab.titulo}</h3><p>{tab.texto}</p></div></details>)}
          </div>
          <aside class="guide-account">
            <p class="guide-label">{td.interface.contaLabel}</p>
            <h3>{td.interface.contaTitulo}</h3>
            <dl>{td.interface.conta.map(item => <div><dt>{item.nome}</dt><dd>{item.texto}</dd></div>)}</dl>
            <p class="guide-mcp"><strong>{td.interface.mcpTitulo}</strong>{td.interface.mcpTexto}</p>
          </aside>
        </div>
      </div>
    </section>

    {/* --------------------------------- Equipes ----------------------------- */}
    <section class="py-[clamp(40px,5vw,64px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[680px] text-center">
          <SectionEyebrow align="center">{td.equipes.eyebrow}</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.8rem,3.8vw,2.5rem)] leading-[1.1] font-bold tracking-[-0.02em] text-balance text-ink"
          >
            {td.equipes.titulo1}<br /><span class="text-green-ink">{td.equipes.titulo2}</span>
          </h2>
          <p class="mx-auto mt-4 max-w-[56ch] text-[16px] leading-relaxed text-ink-soft">{td.equipes.texto}</p>
        </div>

        <div
          class="reveal mt-10 grid gap-y-6 rounded-card border border-line bg-surface p-5 shadow-soft sm:grid-cols-2 lg:grid-cols-4 lg:gap-y-0 lg:divide-x lg:divide-line lg:p-0"
          data-delay="1"
        >
          {
            td.equipes.itens.map((item) => (
              <div class="flex items-start gap-4 lg:px-6 lg:py-7">
                <span class="grid size-11 shrink-0 place-items-center rounded-[13px] bg-purple-logo/8 text-purple-800" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d={ICONES[item.icone]} />
                  </svg>
                </span>
                <div class="min-w-0">
                  <p class="text-[15.5px] leading-tight font-bold text-ink">{item.titulo}</p>
                  <p class="mt-1 text-[13.5px] leading-relaxed text-ink-soft">{item.texto}</p>
                </div>
              </div>
            ))
          }
        </div>
        <p class="reveal mx-auto mt-5 max-w-[760px] text-center text-[13px] leading-relaxed text-ink-soft">{td.equipes.nota}</p>
      </div>
    </section>

    {/* --------------------------------- Planos ------------------------------ */}
    <section id="planos" class="py-[clamp(64px,8vw,110px)]">
      <div class="container-page">
        <div class="reveal mx-auto max-w-[640px] text-center">
          <SectionEyebrow align="center">{td.planos.eyebrow}</SectionEyebrow>
          <h2
            class="mt-4 text-[clamp(1.8rem,3.8vw,2.5rem)] leading-[1.1] font-bold tracking-[-0.02em] text-balance text-ink"
          >
            {td.planos.titulo1}<br /><span class="text-green-ink">{td.planos.titulo2}</span>
          </h2>
          <p class="mx-auto mt-4 max-w-[54ch] text-[16px] leading-relaxed text-ink-soft">{td.planos.texto}</p>
        </div>

        <DeployPlans />

        <p class="reveal mx-auto mt-6 max-w-[860px] text-center text-[13px] leading-relaxed text-ink-soft">{td.planos.nota}</p>
      </div>
    </section>

    {/* -------------------------------- Quem faz ----------------------------- */}
    <section class="py-2">
      <div class="block-section block-dark bg-purple-950 py-[clamp(56px,7vw,96px)] text-white">
        <div class="container-page grid gap-y-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-x-14">
          <div class="reveal">
            <SectionEyebrow tone="dark">{td.ecossistema.eyebrow}</SectionEyebrow>
            <h2
              class="mt-4 text-center text-[clamp(1.9rem,4.2vw,2.8rem)] leading-[1.08] font-bold tracking-[-0.02em] text-balance lg:text-left"
            >
              {td.ecossistema.titulo1}<br /><span class="text-green">{td.ecossistema.titulo2}</span>
            </h2>
            <p class="mx-auto mt-5 max-w-[52ch] text-center text-[16px] leading-relaxed text-white/70 lg:mx-0 lg:text-left">
              {td.ecossistema.texto}
            </p>
            <div class="mt-7 flex justify-center lg:justify-start">
              <Button href={td.cta.href} variant="green" size="lg">{td.cta.label}</Button>
            </div>
            <FaixaProvas itens={td.provas} tone="dark" align="auto" class="mt-6" />
          </div>

          <div class="reveal grid gap-4 sm:grid-cols-2" data-delay="1">
            {
              td.ecossistema.selos.map((selo) => (
                <BeneficioCard icone={selo.icone} titulo={selo.titulo} texto={selo.texto} tone="dark" />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <div id="duvidas"></div>
    <Faq itens={td.faq} class="pt-[clamp(56px,6vw,80px)] pb-[clamp(56px,7vw,100px)]" />

    <CtaFinal
      titulo1={td.ctaFinal.titulo1}
      titulo2={td.ctaFinal.titulo2}
      texto={td.ctaFinal.texto}
      primario={td.cta}
      secundario={td.ctaFinal.secundario}
    />
  </main>

  <FooterMega />
</Base>

<style>
  .guide-heading { display: grid; grid-template-columns: 1.1fr 1fr; gap: 60px; align-items: end; }
  .guide-heading > p { font-size: 16px; color: var(--color-ink-soft); line-height: 1.8; max-width: 48ch; }
